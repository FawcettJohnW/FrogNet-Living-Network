def _get_local_domain() -> str:
    for path in ["/etc/dnsmasq.d/opts_only.conf"]:
        try:
            with open(path) as f:
                for line in f:
                    if line.startswith("domain="):
                        val = line.strip().split("=", 1)[1]
                        log.info("local_domain from %s: %s", path, val)
                        return val
        except OSError:
            pass
    try:
        with open("/etc/frognet_domain") as f:
            val = f.read().strip()
            log.info("local_domain from /etc/frognet_domain: %s", val)
            return val
    except OSError:
        pass
    val = socket.gethostname().split(".")[0]
    log.info("local_domain from hostname: %s", val)
    return val


def _get_local_ip() -> str:
    try:
        out = subprocess.check_output(
            ["ip", "-4", "-o", "addr", "show"], timeout=2, stderr=subprocess.DEVNULL
        ).decode()
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 4:
                addr = parts[3].split("/")[0]
                if addr.startswith("10.101."):
                    log.info("local_ip: %s", addr)
                    return addr
    except Exception as e:
        log.warning("_get_local_ip failed: %s", e)
    return "127.0.0.1"


LOCAL_DOMAIN = _get_local_domain()
LOCAL_IP     = _get_local_ip()
LOCAL_LOWER  = LOCAL_DOMAIN.lower()
