def fetch_all_cache_sensors() -> Dict[str, Dict]:
    rows = _sensors_values(parse=True, SensorType="SemanticCache")
    by_host = {}
    for r in rows:
        sname = r.get("SensorName", "")
        dot = sname.find(".")
        if dot > 0:
            by_host[sname[:dot].lower()] = r.get("data", {})
    log.debug("fetch_all_cache_sensors: %d hosts", len(by_host))
    return by_host


def fetch_sensors_for_host(host_name: str) -> List[Dict]:
    rows = _sensors_values(parse=True, **{"SensorName__like": f"{host_name}.%"})
    log.info("fetch_sensors_for_host(%s): %d sensors", host_name, len(rows))
    return rows

# -----------------------------------------------------------------------
# Background probe thread
# -----------------------------------------------------------------------

class ProbeThread(threading.Thread):
    def __init__(self):
        super().__init__(daemon=True)
        self._lock = threading.Lock()
        self._hosts: List[Tuple[str, str]] = []
        self._results: Dict[str, Dict] = {}
        self._cache: Dict[str, Dict] = {}
        self._inet: Tuple[str, int] = ("FAIL", 0)
        self._error: str = ""
        self._stop = threading.Event()

    def run(self):
        while not self._stop.is_set():
            try:
                hosts = discover_hosts()

                results = {}
                alive_threads = []
                for ip, name in hosts:
                    if name.lower() == LOCAL_LOWER or ip == LOCAL_IP:
                        continue
                    def _do(ip=ip):
                        s, ms, m = probe_alive(ip)
                        results[ip] = {"status": s, "rtt_ms": ms, "method": m}
                    t = threading.Thread(target=_do, daemon=True)
                    alive_threads.append(t)
                    t.start()

                inet_result = [("FAIL", 0)]
                def _inet():
                    inet_result[0] = probe_internet()
                ti = threading.Thread(target=_inet, daemon=True)
                ti.start()

                cache = fetch_all_cache_sensors()

                for t in alive_threads:
                    t.join(timeout=ALIVE_TIMEOUT + 2)
                ti.join(timeout=INET_TIMEOUT + 2)

                with self._lock:
                    self._hosts = hosts
                    self._results = results
                    self._cache = cache
                    self._inet = inet_result[0]
                    self._error = ""

                log.info("probe cycle done: %d hosts, %d alive results, %d cache entries",
                         len(hosts), len(results), len(cache))

            except Exception as e:
                tb = traceback.format_exc()
                log.error("probe cycle CRASHED: %s\n%s", e, tb)
                with self._lock:
                    self._error = str(e)

            self._stop.wait(timeout=REFRESH_SEC)

    def stop(self):
        self._stop.set()

    def snapshot(self):
        with self._lock:
            return (
                list(self._hosts),
                dict(self._results),
                dict(self._cache),
                self._inet,
                self._error,
            )

