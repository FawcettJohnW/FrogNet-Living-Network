def safe_addstr(win, y, x, text, attr=0):
    max_y, max_x = win.getmaxyx()
    if y < 0 or y >= max_y or x >= max_x:
        return
    avail = max_x - x - 1
    if avail <= 0:
        return
    win.addnstr(y, x, text, avail, attr)

