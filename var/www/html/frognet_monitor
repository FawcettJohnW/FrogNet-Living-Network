def draw_title(win, row):
    ts = time.strftime("%H:%M:%S")
    bar = "═" * 78
    safe_addstr(win, row, 1, bar, curses.color_pair(CP_TITLE) | curses.A_BOLD)
    row += 1
    safe_addstr(win, row, 1,
        f"  FrogNet v5.1   {LOCAL_DOMAIN} ({LOCAL_IP})   {ts}",
        curses.color_pair(CP_TITLE) | curses.A_BOLD)
    row += 1
    safe_addstr(win, row, 1, bar, curses.color_pair(CP_TITLE) | curses.A_BOLD)
    return row + 2


def draw_peer_header(win, row):
    safe_addstr(win, row, 2,
        f"{'PEER':<14} {'STATUS':<10} {'RTT':<8} {'HIT':<7} {'SAVED':<9} {'COMPRESS':<8}",
        curses.color_pair(CP_HEADER) | curses.A_BOLD)
    row += 1
    safe_addstr(win, row, 2, "─" * 62, curses.color_pair(CP_DIM))
    return row + 1


def _cache_cols(cache_data):
    if cache_data and isinstance(cache_data, dict) and "totals" in cache_data:
        t = cache_data["totals"]
        return (
            fmt_pct(safe_get(t, "cache_hit_rate", default=0)),
            fmt_bytes(safe_get(t, "bytes_saved", default=0)),
            fmt_pct(safe_get(t, "compression_ratio", default=0)),
            CP_GREEN,
        )
    return ("—", "—", "—", CP_DIM)


def draw_peer_row(win, row, name, probe, cache_data, selected):
    status = probe.get("status", "FAIL")
    rtt_ms = probe.get("rtt_ms", 0)

    if status == "OK":
        s_text, s_cp = "ONLINE", CP_GREEN
        rtt_text = f"{rtt_ms}ms"
        rtt_cp = CP_GREEN if rtt_ms < 100 else (CP_YELLOW if rtt_ms < 1000 else CP_RED)
    else:
        s_text, s_cp = "DOWN", CP_RED
        rtt_text, rtt_cp = "—", CP_DIM

    hit_t, saved_t, comp_t, c_cp = _cache_cols(cache_data)

    if selected:
        max_y, max_x = win.getmaxyx()
        safe_addstr(win, row, 1, " " * min(66, max_x - 2), curses.color_pair(CP_SELECT))
        safe_addstr(win, row, 2,  f"▸ {name:<12}", curses.color_pair(CP_SELECT) | curses.A_BOLD)
        safe_addstr(win, row, 17, f"{s_text:<10}",  curses.color_pair(CP_SELECT) | curses.A_BOLD)
        safe_addstr(win, row, 28, f"{rtt_text:<8}",  curses.color_pair(CP_SELECT))
        safe_addstr(win, row, 37, f"{hit_t:<7}",    curses.color_pair(CP_SELECT))
        safe_addstr(win, row, 45, f"{saved_t:<9}",  curses.color_pair(CP_SELECT))
        safe_addstr(win, row, 55, f"{comp_t:<8}",   curses.color_pair(CP_SELECT))
    else:
        safe_addstr(win, row, 2,  f"  {name:<12}", curses.A_NORMAL)
        safe_addstr(win, row, 17, f"{s_text:<10}",  curses.color_pair(s_cp) | curses.A_BOLD)
        safe_addstr(win, row, 28, f"{rtt_text:<8}",  curses.color_pair(rtt_cp))
        safe_addstr(win, row, 37, f"{hit_t:<7}",    curses.color_pair(c_cp))
        safe_addstr(win, row, 45, f"{saved_t:<9}",  curses.color_pair(c_cp))
        safe_addstr(win, row, 55, f"{comp_t:<8}",   curses.color_pair(c_cp))
    return row + 1


