def draw_overlay(stdscr, title, lines, scroll, sel_idx=-1, selectable=False):
    max_y, max_x = stdscr.getmaxyx()
    box_h = min(max_y - 4, max(12, max_y * 3 // 4))
    box_w = min(max_x - 4, max(60, max_x * 4 // 5))
    top  = max(1, (max_y - box_h) // 2)
    left = max(1, (max_x - box_w) // 2)

    try:
        ov = curses.newwin(box_h, box_w, top, left)
    except curses.error:
        return (0, len(lines))

    ov.erase()
    ov.bkgd(' ', curses.color_pair(CP_OVERLAY))
    try:
        ov.border()
    except curses.error:
        pass

    t = f" {title} "
    try:
        ov.addnstr(0, max(1, (box_w - len(t)) // 2), t, box_w - 2,
                    curses.color_pair(CP_OVERLAY) | curses.A_BOLD)
    except curses.error:
        pass

    ch = box_h - 2
    cw = box_w - 4
    total = len(lines)
    scroll = max(0, min(scroll, max(0, total - ch)))

    for i in range(ch):
        li = scroll + i
        if li >= total:
            break
        text = lines[li][:cw]
        if selectable and li == sel_idx:
            try:
                ov.addnstr(1 + i, 2, text.ljust(cw), cw,
                           curses.color_pair(CP_SELECT) | curses.A_BOLD)
            except curses.error:
                pass
        else:
            try:
                ov.addnstr(1 + i, 2, text, cw, curses.color_pair(CP_OVERLAY))
            except curses.error:
                pass

    if total > ch:
        pct = int((scroll / max(1, total - ch)) * 100)
        ind = f" {scroll+1}-{min(scroll+ch, total)}/{total} ({pct}%) "
        try:
            ov.addnstr(box_h - 1, max(1, box_w - len(ind) - 2), ind, box_w - 2,
                        curses.color_pair(CP_OVERLAY) | curses.A_DIM)
        except curses.error:
            pass

    ov.noutrefresh()
    return (ch, total)

