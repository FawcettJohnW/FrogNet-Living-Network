def draw_footer(win, row, mode, error=""):
    row += 1
    try:
        with open("/proc/uptime") as f:
            up_secs = int(float(f.read().split()[0]))
        d, rem = divmod(up_secs, 86400)
        h, rem = divmod(rem, 3600)
        m = rem // 60
        up_str = f"up {d}d {h}h {m}m" if d else f"up {h}h {m}m"
    except Exception:
        up_str = ""
    try:
        with open("/proc/loadavg") as f:
            load_str = "load " + " ".join(f.read().split()[:3])
    except Exception:
        load_str = ""

    safe_addstr(win, row, 2, f"{up_str}  {load_str}", curses.color_pair(CP_DIM))
    row += 1

    if error:
        safe_addstr(win, row, 2, f"ERROR: {error}", curses.color_pair(CP_RED))
        row += 1

    safe_addstr(win, row, 2, f"Log: {LOG_PATH}", curses.color_pair(CP_DIM))
    row += 1

    if mode == MODE_DASHBOARD:
        h = "↑↓=select  Enter=sensors  q=quit"
    elif mode == MODE_SENSORS:
        h = "↑↓=select  Enter=JSON  r=refresh  Esc/←=back"
    else:
        h = "↑↓=scroll  PgUp/PgDn  Esc/←=back"
    safe_addstr(win, row, 2, h, curses.color_pair(CP_DIM))
    return row + 1

