def _local_api(url: str, timeout: float = 5) -> Any:
    req = urllib.request.Request(url, headers={
        "Host": "127.0.0.1",
        "X-FrogNet-Origin-Local": "1",
    })
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        raw = resp.read()
        return json.loads(raw)


def _sensors_values(parse: bool = True, **filters) -> List[Dict]:
    params = {"entity": "sensors", "action": "values"}
    if parse:
        params["parse"] = "1"
    params.update(filters)
    qs = urllib.parse.urlencode(params)
    url = f"http://127.0.0.1/api.php?{qs}"
    try:
        data = _local_api(url, timeout=5)
        if isinstance(data, dict) and data.get("ok"):
            rows = data.get("rows", [])
            return rows if isinstance(rows, list) else []
        log.warning("_sensors_values bad response for %s: %s", url, str(data)[:200])
    except Exception as e:
        log.warning("_sensors_values error for %s: %s", url, e)
    return []

# -----------------------------------------------------------------------
# Discovery — /etc/hosts primary, getHosts.php optional upgrade
# -----------------------------------------------------------------------

def _parse_etc_hosts() -> List[Tuple[str, str]]:
    """Parse /etc/hosts for 10.101.x.y lines.  Returns [(ip, name), ...].
    Name is field 2; if it starts with FrogNetHost. we strip that prefix."""
    hosts = []
    seen = set()
    try:
        with open("/etc/hosts") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                if len(parts) < 2:
                    continue
                ip = parts[0]
                if not re.match(r'^10\.101\.', ip):
                    continue
                # Skip transit addresses
                if re.match(r'^10\.253\.', ip):
                    continue
                if ip in seen:
                    continue
                seen.add(ip)
                name = parts[1]
                # Strip FrogNetHost. prefix if present
                if name.startswith("FrogNetHost."):
                    name = name[len("FrogNetHost."):]
                # Also strip .frognet suffix if present
                if name.endswith(".frognet"):
                    name = name[:-len(".frognet")]
                hosts.append((ip, name))
    except OSError as e:
        log.error("Cannot read /etc/hosts: %s", e)
    log.info("_parse_etc_hosts: found %d hosts: %s", len(hosts),
             [(ip, n) for ip, n in hosts])
    return hosts


def _try_get_hosts_php() -> List[Tuple[str, str]]:
    """Try getHosts.php — returns [] on any failure."""
    try:
        data = _local_api("http://127.0.0.1/getHosts.php", timeout=5)
        if isinstance(data, list) and len(data) > 0:
            hosts = [(h["ip"], h.get("name", h["ip"]))
                     for h in data if isinstance(h, dict) and "ip" in h]
            log.info("getHosts.php returned %d hosts", len(hosts))
            return hosts
        log.info("getHosts.php returned empty or non-list: %s", type(data))
    except Exception as e:
        log.warning("getHosts.php failed: %s", e)
    return []


def discover_hosts() -> List[Tuple[str, str]]:
    """Primary: /etc/hosts (always works, no HTTP).
    If getHosts.php returns results, use those instead (richer data)."""
    etc_hosts = _parse_etc_hosts()
    api_hosts = _try_get_hosts_php()
    if api_hosts:
        log.info("discover_hosts: using getHosts.php (%d hosts)", len(api_hosts))
        return api_hosts
    log.info("discover_hosts: using /etc/hosts (%d hosts)", len(etc_hosts))
    return etc_hosts

