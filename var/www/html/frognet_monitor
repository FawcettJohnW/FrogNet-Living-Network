def probe_alive(ip: str) -> Tuple[str, int, str]:
    try:
        out = subprocess.check_output(
            [ALIVE_SCRIPT, ip, str(ALIVE_TIMEOUT)],
            timeout=ALIVE_TIMEOUT + 2,
            stderr=subprocess.DEVNULL,
        ).decode().strip()
        if "|" in out:
            ms_str, method = out.split("|", 1)
            return ("OK", int(ms_str), method)
    except Exception as e:
        log.debug("probe_alive %s failed: %s", ip, e)
    return ("FAIL", 0, "")


def probe_internet() -> Tuple[str, int]:
    try:
        t0 = time.monotonic()
        req = urllib.request.Request("http://www.google.com/")
        with urllib.request.urlopen(req, timeout=INET_TIMEOUT) as resp:
            _ = resp.read(1024)
            ms = int((time.monotonic() - t0) * 1000)
        return ("OK", ms)
    except Exception:
        return ("FAIL", 0)

