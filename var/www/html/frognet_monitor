# State
# -----------------------------------------------------------------------

class AppState:
    def __init__(self):
        self.mode = MODE_DASHBOARD
        self.hosts: List[Tuple[str, str]] = []
        self.results: Dict[str, Dict] = {}
        self.cache_by_host: Dict[str, Dict] = {}
        self.inet: Tuple[str, int] = ("FAIL", 0)
        self.error: str = ""
        self.peer_cursor = 0

        self.sensor_host_name = ""
        self.sensor_host_ip = ""
        self.sensors: List[Dict] = []
        self.sensor_cursor = 0
        self.sensor_scroll = 0
        self.sensor_loading = False

        self.json_title = ""
        self.json_lines: List[str] = []
        self.json_scroll = 0

    @property
    def peer_count(self):
        return len(self.hosts)

    def clamp_peer(self):
        if self.peer_count > 0:
            self.peer_cursor = max(0, min(self.peer_cursor, self.peer_count - 1))
        else:
            self.peer_cursor = 0

    def clamp_sensor(self):
        n = len(self.sensors)
        if n > 0:
            self.sensor_cursor = max(0, min(self.sensor_cursor, n - 1))
        else:
            self.sensor_cursor = 0

    def selected_host(self):
        if 0 <= self.peer_cursor < len(self.hosts):
            return self.hosts[self.peer_cursor]
        return None

    def selected_sensor(self):
        if 0 <= self.sensor_cursor < len(self.sensors):
            return self.sensors[self.sensor_cursor]
        return None

# -----------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------

def main(stdscr):
    init_colors()
    curses.curs_set(0)
    stdscr.timeout(UI_TICK_MS)

    st = AppState()
    prober = ProbeThread()
    prober.start()

    try:
        _run(stdscr, st, prober)
    finally:
        prober.stop()


def _run(stdscr, st, prober):
    while True:
        # Non-blocking snapshot from background thread
        st.hosts, st.results, st.cache_by_host, st.inet, st.error = prober.snapshot()
        st.clamp_peer()

        # --- draw dashboard ---
        stdscr.erase()
        row = draw_title(stdscr, 0)
        row = draw_peer_header(stdscr, row)

        if not st.hosts:
            safe_addstr(stdscr, row, 2, "Discovering hosts...",
                        curses.color_pair(CP_YELLOW))
            row += 1
        else:
            for idx, (ip, name) in enumerate(st.hosts):
                is_self  = (name.lower() == LOCAL_LOWER or ip == LOCAL_IP)
                selected = (st.mode == MODE_DASHBOARD and idx == st.peer_cursor)
                hcache   = st.cache_by_host.get(name.lower())
                if is_self:
                    row = draw_local_row(stdscr, row, name, hcache, selected)
                else:
                    probe = st.results.get(ip, {"status": "?", "rtt_ms": 0, "method": ""})
                    row = draw_peer_row(stdscr, row, name, probe, hcache, selected)

        row += 1
        row = draw_internet(stdscr, row, st.inet)
        draw_footer(stdscr, row, st.mode, st.error)

        # Refresh stdscr FIRST so overlays draw on top
        stdscr.noutrefresh()

        # --- overlays (after stdscr refresh, so they're on top) ---
        if st.mode == MODE_SENSORS:
            if st.sensor_loading:
                lines = ["Loading sensors..."]
                sel = -1
            elif not st.sensors:
                lines = ["No sensors found.", "", "Press 'r' to retry."]
                sel = -1
            else:
                lines = []
                prefix = st.sensor_host_name + "."
                for s in st.sensors:
                    sn = s.get("SensorName", "?")
                    st_type = s.get("SensorType", "")
                    short = sn[len(prefix):] if sn.startswith(prefix) else sn
                    ln = f"  {short}"
                    if st_type:
                        ln += f"  ({st_type})"
                    lines.append(ln)
                sel = st.sensor_cursor

            title = f"Sensors: {st.sensor_host_name} ({st.sensor_host_ip})"
            draw_overlay(stdscr, title, lines,
                         st.sensor_scroll, sel_idx=sel,
                         selectable=(len(st.sensors) > 0))

        elif st.mode == MODE_JSON:
            draw_overlay(stdscr, st.json_title, st.json_lines,
                         st.json_scroll)

        curses.doupdate()

        # --- input ---
        try:
            ch = stdscr.getch()
        except curses.error:
            continue
        if ch == -1:
            continue

        if st.mode == MODE_DASHBOARD:
            if ch in (ord('q'), ord('Q')):
                return
            elif ch in (curses.KEY_UP, ord('k')):
                st.peer_cursor = max(0, st.peer_cursor - 1)
            elif ch in (curses.KEY_DOWN, ord('j')):
                st.peer_cursor = min(st.peer_count - 1, st.peer_cursor + 1)
            elif ch in (curses.KEY_ENTER, 10, 13, curses.KEY_RIGHT, ord('l')):
                host = st.selected_host()
                if host:
                    ip, name = host
                    st.sensor_host_ip = ip
                    st.sensor_host_name = name
                    st.sensor_cursor = 0
                    st.sensor_scroll = 0
                    st.sensor_loading = True
                    st.mode = MODE_SENSORS
                    def _load(h=name):
                        st.sensors = fetch_sensors_for_host(h)
                        st.sensor_loading = False
                        st.clamp_sensor()
                    threading.Thread(target=_load, daemon=True).start()

        elif st.mode == MODE_SENSORS:
            if ch in (27, curses.KEY_LEFT, ord('h')):
                st.mode = MODE_DASHBOARD
                st.sensors = []
            elif ch in (ord('q'), ord('Q')):
                st.mode = MODE_DASHBOARD
                st.sensors = []
            elif ch in (curses.KEY_UP, ord('k')):
                if st.sensors:
                    st.sensor_cursor = max(0, st.sensor_cursor - 1)
            elif ch in (curses.KEY_DOWN, ord('j')):
                if st.sensors:
                    st.sensor_cursor = min(len(st.sensors) - 1, st.sensor_cursor + 1)
            elif ch in (curses.KEY_ENTER, 10, 13, curses.KEY_RIGHT, ord('l')):
                sensor = st.selected_sensor()
                if sensor:
                    st.json_title = sensor.get("SensorName", "?")
                    st.json_lines = pretty_json(sensor).splitlines()
                    st.json_scroll = 0
                    st.mode = MODE_JSON
            elif ch == ord('r'):
                st.sensor_loading = True
                def _reload(h=st.sensor_host_name):
                    st.sensors = fetch_sensors_for_host(h)
                    st.sensor_loading = False
                    st.clamp_sensor()
                threading.Thread(target=_reload, daemon=True).start()

        elif st.mode == MODE_JSON:
            if ch in (27, curses.KEY_LEFT, ord('h'), ord('q')):
                st.mode = MODE_SENSORS
                st.json_lines = []
            elif ch in (curses.KEY_UP, ord('k')):
                st.json_scroll = max(0, st.json_scroll - 1)
            elif ch in (curses.KEY_DOWN, ord('j')):
                st.json_scroll += 1
            elif ch == curses.KEY_PPAGE:
                st.json_scroll = max(0, st.json_scroll - 20)
            elif ch == curses.KEY_NPAGE:
                st.json_scroll += 20
            elif ch in (curses.KEY_HOME, ord('g')):
                st.json_scroll = 0
            elif ch in (curses.KEY_END, ord('G')):
                st.json_scroll = max(0, len(st.json_lines) - 10)


if __name__ == "__main__":
    try:
        curses.wrapper(main)
    except KeyboardInterrupt:
        pass
