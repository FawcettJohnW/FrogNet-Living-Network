/etc/frognet/node-id
/etc/frognet/ssid_projection.conf
/etc/frognet/broker.conf.superseded.*
/etc/NetworkManager/conf.d/
/etc/iptables/rules.v*
/etc/ssl/localCA/
/etc/ssl/certs/
/etc/ssl/openssl.cnf
