[Unit]
Description=FrogNet tunnel setup at boot (register with broker, bring up WireGuard)
Documentation=man:frognet-tunnel-setup-v3.sh
After=network-online.target
Wants=network-online.target
# Register with the broker BEFORE the tunnel daemon starts, so the daemon comes up
# with current peer state. The script self-gates: LAN-only nodes (no non-10.x default)
# and missing/unreachable broker config exit cleanly.
Before=frognet-tunnel-daemon-v3.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/frognet-tunnel-setup-v3.sh
TimeoutStartSec=120
[Install]
WantedBy=multi-user.target
