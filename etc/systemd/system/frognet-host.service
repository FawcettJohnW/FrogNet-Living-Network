# [FROGNETHOST_ADMIN_V1] the FrogNetHost Admin service on this node: a held read on this node's own configuration tuple
# in databasehost-control; applies what changed (setup_lillypad, clear, dump, backup, reboot) and answers in its own
# state tuple in the SystemRam. The console is /opt/fdf/bin/frognet-host.
[Unit]
Description=FrogNet FrogNetHost Admin (this node's configuration tuple, applied)
After=network-online.target frognet-tunnel-daemon-v3.service
Wants=network-online.target
[Service]
ExecStart=/usr/bin/python3 /opt/fdf/bin/frognet-host serve
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
