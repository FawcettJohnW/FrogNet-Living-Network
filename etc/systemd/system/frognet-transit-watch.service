[Unit]
Description=FrogNet Transit Link Watcher
After=network.target frognet-transit-boot.service
Wants=frognet-transit-boot.service

[Service]
Type=simple
ExecStart=/usr/local/bin/frognet_transit_watch.sh
Restart=always
RestartSec=5
Environment=FROGNET_TRANSIT_WATCH_INTERVAL=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
