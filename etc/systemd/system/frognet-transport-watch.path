# [THE_TRANSPORT_FILE_IS_WATCHED_V1] The kernel wakes systemd when /etc/frognet/semantic_transport is written,
# replaced, made or removed; nothing polls. The directory is watched as well as the file because an editor
# replaces the file, and removing the file (back to the default) is a change too.
[Unit]
Description=FrogNet: watch the node's transport file, /etc/frognet/semantic_transport

[Path]
PathChanged=/etc/frognet/semantic_transport
PathChanged=/etc/frognet
Unit=frognet-transport-watch.service

