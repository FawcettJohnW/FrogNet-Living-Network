[Unit]
Description=FrogNet Communicator beacon heartbeat (re-plants bundle + caps tuples)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/etc/frognet_bundles/communicator
Environment=PYTHONPATH=/etc/frognet_bundles/communicator
Environment=PYTHONDONTWRITEBYTECODE=1
# One per node: this node announces its own installed bundles (and, once wired, its
# av_caps) by re-asserting them every 5 min, re-resolving databasehost.frognet so the
# beacons follow the transient float. A service that dies stops re-asserting; its
# beacon ages out and the reaper collects it.
ExecStart=/usr/bin/python3 /etc/frognet_bundles/communicator/frognet_beacon_service.py --dbhost databasehost.frognet --interval 300
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
