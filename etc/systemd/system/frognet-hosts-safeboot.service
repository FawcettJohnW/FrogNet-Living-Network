[Unit]
Description=Neutralize stale databasehost.frognet to localhost until discovery re-elects
After=local-fs.target
Before=frognet-daemon.service frognet-proxy.service frognet-reaper.service frognet-post-merge-metrics.service frognet-merge-watcher.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/local/bin/frognet_hosts_safeboot.py
[Install]
WantedBy=multi-user.target
