# [THE_TRANSPORT_FILE_IS_WATCHED_V1] Started by frognet-transport-watch.path, once for each change. It restarts
# frognet-daemon and frognet-proxy when the file no longer says what they read at start, and only then.
[Unit]
Description=FrogNet: restart the daemon and the proxy when the node's transport file has changed

[Service]
Type=oneshot
WorkingDirectory=/opt/frognet_semantic
ExecStart=/opt/frognet_semantic/venv/bin/python3 /opt/frognet_semantic/core/transport_file_watch.py
