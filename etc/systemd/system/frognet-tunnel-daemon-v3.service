[Unit]
Description=FrogNet Tunnel Daemon v3 — automatic tunnel lifecycle manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/frognet_semantic
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m internet_tunnels_v3
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
