[Unit]
Description=FrogNet Transit Link Boot Initialization
# [TRANSIT_IS_A_BARE_CABLE_V1 - T6a fixes] after the network is online: an interface with an address is not a transit
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/frognet/transit.conf
ExecStart=/usr/local/bin/frognet_transit_boot.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
