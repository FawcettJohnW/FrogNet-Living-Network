# /usr/local/bin/start_proxy

ROOT="/opt/frognet_semantic"
VENV="$ROOT/venv"
PY="$VENV/bin/python"

cd "$ROOT"
export VIRTUAL_ENV="$VENV"
export PATH="$VENV/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

export FROGNET_DEBUG="${FROGNET_DEBUG:-1}"
export FROGNET_SEMANTIC="${FROGNET_SEMANTIC:-1}"

LISTEN="${FROGNET_PROXY_LISTEN:-0.0.0.0:80}"
UP_HOST="${FROGNET_UPSTREAM_HOST:-127.0.0.1}"
UP_PORT="${FROGNET_UPSTREAM_PORT:-8080}"
DPORT="${FROGNET_DAEMON_PORT:-9009}"

exec "$PY" "$ROOT/proxy/proxy_main.py" \
  --listen "$LISTEN" \
  --upstream-host "$UP_HOST" \
  --upstream-port "$UP_PORT" \
  --daemon-port "$DPORT" \
  "$@"
