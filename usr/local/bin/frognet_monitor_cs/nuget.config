<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    No package sources, deliberately.

    This project has zero PackageReference entries: HttpClient and
    System.Text.Json ship with the runtime. Clearing the sources makes that a
    build-time guarantee rather than a claim in a README - if anyone adds a
    dependency, the restore fails here instead of quietly pulling one in.

    It also means the project builds on an air-gapped machine, which matters for
    the people most likely to ask whether this works with their stack.
  -->
  <packageSources>
    <clear />
  </packageSources>
</configuration>
