# Windowed viewer — NEEDS a display.
#   runClient NAME [RELAY] [extra…]   (add --no-video --no-audio for receive-only)
HERE="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$HERE/communicator_live.py" ]; then COMM_DIR="${COMM_DIR:-$HERE}"; else COMM_DIR="${COMM_DIR:-/etc/frognet_bundles/communicator}"; fi
: "${FN_RELAY:=mediahost.frognet:9000}"
if [ -z "$1" ]; then echo "usage: runClient NAME [RELAY] [extra…]   (needs a display)" >&2; exit 2; fi
name="$1"; shift
relay="$FN_RELAY"
if [ -n "$1" ] && [ "${1#-}" = "$1" ]; then relay="$1"; shift; fi
echo "[runClient] name=${name} relay=${relay} (windowed; requires a display)" >&2
exec python3 "$COMM_DIR/communicator_live.py" --name "$name" --relay "$relay" "$@"
