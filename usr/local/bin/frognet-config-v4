###############################################################################
# frognet-config-v4 — Build /etc/frognet/{gateways,tunnel,broker}.conf for v4
#
# Three files end up populated:
#   /etc/frognet/gateways.conf  — NETWORK_NAME, GATEWAY_IP, ADMIN_IP, GW1, GW2
#                                 (read by frognet_eth0_fixup, by registration,
#                                 by lots of edge scripts)
#   /etc/frognet/tunnel.conf    — BROKER_URL, PASSCODE, GROUP_TOKEN, GROUP_NAME,
#                                 MAX_TUNNELS  (read by the tunnel daemon)
#   /etc/frognet/broker.conf    — BROKER_URL, POND_NAME, POND_PASSWORD
#                                 (read by frognet_tunnel_setup_v3.sh during
#                                 /api/v4/register)
#
# Does NOT touch the LAN / dnsmasq / NetworkManager / Apache.  That's
# setup_lillypad's job.  Run lillypad first, then this, in that order.
#
# Idempotent.  Existing values stay unless overridden by a flag.
#
# Usage:
#   sudo frognet-config-v4 \
#       --name HardBox \
#       --ip 10.101.130.1 \
#       --broker https://streamingfrog.com/frognet-broker-v4 \
#       --pond mypond \
#       --pond-password 'secret'
#
# All flags optional; missing values mean "leave whatever's there alone."
# Use --show to print current state without writing.
###############################################################################

set -eu

log()  { echo "[frognet-config-v4] $*"; }
die()  { echo "[frognet-config-v4] FATAL: $*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "must run as root"

# ---------- args ----------
NAME=""; IP=""; BROKER=""; POND=""; POND_PW=""; SHOW=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --name)          NAME="$2";    shift 2 ;;
        --ip)            IP="$2";      shift 2 ;;
        --broker)        BROKER="$2";  shift 2 ;;
        --pond)          POND="$2";    shift 2 ;;
        --pond-password) POND_PW="$2"; shift 2 ;;
        --show)          SHOW=1;       shift   ;;
        -h|--help)       sed -n '2,/^###$/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) die "unknown arg: $1" ;;
    esac
done

# ---------- validate ----------
[[ -z "$IP"     || "$IP"     =~ ^10\.[0-9]+\.[0-9]+\.1$ ]] \
    || die "--ip must be in 10.x.x.1 format"
[[ -z "$BROKER" || "$BROKER" =~ ^https?://[^/[:space:]]+(/.*)?$ ]] \
    || die "--broker must be a full URL"

mkdir -p /etc/frognet

# ---------- helper: read existing key from a key=value file ----------
_get() { grep -E "^$2=" "$1" 2>/dev/null | head -1 | cut -d= -f2- || true; }

# ---------- helper: idempotent set key=value ----------
_set() {
    local file="$1" key="$2" val="$3"
    if [[ -f "$file" ]] && grep -qE "^${key}=" "$file"; then
        sed -i "s|^${key}=.*|${key}=${val}|" "$file"
    else
        echo "${key}=${val}" >> "$file"
    fi
}

# ---------- gateways.conf ----------
GW="/etc/frognet/gateways.conf"
[[ -f "$GW" ]] || { echo "# generated by frognet-config-v4" > "$GW"; chmod 644 "$GW"; }
[[ -n "$NAME" ]] && _set "$GW" NETWORK_NAME "$NAME"
[[ -n "$IP"   ]] && {
    _set "$GW" GATEWAY_IP "$IP"
    _set "$GW" ADMIN_IP   "${IP%.*}.2"
    _set "$GW" GW1        "$IP"
    grep -q '^GW2=' "$GW" || _set "$GW" GW2 "0.0.0.0"
}

# ---------- tunnel.conf ----------
TC="/etc/frognet/tunnel.conf"
if [[ ! -f "$TC" ]]; then
    cat > "$TC" <<TCONF
BROKER_URL=
PASSCODE=
GROUP_TOKEN=
GROUP_NAME=
MAX_TUNNELS=5000
TCONF
    chmod 600 "$TC"
fi
[[ -n "$BROKER" ]] && _set "$TC" BROKER_URL "$BROKER"

# ---------- broker.conf ----------
BC="/etc/frognet/broker.conf"
[[ -f "$BC" ]] || { : > "$BC"; chmod 600 "$BC"; }
[[ -n "$BROKER" ]]  && _set "$BC" BROKER_URL    "$BROKER"
# POND_NAME defaults to NETWORK_NAME if --pond not given but --name is
EFFECTIVE_POND="${POND:-$NAME}"
[[ -n "$EFFECTIVE_POND" ]] && _set "$BC" POND_NAME     "$EFFECTIVE_POND"
[[ -n "$POND_PW" ]]        && _set "$BC" POND_PASSWORD "$POND_PW"

# ---------- show ----------
log "current config:"
for f in "$GW" "$TC" "$BC"; do
    echo
    echo "--- $f ---"
    [[ -f "$f" ]] && grep -vE '^\s*$|^#' "$f" | sed "s|^|  |" || echo "  (missing)"
done
echo

if [[ $SHOW -eq 0 ]]; then
    log "done — review above, then start daemon:"
    log "  sudo systemctl restart frognet-tunnel-daemon-v3"
    log "  sudo journalctl -u frognet-tunnel-daemon-v3 -f"
fi

