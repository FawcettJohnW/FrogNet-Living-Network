OUT="/etc/dnsmasq.d/frognet_forwarders_auto.conf"
TMP="$(mktemp)"

{
  echo "# AUTO-GENERATED"
  awk '$1 ~ /^10\./ {printf("server=/%s/%s\nserver=/.%s/%s\n",$2,$1,$2,$1)}' \
    /etc/sentinels/frognet_hosts
} | sort -u >"$TMP"

mv "$TMP" "$OUT"
