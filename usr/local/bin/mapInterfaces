# /usr/local/bin/mapInterfaces
# FrogNet Interface Enumeration (v2 - omnidirectional routing)

IP="/usr/sbin/ip"
AWK="/usr/bin/awk"
CUT="/usr/bin/cut"
HEAD="/usr/bin/head"
SORT="/usr/bin/sort"
GREP="/usr/bin/grep"
XARGS="/usr/bin/xargs"

LEASES="/var/lib/misc/dnsmasq.leases"
SIM_UNDERLAY_FILE="/etc/frognet/simulator_underlay"

debugTag() {
  if [[ -x /usr/local/bin/debugTag ]]; then
    /usr/local/bin/debugTag "$*"
  else
    : # silent
  fi
}

_list_physical_interfaces() {
  $IP -o link show | $AWK -F': ' '{print $2}' | $CUT -d'@' -f1 | while read -r dev; do
    [[ "$dev" == "lo" ]] && continue
    [[ "$dev" == veth* ]] && continue
    [[ "$dev" == docker* ]] && continue
    [[ "$dev" == br-* ]] && continue
    [[ "$dev" == virbr* ]] && continue
    echo "$dev"
  done | $SORT -u
}

_list_up_interfaces() {
  for dev in $(_list_physical_interfaces); do
    local state
    state="$(cat /sys/class/net/$dev/operstate 2>/dev/null)"
    if [[ "$state" == "up" || "$state" == "unknown" ]]; then
      echo "$dev"
    fi
  done
}

_dev_ip4() {
  local dev="$1"
  $IP -4 addr show dev "$dev" 2>/dev/null | $AWK '/inet /{print $2}' | $HEAD -n1 | $CUT -d/ -f1
}

_dev_has_transit30() {
  local dev="$1"
  $IP -4 -o addr show dev "$dev" 2>/dev/null | $GREP -q '10\.253\.253\..*/30'
}

_dev_has_frognet_24() {
  local dev="$1"
  $IP -4 -o addr show dev "$dev" 2>/dev/null | $GREP -E '10\.[0-9]+\.[0-9]+\.[0-9]+/24' | $GREP -qv '10\.253\.253\.'
}

_dev_serves_dhcp() {
  local dev="$1"
  [[ -f "$LEASES" && -s "$LEASES" ]] || return 1
  local ip4
  ip4="$(_dev_ip4 "$dev")"
  [[ "$ip4" == *.1 ]] && return 0
  return 1
}

# [UPSTREAM_DEVIPS_V1] does this dev hold ANY .1 address in 10.x (i.e.
# we own a served /24 on it). Stricter than _dev_serves_dhcp because it
# doesn't require dnsmasq.leases to be non-empty — a newly-booted AP
# with no clients yet is still serving and still downstream.
_dev_owns_served24() {
  local dev="$1"
  $IP -4 -o addr show dev "$dev" 2>/dev/null \
    | $AWK '/inet /{print $4}' \
    | $CUT -d/ -f1 \
    | $GREP -E '^10\.[0-9]+\.[0-9]+\.1$' \
    | $GREP -qv '^10\.253\.253\.' && return 0
  return 1
}

# [UPSTREAM_DEVIPS_V1] emit each 10.x address on a dev that qualifies
# as a FrogNet upstream IP: 10.x, not transit (10.253.253.*), not in
# sim underlay, not a .1 (which would be one we serve). Excludes our
# own served-LAN address even if it shares a dev with the upstream.
_dev_upstream_ips() {
  local dev="$1"
  $IP -4 -o addr show dev "$dev" 2>/dev/null \
    | $AWK '/inet /{print $4}' \
    | $CUT -d/ -f1 \
    | while read -r ip; do
        [[ -z "$ip" ]] && continue
        # Exclude addresses that aren't real upstream identities:
        #   10.253.0.0/16 (entire reserved transit range —
        #   wg /30s live here, e.g. 10.253.201.x, 10.253.202.x, not
        #   just 10.253.253.x); 10.254.0.0/16 (pond addresses,
        #   frognet0 intra-FrogNet); .1 we serve (downstream); sim
        #   underlay; link-local; loopback; multicast/reserved;
        #   broadcast; 0.0.0.0. Anything else — including non-10.x
        #   RFC1918 and public IPs — counts as an upstream
        #   connection per the omnidirectional-routing spec.
        [[ "$ip" == 10.253.* ]] && continue
        [[ "$ip" == 10.254.* ]] && continue
        [[ "$ip" == *.1 ]] && continue
        [[ "$ip" == 169.254.* ]] && continue
        [[ "$ip" == 127.* ]] && continue
        [[ "$ip" == 0.* ]] && continue
        [[ "$ip" == 255.255.255.255 ]] && continue
        # 224.0.0.0/4 (multicast) + 240.0.0.0/4 (reserved): first octet
        # 224-255. Anything 224+ first octet is not a unicast address.
        first="${ip%%.*}"
        if [[ "$first" -ge 224 ]] 2>/dev/null; then continue; fi
        _ip_in_sim_underlay "$ip" && continue
        echo "$ip"
      done
}

_ip_in_sim_underlay() {
  local ip="$1"
  [[ -f "$SIM_UNDERLAY_FILE" ]] || return 1
  local net
  net="$(/usr/local/bin/convertToSubnetRange "$ip" 2>/dev/null)"
  [[ -n "$net" ]] || return 1
  $GREP -q "^$net\$" "$SIM_UNDERLAY_FILE"
}

_seed_from_ip4() {
  local ip="$1"
  [[ "$ip" == 10.* ]] || return 1
  [[ "$ip" == 10.253.253.* ]] && return 1
  _ip_in_sim_underlay "$ip" && return 1
  echo "$ip" | $AWK -F. '{print $1"."$2"."$3".1"}'
}

FROGNET_INTERFACES=""
FROGNET_TRANSIT_DEVS=""
FROGNET_FROGNET_DEVS=""
FROGNET_DHCP_DEVS=""
FROGNET_UPSTREAM_SEEDS=""
# [UPSTREAM_DEVIPS_V1] space-separated list of "dev=ip" pairs for every
# interface holding an upstream IP. An upstream is anything on a dev
# that is NOT eth0 (always downstream per design), NOT a dev we own a
# served-LAN .1 on, NOT transit /30, and the IP itself is a real
# unicast address (not link-local, loopback, multicast, broadcast,
# all-zeros, or sim underlay). Includes non-10.x — a public or
# RFC1918-other IP on, say, eth1 counts as an upstream connection
# even though no FrogNet node assigned it.
# Consumers (getWlan0IP, getWlan1IP) take the first two entries in
# discovery order (alphabetical by dev, multiple IPs per dev in the
# order `ip` emits them). Extras beyond the first two are dropped.
FROGNET_UPSTREAM_DEVIPS=""

for dev in $(_list_up_interfaces); do
  FROGNET_INTERFACES="$FROGNET_INTERFACES $dev"
  
  if _dev_has_transit30 "$dev"; then
    FROGNET_TRANSIT_DEVS="$FROGNET_TRANSIT_DEVS $dev"
    debugTag "interface dev=$dev type=transit"
  fi
  
  if _dev_has_frognet_24 "$dev"; then
    FROGNET_FROGNET_DEVS="$FROGNET_FROGNET_DEVS $dev"
    debugTag "interface dev=$dev type=frognet_subnet"
  fi
  
  if _dev_serves_dhcp "$dev"; then
    FROGNET_DHCP_DEVS="$FROGNET_DHCP_DEVS $dev"
    debugTag "interface dev=$dev type=dhcp_server"
  fi
  
  ip4="$(_dev_ip4 "$dev")"
  if [[ -n "$ip4" ]]; then
    seed="$(_seed_from_ip4 "$ip4")"
    if [[ -n "$seed" ]]; then
      FROGNET_UPSTREAM_SEEDS="$FROGNET_UPSTREAM_SEEDS $seed"
      debugTag "seed dev=$dev ip=$ip4 seed=$seed"
    fi
  fi

  # [UPSTREAM_DEVIPS_V1] upstream-IP enumeration. Per spec:
  #   - eth0 (or whatever eth0Name maps to) is always downstream.
  #   - any dev that owns a served-LAN .1 is downstream.
  #   - transit-only devs (10.253.253.*/30) are not upstream either.
  # The remaining candidates are devs holding a 10.x address that some
  # other FrogNet node DHCP-assigned to us. Multiple IPs per dev are
  # emitted as separate "dev=ip" pairs.
  # [UPLINK_BY_FUNCTION_V1 - T4b] by what the link is, not its name: no dev is "always downstream" because it is
  # called eth0 (on a container or a one-NIC box eth0 IS the uplink); the served dev is excluded because it holds
  # the .1.
  if ! _dev_owns_served24 "$dev" \
     && ! _dev_has_transit30 "$dev"; then
    while read -r up_ip; do
      [[ -n "$up_ip" ]] || continue
      FROGNET_UPSTREAM_DEVIPS="$FROGNET_UPSTREAM_DEVIPS $dev=$up_ip"
      debugTag "upstream dev=$dev ip=$up_ip"
    done < <(_dev_upstream_ips "$dev")
  fi
done

TRANSIT_SEEDS_FILE="/etc/sentinels/transit_upstream_seeds"
if [[ -f "$TRANSIT_SEEDS_FILE" ]]; then
  while read -r s; do
    [[ -n "$s" ]] || continue
    [[ "$s" == 10.* ]] || continue
    [[ "$s" == 10.253.253.* ]] && continue
    FROGNET_UPSTREAM_SEEDS="$FROGNET_UPSTREAM_SEEDS $s"
    debugTag "seed_from_transit_file seed=$s"
  done < "$TRANSIT_SEEDS_FILE"
fi

export FROGNET_INTERFACES="$(echo $FROGNET_INTERFACES | $XARGS)"
export FROGNET_TRANSIT_DEVS="$(echo $FROGNET_TRANSIT_DEVS | $XARGS)"
export FROGNET_FROGNET_DEVS="$(echo $FROGNET_FROGNET_DEVS | $XARGS)"
export FROGNET_DHCP_DEVS="$(echo $FROGNET_DHCP_DEVS | $XARGS)"
export FROGNET_UPSTREAM_SEEDS="$(echo $FROGNET_UPSTREAM_SEEDS | $XARGS)"
export FROGNET_UPSTREAM_DEVIPS="$(echo $FROGNET_UPSTREAM_DEVIPS | $XARGS)"

debugTag "FROGNET_INTERFACES='$FROGNET_INTERFACES'"
debugTag "FROGNET_TRANSIT_DEVS='$FROGNET_TRANSIT_DEVS'"
debugTag "FROGNET_UPSTREAM_SEEDS='$FROGNET_UPSTREAM_SEEDS'"
debugTag "FROGNET_UPSTREAM_DEVIPS='$FROGNET_UPSTREAM_DEVIPS'"

# ---------------------------------------------------------------------------
# eth0Name / wlan0Name / wlan1Name -- [LEGACY_NAMES_ARE_DETECTED_V1] [UPLINK_BY_FUNCTION_V1 - T4b]
# The ROLES, decided by what each link is (the names are historical: the role "eth0" is the LAN this node serves):
#   eth0Name   the wired dev that owns a served /24 (holds a 10.A.B.1); on a fresh install (nothing served yet) the
#              wired dev with no address (an addressed one holds a lease: it is a link INTO a network); else the
#              only wired dev. Overlay and tunnel devices (wg*, frognet*, tun*, the reserved 10.253/10.254 planes)
#              never.
#   wlan0Name  the radio hostapd projects on (hostapd.conf's interface=), whatever the kernel calls it; else the
#              first radio. wlan1Name: the next radio. A radio is what the kernel says is wireless
#              (/sys/class/net/X/wireless), not a name. No radio: the conventional names (they name no device).
# A pin in interfaces_override.conf / active_interface (the installer's --lan-iface) wins when it names a device
# that exists here; a pin naming a device this machine does not have is ignored (and said with debugTag).
# Sourcing this file writes nothing to stderr.
# ---------------------------------------------------------------------------
_MI_SYS=/sys/class/net
_mi_is_overlay() { case "$1" in lo|wg*|frognet*|tun*|tap*|veth*|docker*|br-*|virbr*) return 0 ;; esac; return 1; }
_mi_is_radio() { [[ -d "$_MI_SYS/$1/wireless" ]]; }
_mi_exists() { [[ -n "$1" && -e "$_MI_SYS/$1" ]]; }
_mi_detect_lan() {
  local dev ips first_bare="" only="" n=0
  for dev in $(ls "$_MI_SYS" 2>/dev/null | $SORT); do
    _mi_is_overlay "$dev" && continue
    _mi_is_radio "$dev" && continue
    n=$((n+1)); only="$dev"
    ips="$($IP -4 -o addr show dev "$dev" 2>/dev/null | $AWK '/inet /{print $4}' | $CUT -d/ -f1)"
    if echo "$ips" | $GREP -E '^10\.[0-9]+\.[0-9]+\.1$' | $GREP -qvE '^10\.25[34]\.'; then echo "$dev"; return 0; fi
    [[ -z "$ips" && -z "$first_bare" ]] && first_bare="$dev"
  done
  [[ -n "$first_bare" ]] && { echo "$first_bare"; return 0; }
  [[ "$n" -eq 1 ]] && { echo "$only"; return 0; }
  return 1
}
_mi_radios() {   # the hostapd radio first, then the rest, by name
  local ap="" dev
  if [[ -r /etc/hostapd/hostapd.conf ]]; then
    ap="$($GREP -m1 '^interface=' /etc/hostapd/hostapd.conf 2>/dev/null | $CUT -d= -f2)"
  fi
  _mi_is_radio "$ap" 2>/dev/null && echo "$ap" || ap=""
  for dev in $(ls "$_MI_SYS" 2>/dev/null | $SORT); do
    [[ "$dev" == "$ap" ]] && continue
    _mi_is_radio "$dev" && echo "$dev"
  done
}
_mi_lan="$(_mi_detect_lan)"
_mi_r=( $(_mi_radios) )
export eth0Name="${_mi_lan:-eth0}"
export wlan0Name="${_mi_r[0]:-wlan0}"
export wlan1Name="${_mi_r[1]:-wlan1}"

# [WIRED_LAN_IS_NOT_THE_SERVED_LAN_V1] wiredLanName is the WIRED dev of the LAN role: detection, then the installer's
# pin in interfaces_override.conf -- never active_interface, which is frognet-netstart's record of the dev serving
# the LAN NOW (the AP radio in wireless mode). setup_lillypad took eth0Name, got the radio from that pin, and built an
# ethernet NetworkManager profile on it ("No suitable device ... connection type is not loopback").
for _mi_pinfile in /etc/frognet/interfaces_override.conf /etc/frognet/active_interface; do
  if [[ "$_mi_pinfile" == /etc/frognet/active_interface ]]; then
    if _mi_is_radio "$eth0Name"; then export wiredLanName="${_mi_lan:-eth0}"; else export wiredLanName="$eth0Name"; fi
  fi
  [[ -r "$_mi_pinfile" ]] || continue
  _mi_pins="$( unset eth0Name wlan0Name wlan1Name; . "$_mi_pinfile" >/dev/null 2>&1; printf '%s %s %s' "${eth0Name:--}" "${wlan0Name:--}" "${wlan1Name:--}" )"
  read -r _p_e _p_w0 _p_w1 <<<"$_mi_pins"
  for _pair in "eth0Name:$_p_e" "wlan0Name:$_p_w0" "wlan1Name:$_p_w1"; do
    _k="${_pair%%:*}"; _v="${_pair#*:}"
    [[ "$_v" == "-" || -z "$_v" ]] && continue
    if _mi_exists "$_v"; then export "$_k=$_v"
    else debugTag "pin $_k=$_v in $_mi_pinfile names no device here: ignored"; fi
  done
done
unset _mi_lan _mi_r _mi_pinfile _mi_pins _p_e _p_w0 _p_w1 _pair _k _v

debugTag "ROLES eth0Name=$eth0Name wiredLanName=$wiredLanName wlan0Name=$wlan0Name wlan1Name=$wlan1Name"
:
