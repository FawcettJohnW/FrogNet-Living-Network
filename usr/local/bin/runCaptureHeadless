# Headless camera sender — NO window, no display.
#   runCaptureHeadless NAME [RELAY] [extra…]
# Default relay mediahost.frognet:9000 (elected media role). Override: 2nd arg or $FN_RELAY.
HERE="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$HERE/fnav.py" ]; then COMM_DIR="${COMM_DIR:-$HERE}"; else COMM_DIR="${COMM_DIR:-/etc/frognet_bundles/communicator}"; fi
: "${FN_RELAY:=mediahost.frognet:9000}"
if [ -z "$1" ]; then echo "usage: runCaptureHeadless NAME [RELAY] [extra…]" >&2; exit 2; fi
name="$1"; shift
relay="$FN_RELAY"
if [ -n "$1" ] && [ "${1#-}" = "$1" ]; then relay="$1"; shift; fi
echo "[runCaptureHeadless] name=${name} relay=${relay} cam=0 codec=vp8 (headless)" >&2
exec python3 "$COMM_DIR/fnav.py" --call "$relay" --name "$name" --no-display --cam 0 --codec vp8 "$@"
