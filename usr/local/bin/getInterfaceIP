DEV="${1:-}"
[[ -z "$DEV" ]] && { echo "0.0.0.0"; exit 0; }
ip link show "$DEV" 2>/dev/null | grep -q ",UP," || { echo "0.0.0.0"; exit 0; }
IP4="$(ip -4 addr show scope global "$DEV" 2>/dev/null | grep inet | tr -s ' ' | cut -d ' ' -f 3 | sed 's/\/.*$//' | head -1)"
[[ -z "$IP4" ]] && echo "0.0.0.0" || echo "$IP4"
