# =============================================================================
# ConnectFamily — Connect this FrogNet to your family network
#
# Usage:
#   ConnectFamily <passcode>
#
# This is the consumer-facing command. It calls the registration script
# with the passcode, auto-detects the local subnet, and handles everything.
# =============================================================================

if [ "$#" -lt 1 ]; then
    echo ""
    echo "  ConnectFamily <passcode>"
    echo ""
    echo "  Connect this FrogNet to your family network using"
    echo "  the passcode from your purchase."
    echo ""
    echo "  Example:  ConnectFamily smoking-stovepipe"
    echo ""
    exit 1
fi

PASSCODE="$1"
REGISTER="/usr/local/bin/frognet-tunnel-register.sh"

if [[ ! -x "$REGISTER" ]]; then
    echo "ERROR: Registration script not found at ${REGISTER}" >&2
    exit 1
fi

echo ""
echo "Connecting your FrogNet to the family network..."
echo ""

exec "$REGISTER" "$PASSCODE"
