+
+-- [A_COORDINATE_IS_NOT_AN_IP_V1] SensorNetwork was NOT NULL with no default, and api.php
+-- fills it only when SensorAddress parses as an IPv4. A writer whose address is an
+-- identity rather than an IP -- any client that is not a FrogNet node -- therefore could
+-- not write at all: "Field 'SensorNetwork' doesn't have a default value". The network is
+-- not part of the tuple address and is not required. Same treatment SensorLocation has.
+ALTER TABLE Sensor MODIFY `SensorNetwork` VARCHAR(1024) NOT NULL DEFAULT '';
