"""[SIM_ROOT_REDIRECT_V1] Per-run sentinel/hosts sandbox for the simulator.

Drop next to discovery/sim/system.py.  Call install_sim_root() BEFORE building
a System.  It points FROGNET_SENTINEL_DIR and FROGNET_HOSTS_FILE at a fresh
temp dir, so real-merge code reads a world derived from the spec instead of
whatever the live mesh looked like on this box.

Adaptivity is preserved by seeding that world FROM the spec (seed_from_spec),
or by building a spec from the local machine first and then seeding from it.
The invariant is that the fabric under test contains exactly what the spec
declares -- nothing the scenario didn't ask for.
"""
import atexit
import os
import shutil
import tempfile

_ACTIVE = []


def install_sim_root(prefix="frognet-sim-"):
    """Redirect sentinel + hosts reads/writes at a fresh temp root. Returns it."""
    root = tempfile.mkdtemp(prefix=prefix)
    sent = os.path.join(root, "sentinels")
    os.makedirs(sent, exist_ok=True)
    hosts = os.path.join(root, "hosts")
    open(hosts, "w").close()
    os.environ["FROGNET_SENTINEL_DIR"] = sent
    os.environ["FROGNET_HOSTS_FILE"] = hosts
    os.environ["FROGNET_ROUTE_ALIVE_STORE"] = os.path.join(sent, "route_alive.tsv")
    _ACTIVE.append(root)
    return root


def seed_from_spec(spec):
    """Populate the sandbox hosts file from the declared topology only."""
    hosts = os.environ["FROGNET_HOSTS_FILE"]
    lines = ["127.0.0.1\tlocalhost"]
    for n in spec.nodes:
        if getattr(n, "dead", False):
            continue
        lines.append(f"{n.subnet3}.1\t{n.name}.frognet\t{n.name}")
    with open(hosts, "w") as f:
        f.write("\n".join(lines) + "\n")
    return hosts


def teardown_sim_root():
    while _ACTIVE:
        shutil.rmtree(_ACTIVE.pop(), ignore_errors=True)
    for k in ("FROGNET_SENTINEL_DIR", "FROGNET_HOSTS_FILE",
              "FROGNET_ROUTE_ALIVE_STORE"):
        os.environ.pop(k, None)


atexit.register(teardown_sim_root)
