[Unit]
Description=FrogNet Tunnel Broker v3
After=network.target

[Service]
ExecStart=/opt/frognet-broker-v3/venv/bin/python3 /opt/frognet-broker-v3/venv/bin/uvicorn \
    --host 127.0.0.1 \
    --port 18427 \
    --log-level info \
    frognet_broker:app
WorkingDirectory=/opt/frognet-broker-v3
Environment=PYTHONPATH=/opt/frognet-broker-v3
Environment=FROGNET_BROKER_DIR=/var/lib/frognet_broker_v3
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
