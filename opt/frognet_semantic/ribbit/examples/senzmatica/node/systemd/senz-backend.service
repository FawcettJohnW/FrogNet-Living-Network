[Unit]
Description=SenzMatica test: converted backend (Spring Boot, JNI into API++)
After=network-online.target senz-mongo.service senz-broker.service
Wants=network-online.target
# never give up: a role that cannot reach its peers keeps trying every 2 s until they are back
StartLimitIntervalSec=0

[Service]

ExecStartPre=/bin/cat /opt/senz/BUILD
ExecStart=/opt/senz/env/bin/java -Djava.library.path=/opt/senz/lib -Dloader.path=/opt/senz/backend/lib -cp /opt/senz/backend/core-service-1.0.0.0.jar org.springframework.boot.loader.PropertiesLauncher --spring.config.location=/opt/senz/var/backend.properties
StandardInput=null
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
