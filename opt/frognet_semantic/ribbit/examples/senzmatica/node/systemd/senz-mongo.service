[Unit]
Description=SenzMatica test: MongoDB for the backend
After=network-online.target 
Wants=network-online.target
# never give up: a role that cannot reach its peers keeps trying every 2 s until they are back
StartLimitIntervalSec=0

[Service]

ExecStartPre=/bin/cat /opt/senz/BUILD
ExecStart=/opt/senz/env/bin/mongod --nounixsocket --bind_ip 127.0.0.1 --port 27027 --dbpath /opt/senz/var/mongo --setParameter diagnosticDataCollectionEnabled=false
StandardInput=null
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
