[Unit]
Description=SenzMatica test: the RAM memory
After=network-online.target 
Wants=network-online.target
# never give up: a role that cannot reach its peers keeps trying every 2 s until they are back
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/opt/senz/var/ram.env
ExecStartPre=/bin/cat /opt/senz/BUILD
ExecStart=/opt/senz/bin/region-host ${RAM_LISTEN}
StandardInput=null
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
