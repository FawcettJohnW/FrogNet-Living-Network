--- /dev/null	2026-09-24 04:57:16.770364773 +0000
+++ instrumented-control/lisp/lispmetrics.py	2026-09-24 05:43:13.736200245 +0000
@@ -0,0 +1,12 @@
+# Optional, append-only characterization telemetry. Disabled unless LISP_METRICS_FILE is set.
+import json, os, threading, time
+_lock=threading.Lock()
+def emit(kind, **fields):
+    path=os.getenv('LISP_METRICS_FILE')
+    if not path:return
+    rec={'ts_ns':time.time_ns(),'mono_ns':time.monotonic_ns(),'pid':os.getpid(),'kind':kind}; rec.update(fields)
+    line=json.dumps(rec,sort_keys=True,separators=(',',':'))+'\n'
+    try:
+        with _lock:
+            with open(path,'a',encoding='utf-8') as f:f.write(line)
+    except Exception: pass
