#!/bin/bash
# fdf-join HOST:PORT -- [FDF_JOIN_V1] make this machine a member of the FD&F network whose RAM manager is HOST:PORT.
#   writes  RINA_RAM=HOST:PORT to /opt/fdf/var/join.env (fdf.env sources it; a new package untar keeps it)
#   installs /etc/systemd/system/fdf-client.service: /opt/fdf/bin/fdf-client, this machine's membership. It runs while
#            the session to the RAM manager is up; when the session ends, systemd starts it again.
#   starts  it now, and enables it at boot.
# Run as root. HOST must be an IP address (the static fdf-client does not use the system's name resolver).
# Nothing goes into /usr/local/bin. fdf-leave undoes all of it.
set -eu
[ "$(id -u)" = 0 ] || { echo "fdf-join: run as root" >&2; exit 1; }
WHERE=${1:?usage: fdf-join HOST:PORT   (e.g. fdf-join 165.232.153.144:8840)}
case "$WHERE" in *:*) ;; *) echo "fdf-join: give HOST:PORT, e.g. 165.232.153.144:8840" >&2; exit 2 ;; esac
H=${WHERE%:*}
[[ "$H" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "fdf-join: $H is not an IPv4 address (the static fdf-client takes an address)" >&2; exit 2; }
# [FDF_ARCH_CHECK_V1] fdf-client must be built for this machine (fdf-node.tgz: x86_64; fdf-node-arm64.tgz: aarch64).
# Otherwise systemd starts it, it fails "Exec format error", and after 5 quick failures systemd stops trying -- quietly.
M=$(uname -m); E=$(od -An -tx1 -j18 -N1 /opt/fdf/bin/fdf-client | tr -d ' ')
case "$E" in 3e) B=x86_64 ;; b7) B=aarch64 ;; *) B="unknown (ELF machine 0x$E)" ;; esac
[ "$B" = "$M" ] || { echo "fdf-join: /opt/fdf/bin/fdf-client is built for $B, this machine is $M." >&2
                     [ "$M" = aarch64 ] && echo "          Install fdf-node-arm64.tgz:  cd / && tar xvzf - < /tmp/fdf-node-arm64.tgz" >&2
                     [ "$M" = x86_64 ]  && echo "          Install fdf-node.tgz:  cd / && tar xvzf - < /tmp/fdf-node.tgz" >&2
                     exit 1; }
mkdir -p /opt/fdf/var
printf 'export RINA_RAM=%s\n' "$WHERE" > /opt/fdf/var/join.env
cat > /etc/systemd/system/fdf-client.service <<EOF
[Unit]
Description=FD&F membership: this machine's session to the RAM manager at $WHERE
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/fdf/bin/fdf-client $WHERE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable fdf-client.service
systemctl restart fdf-client.service
echo "joined: RINA_RAM=$WHERE written to /opt/fdf/var/join.env; fdf-client.service started"
echo "check:  systemctl status fdf-client   |   journalctl -u fdf-client -f   |   /opt/fdf/bin/fdf-ls"
