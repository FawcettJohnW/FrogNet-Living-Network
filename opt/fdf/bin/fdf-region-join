#!/bin/bash
# fdf-region-join SITE_KEY [RAM_HOST:PORT] [AREA] -- [FDF_REGION_JOIN_V1] make this FrogNet node a member of the FD&F
# region and switch its tunnel daemon to region mode, in one go:
#   /opt/fdf/var/site.env   RINA_AREA=<area>  RINA_SITE_KEY=<key>   (fdf-client signs this node's /24 mapping with it;
#                           the key must be the one map_site holds on the RAM manager, or the region says EPERM)
#   fdf-join RAM            /opt/fdf/var/join.env (RINA_RAM) + fdf-client.service, started
#   frognet-tunnel-daemon-v3 restarted: it reads join.env + site.env ([REGION_SWITCH_V2]) and runs region mode
# Then it waits 15 s and shows what happened: the client's mapping line, the daemon's REGION lines, wg. Nothing hidden.
# Defaults: RAM 165.232.153.144:51888, area frognet. Run as root. Re-runnable.
set -u
[ "$(id -u)" = 0 ] || { echo "fdf-region-join: run as root" >&2; exit 1; }
KEY=${1:?usage: fdf-region-join SITE_KEY [RAM_HOST:PORT] [AREA]}
RAM=${2:-165.232.153.144:51888}; AREA=${3:-frognet}
case "$KEY" in *\<*|*\>*) echo "fdf-region-join: '$KEY' looks like a placeholder, not a key" >&2; exit 2 ;; esac
echo "== $(cat /opt/fdf/BUILD 2>/dev/null | tr '\n' ' ')"
M=$(uname -m); E=$(od -An -tx1 -j18 -N1 /opt/fdf/bin/fdf-client | tr -d ' ')
case "$E" in 3e) B=x86_64 ;; b7) B=aarch64 ;; *) B="unknown (ELF 0x$E)" ;; esac
[ "$B" = "$M" ] || { echo "fdf-region-join: /opt/fdf/bin/fdf-client is $B, this machine is $M: wrong tarball" >&2; exit 1; }
for f in /opt/frognet_semantic/internet_tunnels_v3/region.py /opt/frognet_semantic/discovery/real_backends.py; do
  [ -f "$f" ] || { echo "fdf-region-join: $f missing: the FrogNet region patch is not installed (it is in this tarball)" >&2; exit 1; }; done
mkdir -p /opt/fdf/var
printf 'RINA_AREA=%s\nRINA_SITE_KEY=%s\n' "$AREA" "$KEY" > /opt/fdf/var/site.env; chmod 600 /opt/fdf/var/site.env
echo "== site.env: RINA_AREA=$AREA RINA_SITE_KEY=<${#KEY} chars, ends ${KEY: -6}>"
# join.env first (the daemon's switch), then the daemon: it writes this node's name/guid/subnet/pubkey into
# facts.json at start, and fdf-client takes its member name from there at ITS start -- so the daemon goes first.
mkdir -p /opt/fdf/var; printf 'export RINA_RAM=%s\n' "$RAM" > /opt/fdf/var/join.env
# [STORE_UNITS_OFF_IN_REGION_V1] units whose only work in region mode is writing store tuples nobody reads, or waiting
# for pokes nobody sends: the 60 s databasehost/capability advertiser (it ran frognet_capability_probe.sh -- cpu
# benchmark, disk write+fsync -- every minute), the 1/min store elector (stands down in region mode), the
# merge watcher (propogateNotification exits in region mode). The daemon publishes capability as a fact.
# fdf-leave turns them back on.
for u in frognet-dbhost-advertise.timer frognet-dbhost-elect.timer frognet-merge-watcher.service; do
  [ -e "/etc/systemd/system/$u" ] || [ -e "/lib/systemd/system/$u" ] || continue
  systemctl disable --now "$u" 2>&1 | grep -v '^Removed' ; echo "== region mode: $u stopped and disabled"
done
T0=$(date '+%Y-%m-%d %H:%M:%S')
systemctl restart frognet-tunnel-daemon-v3
for i in $(seq 1 20); do grep -q '"name"' /opt/fdf/var/facts.json 2>/dev/null && break; sleep 0.5; done
grep -q '"name"' /opt/fdf/var/facts.json 2>/dev/null || echo "== warning: the daemon has not written facts.json yet; the member name may show as the hostname"
/opt/fdf/bin/fdf-join "$RAM" || exit 1
echo "== waiting 15 s for the join, the mapping and the hub"; sleep 15
echo "== fdf-client (want: 'joined the region', 'mapping ... registered'; 'REFUSED ... EPERM' = wrong key)"
journalctl -u fdf-client --since "$T0" --no-pager -o cat | grep -v PRIMED | tail -8
echo "== tunnel daemon (want: 'build', 'REGION switch', 'WG_KEY' on a first join, 'REGION: facts written', 'my-channels: hubs=[...]')"
journalctl -u frognet-tunnel-daemon-v3 --since "$T0" --no-pager -o cat | grep -E "Starting frognet-tunnel-daemon|REGION|WG_KEY|IDENTITY|Traceback|Error" | tail -12
echo "== wg (want: one peer, endpoint = the hub, a latest handshake)"
wg show 2>&1 | grep -E "^interface|endpoint|allowed|handshake"
echo "== members"; /opt/fdf/bin/fdf-ls 2>&1 | head -12
