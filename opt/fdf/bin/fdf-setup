"""fdf-setup -- [FDF_SETUP_V1] an organization's manager stands up their own FrogNet, on their own droplet, with nobody
from Fawcett Innovations in the room (opt/fdf/docs/ORGANIZATIONS.md section 1). Run as root, after untarring the droplet
bundle. It asks before it changes anything and fixes what is missing once the manager says yes. Run it again at any
time: what is there is shown and kept, and only what the manager adds or changes is done.

In order:
  1  what this machine needs (python3, wg, ip, nft, systemctl): a missing one is installed with apt-get once you say yes
  2  the RAM manager and the hub (fdf-region-create AREA PUBLIC_IP), if this machine holds no region yet
  3  the credential manager: the generic credential and the door (fdf-org init), and fdf-org.service started
  4  the RAM spaces, all at once: one RAM manager each on this machine (fdf-org space)
  5  the levels, in your own words: each with a password or none, its reach, and the spaces its applications join
  6  users and passwords, for each level that has a password
  7  a standby: for each level, the line `fdf-org line LEVEL` printed on the standby (it is set up by running fdf-setup
     there with the same spaces, levels and users), put after this RAM host in the line
  8  one join line per level, printed (and as a QR when qrencode is installed) and kept in /opt/fdf/var/lines/LEVEL.line
     (root-only); then how a device joins with it

  fdf-setup                 the wizard
  fdf-setup --lines         print every level's join line again (the standby lines given before are kept)

Tests set FDF_SETUP_NO_SYSTEMD=1 (the region exists already and fdf-org serve runs by itself) and FDF_ORG to fdf-org.
"""
import getpass, json, os, shlex, shutil, subprocess, sys

BIN = os.environ.get("FDF_BIN", "/opt/fdf/bin")
ORG = os.environ.get("FDF_ORG", os.path.join(BIN, "fdf-org"))
HUBENV = os.environ.get("FDF_HUB_ENV", "/opt/fdf/hub/hub.env")
VAR = os.environ.get("FDF_SITE_KEYS", "/opt/fdf/var")
LINES = os.path.join(VAR, "lines")
NO_SYSTEMD = os.environ.get("FDF_SETUP_NO_SYSTEMD") == "1"
EXAMPLES = "Watcher, Player, Host; Viewer, Commenter, Editor, Admin; First Responders, Headquarters, Hospitals, Ambulances"


def say(*a):
    print(*a, flush=True)


def ask(q, default=""):
    try:
        a = input("%s%s: " % (q, " [%s]" % default if default else "")).strip()
    except EOFError:
        a = ""
    return a or default


def yes(q, default=True):
    a = ask(q + (" (Y/n)" if default else " (y/N)")).lower()
    return default if not a else a.startswith("y")


def secret(q):
    if sys.stdin.isatty():
        return getpass.getpass(q + ": ")
    return sys.stdin.readline().rstrip("\n")


def org(*args, stdin=None):
    p = subprocess.run([sys.executable, ORG] + list(args), input=stdin, capture_output=True, text=True)
    out = (p.stdout + p.stderr).strip()
    if p.returncode != 0:
        say("  ! fdf-org %s failed: %s" % (" ".join(args[:2]), out))
    return p.returncode == 0, out


def need():
    say("== 1 what this machine needs")
    pkg = {"python3": "python3", "wg": "wireguard-tools", "ip": "iproute2", "nft": "nftables", "systemctl": "systemd"}
    missing = [b for b in pkg if shutil.which(b) is None and not (NO_SYSTEMD and b == "systemctl")]
    if not missing:
        say("  all here: " + ", ".join(pkg))
        return True
    say("  missing: " + ", ".join(missing))
    if not yes("  install %s with apt-get now?" % " ".join(pkg[b] for b in missing)):
        say("  not installed: setup stops here (it needs them)")
        return False
    r = subprocess.run(["apt-get", "install", "-y"] + [pkg[b] for b in missing])
    return r.returncode == 0


def public_ip():
    r = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"], capture_output=True, text=True)
    p = r.stdout.split()
    return p[p.index("src") + 1] if "src" in p else ""


def region():
    say("== 2 the RAM manager and the hub")
    if os.path.exists(HUBENV) and os.path.getsize(HUBENV):
        env = dict(l.strip().split("=", 1) for l in open(HUBENV) if "=" in l and not l.startswith("#"))
        say("  this machine holds region %s (hub %s, endpoint %s): kept" % (env.get("FDF_AREA"), env.get("FDF_HUB_NAME"), env.get("FDF_ENDPOINT")))
        return True
    say("  this machine holds no region yet. Its name is your organization's (letters, digits, . _ -, at most 12).")
    area = ask("  organization (region) name")
    ip = ask("  the address members reach this machine at", public_ip())
    if not area or not ip:
        say("  no name or address: setup stops here")
        return False
    if not yes("  run fdf-region-create %s %s now?" % (area, ip)):
        return False
    return subprocess.run([os.path.join(BIN, "fdf-region-create"), area, ip]).returncode == 0


def credentials():
    say("== 3 the credential manager")
    ok, init = org("init")
    if not ok:
        return False
    say("  " + init.splitlines()[-1] if init else "  ready")
    if NO_SYSTEMD:
        return True
    if subprocess.run(["systemctl", "is-active", "--quiet", "fdf-org.service"]).returncode == 0:
        say("  fdf-org.service is running")
        return True
    if not yes("  start fdf-org.service (the door, the logins, the spaces, the reach rules) now?"):
        return False
    subprocess.run(["systemctl", "daemon-reload"])
    return subprocess.run(["systemctl", "enable", "fdf-org.service"]).returncode == 0 and \
        subprocess.run(["systemctl", "start", "fdf-org.service"]).returncode == 0


def listing():
    """(spaces, {level: {password, reach, spaces}}) as this RAM host has them."""
    ok, out = org("list", "--json")
    try:
        j = json.loads(out.splitlines()[-1]) if ok and out else {}
    except ValueError:
        j = {}
    return j.get("spaces", []), j.get("levels", {})


def spaces():
    say("== 4 the RAM spaces (one shared memory each: what a group of applications shares)")
    have, _ = listing()
    say("  here now: %s" % (", ".join(have) if have else "none"))
    while True:
        n = ask("  a space to add (empty when done)")
        if not n:
            return True
        if n in have:
            say("  %s is here already" % n)
        elif yes("  add space %s?" % n):
            ok, out = org("space", n)
            say("  " + out.splitlines()[-1]) if ok else None
            have.append(n)


def levels():
    say("== 5 the levels, in your own words (for example: %s)" % EXAMPLES)
    sps, have = listing()
    for n, lv in have.items():
        say("  here now: %s (%s, reach %s, spaces %s)" % (n, "password" if lv["password"] else "no password",
                                                          lv["reach"].get("kind", "ram"), ", ".join(lv["spaces"]) or "none"))
    while True:
        n = ask("  a level to add or change (empty when done)")
        if not n:
            return True
        pw = yes("  does %s need a user and password?" % n, False)
        say("  reach: ram (its spaces and the RAM only: most levels), open (everything), or list:ADDR[:PORT],... ")
        reach = ask("  %s's reach" % n, "ram")
        joins = ask("  the spaces %s's applications join, comma separated (%s)" % (n, ", ".join(sps) or "none yet"))
        args = ["level", n, "--reach", reach] + (["--password"] if pw else [])
        for s in [x.strip() for x in joins.split(",") if x.strip()]:
            args += ["--space", s]
        if yes("  fdf-org %s ?" % " ".join(shlex.quote(a) for a in args)):
            ok, out = org(*args)
            if ok:
                say("  " + out.splitlines()[-1])


def users():
    say("== 6 users and passwords")
    _, lv = listing()
    for n, l in lv.items():
        if not l["password"]:
            continue
        say("  level %s has a password" % n)
        while True:
            u = ask("  a user at %s (empty when done)" % n)
            if not u:
                break
            pw = secret("  %s's password" % u)
            if not pw:
                say("  no password given: %s not set" % u)
                continue
            ok, out = org("user", n, u, stdin=pw + "\n")
            if ok:
                say("  " + out.splitlines()[-1])
    return True


def standby_file(level):
    return os.path.join(LINES, level + ".standby")


def standbys():
    say("== 7 a standby RAM host (optional): set it up by running fdf-setup there with the same spaces, levels and users")
    _, lv = listing()
    if not yes("  is there a standby to put after this RAM host in the lines?", False):
        return True
    os.makedirs(LINES, mode=0o700, exist_ok=True)
    for n in lv:
        l = ask("  the standby's line for %s (fdf-org line %s, printed there; empty to skip)" % (n, n))
        if l:
            write(standby_file(n), l + "\n")
    return True


def write(path, text):
    old = os.umask(0o077)
    try:
        open(path + ".tmp", "w").write(text)
        os.replace(path + ".tmp", path)
    finally:
        os.umask(old)


def lines():
    say("== 8 one join line per level")
    os.makedirs(LINES, mode=0o700, exist_ok=True)
    _, lv = listing()
    for n in lv:
        args = ["line", n]
        try:
            for l in open(standby_file(n)).read().split():
                args += ["--with", l]
        except OSError:
            pass
        ok, out = org(*args)
        if not ok:
            continue
        line = next((l for l in out.splitlines() if l.startswith("fdfjoin1.")), "")
        write(os.path.join(LINES, n + ".line"), line + "\n")
        say("  -- %s (kept in %s)" % (n, os.path.join(LINES, n + ".line")))
        say(out)
    say("  A device joins with its level's line: on Linux `fdf-login 'LINE'` (a node: `fdf-login 'LINE' --node`); the")
    say("  Windows and Android apps take the line (or its QR) at install. A level with a password asks for the user and")
    say("  password once. Start with your own device.")
    return True


def main():
    if "-h" in sys.argv or "--help" in sys.argv:
        say(__doc__.strip()); return 0
    if os.geteuid() != 0:
        sys.exit("fdf-setup: run as root")
    if "--lines" in sys.argv:
        return 0 if lines() else 1
    for step in (need, region, credentials, spaces, levels, users, standbys, lines):
        if not step():
            say("fdf-setup: stopped at %s; run it again to go on (what is done is kept)" % step.__name__)
            return 1
    say("fdf-setup: done. Run it again at any time to add spaces, levels, users or a standby.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
