# /opt/fdf/fdf.env -- FD&F settings for this machine. Source it: . /opt/fdf/fdf.env
# [OPERATOR_SETTINGS_SURVIVE_AN_UPDATE_V1 - T4a] This file SHIPS: every bundle (the node .run files and
# fdf-droplet.tgz) carries it, so untarring a new build writes it again. Nothing an operator sets goes here. This
# machine's own settings live in /opt/fdf/var (never shipped), which this file sources:
#   /opt/fdf/var/area.env   RINA_AREA=<the area's name>          (every machine in the area uses the same name)
#                           RINA_AREA_PASSWORD=<the area's password>  (ONLY on the mapping machine and on machines that
#                           may serve as the RAM manager, never on a plain member; the RAM manager signs its
#                           registration with it. Make one, once, when the area is created:
#                             head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
#   /opt/fdf/var/join.env   RINA_RAM=host:port, written by fdf-join, removed by fdf-leave [FDF_JOIN_V1]
# (The region units -- fdf-region-create's, fdf-join's -- carry their own settings and do not read this file.)
[ -r /opt/fdf/var/area.env ] && . /opt/fdf/var/area.env
# [NO_BUILT_IN_AREA_V1 - T4b] no default area name (it was rina-area.test here and "frognet" elsewhere): the area
# is the operator's, from var/area.env; a tool that needs it and finds none says so.
export RINA_AREA=${RINA_AREA:-}
export RINA_AREA_PASSWORD=${RINA_AREA_PASSWORD:-}
export PATH=/opt/fdf/bin:$PATH
export LD_LIBRARY_PATH=/opt/fdf/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export RINA_RAM_NETNS=/proc/self/ns/net                 # reach the RAM manager from this machine's own network
export RINA_CAPABILITY_PROBE=/opt/fdf/bin/frognet_capability_probe.sh
export RIBBIT_TEMPLATES=/opt/fdf/templates/fdf.prime     # BLDC-1's FD&F dictionary
export FDF_BIN=/opt/fdf/bin                             # for the web pages
[ -r /opt/fdf/var/join.env ] && . /opt/fdf/var/join.env
true
