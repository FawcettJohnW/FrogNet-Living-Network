#!/bin/bash
# fdf-region-join fdfinv1.<...> | fdfjoin1.<...> -- [FDF_REGION_JOIN_V1][ADMITTED_BY_INVITE_V1][ORG_NODE_JOIN_V1]
#   An organization's join line (fdfjoin1., ORGANIZATIONS.md section 3): fdf-login LINE --node logs in at every RAM
#   manager on it with the daemon's key and writes system-space.json, hub.json, site.env and join.env; a level with a
#   password asks for the user and password here. The rest is as below.
#   make this FrogNet node a member of the FD&F
# region that invited it (fdf-invite NAME on the region's machine printed the line), and switch its tunnel daemon to
# region mode, in one go:
#   /var/lib/frognet-tunnel/node_private.key, node_public.key   the WireGuard key the invitation carries (the hub has
#                           already admitted its public half; it is the only key the hub will answer)
#   /opt/fdf/var/hub.json   the hub: name, public key, endpoint (udp), its tunnel address; this node's edge address
#   /opt/fdf/var/site.env   RINA_AREA=<area>  RINA_SITE_KEY=<key>   (fdf-client signs this node's /24 mapping with it)
#   fdf-join RAM            /opt/fdf/var/join.env (RINA_RAM = the hub's tunnel address: [RAM_IN_THE_TUNNEL_V1]) +
#                           fdf-client.service, started
#   frognet-tunnel-daemon-v3 restarted: it brings up the hub channel first, then joins the region through it
# Then it waits 15 s and shows what happened. Nothing on this node is reachable from the Internet because of the join:
# the only packets it sends there are WireGuard's, to the hub's UDP port. Run as root. Re-runnable (the same line).
set -u
[ "$(id -u)" = 0 ] || { echo "fdf-region-join: run as root" >&2; exit 1; }
FILES_ONLY=0; [ "${1:-}" = "--files-only" ] && { FILES_ONLY=1; shift; }     # tests: lay the files down, start nothing
[ $# -eq 1 ] || { echo "usage: fdf-region-join fdfinv1.<...> | fdfjoin1.<...>   (fdf-invite NAME, or an organization's fdf-org line LEVEL / fdf-setup, prints it)" >&2; exit 2; }
case "$1" in fdfinv1.*|fdfjoin1.*) ;; *) echo "fdf-region-join: '$1' is neither an invitation (fdfinv1.) nor an organization's join line (fdfjoin1.)" >&2; exit 2 ;; esac
echo "== $(cat /opt/fdf/BUILD 2>/dev/null | tr '\n' ' ')"
if [ $FILES_ONLY = 0 ]; then
M=$(uname -m); E=$(od -An -tx1 -j18 -N1 /opt/fdf/bin/fdf-client | tr -d ' ')
case "$E" in 3e) B=x86_64 ;; b7) B=aarch64 ;; *) B="unknown (ELF 0x$E)" ;; esac
[ "$B" = "$M" ] || { echo "fdf-region-join: /opt/fdf/bin/fdf-client is $B, this machine is $M: wrong tarball" >&2; exit 1; }
for f in /opt/frognet_semantic/internet_tunnels_v3/region.py /opt/frognet_semantic/discovery/real_backends.py; do
  [ -f "$f" ] || { echo "fdf-region-join: $f missing: the FrogNet region patch is not installed (it is in this tarball)" >&2; exit 1; }; done
grep -q "RAM_IN_THE_TUNNEL_V1" /opt/frognet_semantic/internet_tunnels_v3/region.py || { echo "fdf-region-join: the installed region.py predates [RAM_IN_THE_TUNNEL_V1]: it would look for the hub in the region, which it cannot reach before the tunnel" >&2; exit 1; }
fi
mkdir -p /opt/fdf/var /var/lib/frognet-tunnel
if [ "${1#fdfjoin1.}" != "$1" ]; then                # [ORG_NODE_JOIN_V1] an organization's line
  PW=$(python3 -c 'import base64,json,sys; t=sys.argv[1][9:]; print(1 if json.loads(base64.urlsafe_b64decode(t+"="*(-len(t)%4))).get("password") else 0)' "$1") \
    || { echo "fdf-region-join: the join line does not decode: copy the whole line" >&2; exit 1; }
  CRED=""
  if [ "$PW" = 1 ]; then
    if [ -n "${FDF_JOIN_USER:-}" ]; then CRED="$FDF_JOIN_USER ${FDF_JOIN_PASSWORD:-}"
    else read -rp "user: " U; read -rsp "password: " P; echo; CRED="$U $P"; fi
  fi
  printf '%s\n' "$CRED" | python3 "${FDF_BIN:-/opt/fdf/bin}/fdf-login" "$1" --node || { echo "fdf-region-join: the login did not complete (above)" >&2; exit 1; }
  RAM=$(sed -n 's/^export RINA_RAM=//p' /opt/fdf/var/join.env); AREA=$(sed -n 's/^RINA_AREA=//p' /opt/fdf/var/site.env)
  echo "== logged in: area $AREA, the system space's first RAM manager $RAM ($(python3 -c 'import json; print(", ".join(m["name"] for m in json.load(open("/opt/fdf/var/system-space.json"))["managers"]))'))"
else
# the invitation, decoded and laid down; everything it says is printed but the two secrets
OUT=$(python3 - "$1" <<'PY'
import base64, json, os, subprocess, sys
tok = sys.argv[1][len("fdfinv1."):]
try:
    inv = json.loads(base64.urlsafe_b64decode(tok + "=" * (-len(tok) % 4)))
    area, key, ram, hub, me = inv["area"], inv["site_key"], inv["ram"], inv["hub"], inv["member"]
    for k in ("name", "pubkey", "endpoint", "addr"): hub[k]
    for k in ("name", "edge", "privkey"): me[k]
except Exception as e:
    sys.exit("fdf-region-join: the invitation does not decode (%s): copy the whole line fdf-invite printed" % e)
pub = subprocess.run(["wg", "pubkey"], input=me["privkey"], capture_output=True, text=True).stdout.strip()
if not pub: sys.exit("fdf-region-join: `wg pubkey` failed on the invitation's key (is wireguard-tools installed?)")
old = os.umask(0o077)
try:
    for path, text in (("/var/lib/frognet-tunnel/node_private.key", me["privkey"] + "\n"),):
        open(path + ".tmp", "w").write(text); os.chmod(path + ".tmp", 0o600); os.replace(path + ".tmp", path)
    open("/opt/fdf/var/site.env.tmp", "w").write("RINA_AREA=%s\nRINA_SITE_KEY=%s\n" % (area, key))
    os.chmod("/opt/fdf/var/site.env.tmp", 0o600); os.replace("/opt/fdf/var/site.env.tmp", "/opt/fdf/var/site.env")
finally:
    os.umask(old)
open("/var/lib/frognet-tunnel/node_public.key.tmp", "w").write(pub + "\n")
os.chmod("/var/lib/frognet-tunnel/node_public.key.tmp", 0o644)
os.replace("/var/lib/frognet-tunnel/node_public.key.tmp", "/var/lib/frognet-tunnel/node_public.key")
hj = {"area": area, "ram": ram, "hub": hub, "member": {k: v for k, v in me.items() if k != "privkey"}}
open("/opt/fdf/var/hub.json.tmp", "w").write(json.dumps(hj, indent=1, sort_keys=True) + "\n")
os.replace("/opt/fdf/var/hub.json.tmp", "/opt/fdf/var/hub.json")
print("AREA=%s RAM=%s" % (area, ram))
sys.stderr.write("== invitation: area %s, me %s (edge %s, key %s), hub %s at %s (key %s), region at %s inside the tunnel\n"
                 % (area, me["name"], me["edge"], pub, hub["name"], hub["endpoint"], hub["pubkey"], ram))
PY
) || exit 1
eval "$OUT"
fi
echo "== /var/lib/frognet-tunnel/node_private.key, /opt/fdf/var/hub.json, /opt/fdf/var/site.env written (site key <hidden>)"
# join.env first (the daemon's switch), then the daemon: it brings up the hub channel, then writes this node's
# name/guid/subnet/pubkey into facts.json, and fdf-client takes its member name from there at ITS start.
[ "${1#fdfjoin1.}" != "$1" ] || printf 'export RINA_RAM=%s\n' "$RAM" > /opt/fdf/var/join.env
[ $FILES_ONLY = 1 ] && { echo "== --files-only: written; nothing started"; exit 0; }
# [STORE_UNITS_OFF_IN_REGION_V1] in region mode the daemon publishes capability as a fact and elects from the members'
# facts; the merge writes no store. The 1/min store elector (frognet-dbhost-elect.timer) would have nothing to do (it
# stands down in region mode): stopped and disabled here, fdf-leave turns it back on. (The 60 s advertiser this also
# stopped is gone from the tree; an upgrade's prune removes it.) The merge watcher stays on in both modes: the
# NetworkManager hook's boot and interface-change merges are requests to it ([HOOK_ASKS_THE_WATCHER_V1], T4c).
for u in frognet-dbhost-elect.timer; do
  [ -e "/etc/systemd/system/$u" ] || [ -e "/lib/systemd/system/$u" ] || continue
  systemctl disable --now "$u" 2>&1 | grep -v '^Removed' ; echo "== region mode: $u stopped and disabled"
done
# a node joined before T4c had the watcher turned off here: on again (its failure is said; the next join retries)
if [ -e /etc/systemd/system/frognet-merge-watcher.service ] && ! systemctl is-enabled --quiet frognet-merge-watcher.service; then
  systemctl enable frognet-merge-watcher.service && systemctl start frognet-merge-watcher.service && echo "== the merge watcher: enabled (it runs in both modes)" \
    || echo "== warning: could not enable frognet-merge-watcher.service (above); the hook's merge requests wait for it"
fi
T0=$(date '+%Y-%m-%d %H:%M:%S')
systemctl restart frognet-tunnel-daemon-v3
# [EVENTS_NOT_TIMERS_V1] the daemon writing facts.json is the event (inotify), at most 10 s
python3 /opt/fdf/lib/python/fdf_watch.py has /opt/fdf/var/facts.json '"name"' 10 || echo "== warning: the daemon has not written facts.json yet; the member name may show as the hostname"
/opt/fdf/bin/fdf-join "$RAM" || exit 1
echo "== waiting for the join and the mapping (fdf-client says so; at most 30 s)"
timeout 30 journalctl -u fdf-client --since "$T0" -f -o cat 2>/dev/null | grep -q -m1 'mapping .* registered\|REFUSED' || echo "== warning: fdf-client has not said 'mapping ... registered' in 30 s (below)"
echo "== fdf-client (want: 'joined the region', 'mapping ... registered'; 'REFUSED ... EPERM' = wrong key)"
journalctl -u fdf-client --since "$T0" --no-pager -o cat | grep -v PRIMED | tail -8
echo "== tunnel daemon (want: 'REGION switch', 'my-channels: hub=<hub> edge=<edge> channels=1', 'handshake OK', 'REGION: facts written')"
journalctl -u frognet-tunnel-daemon-v3 --since "$T0" --no-pager -o cat | grep -E "Starting frognet-tunnel-daemon|REGION|WG_KEY|IDENTITY|Traceback|Error" | tail -12
echo "== wg (want: one peer, endpoint = the hub, a latest handshake)"
wg show 2>&1 | grep -E "^interface|endpoint|allowed|handshake"
echo "== members"; /opt/fdf/bin/fdf-ls 2>&1 | head -12
