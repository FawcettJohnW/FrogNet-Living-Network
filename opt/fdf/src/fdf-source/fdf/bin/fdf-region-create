#!/bin/bash
# fdf-region-create AREA PUBLIC_IP [--ram-port 51888] [--hub-port 50889] [--ufw] [--replace]
#   -- [FDF_REGION_CREATE_V1 - T4a] make THIS machine the holder of a new FD&F region: its RAM manager and its hub.
#
#   AREA      the region's name (letters, digits, '.', '_', '-'; at most 12, the hub's interface is wg-AREA)
#   PUBLIC_IP the IPv4 address the members reach this machine at: a public address for a droplet, a LAN address for a
#             region with no internet at all. Members need to reach ONE thing: PUBLIC_IP:HUB_PORT/udp, the hub's
#             WireGuard port, which answers nothing to a packet from a key it was not given ([RAM_IN_THE_TUNNEL_V1]:
#             the RAM manager listens only on the hub's tunnel address -- 10.253.A.B on a node serving 10.A.B.0/24,
#             10.253.253.254 elsewhere [HUB_ADDRESS_FROM_ITS_HOST_V1] -- reached through the tunnel)
#   --ufw     also run the firewall lines (ufw: default deny incoming, the hub's UDP port, the tunnel); without it they
#             are printed for the operator, and nothing is changed. ufw is not enabled and ssh is not touched here.
#
# In order, saying each step: the site key (made once, stored root-only in /opt/fdf/var/site-key-AREA, printed once at
# the end); the RAM manager unit fdf-ram-AREA (the region's WireGuard interface made first, then fdf-ram on
# 10.253.253.254:RAM_PORT, its records in /opt/fdf/var/area-AREA.perm) started; map_site AREA KEY on it; /opt/fdf/hub/AREA/hub.env (no tarball carries one: this is
# the one place it is made); fdf-hub started; fdf-client-AREA (the hub's own membership, named after this machine)
# started; what each said. Then how a member is invited (fdf-invite NAME) and joins (fdf-region-join fdfinv1.<...>).
# The machine needs /opt/fdf (fdf-droplet.tgz, or a node bundle), python3, wireguard-tools (wg) and, where the kernel has
# no WireGuard, wireguard-go. Run as root. A machine holds one region: a second run stops and says where the first is.
set -u
# [UMASK_IS_OURS_V1 - T4a] what this lays down under /etc, /opt and /usr must not take its modes from the caller's
# umask (a shell with umask 0000 made /opt/fdf and its bin/ world-writable, in the T4a container).
umask 022
[ "$(id -u)" = 0 ] || { echo "fdf-region-create: run as root" >&2; exit 1; }
usage() { echo "usage: fdf-region-create AREA PUBLIC_IP [--ram-port 51888] [--hub-port 50889] [--ufw] [--replace]
       fdf-region-create --migrate      (a region an earlier build made, into its own directory)" >&2; exit 2; }
# [REGIONS_PER_MACHINE_V1] a machine holds as many regions as it is given, each in /opt/fdf/hub/AREA/ (hub.env,
# admitted/, org-key, hub.key) with its own units: fdf-ram-AREA, fdf-hub@AREA, fdf-client-AREA, fdf-identity@AREA,
# fdf-org@AREA. Its ports are the ones given (defaults 51888 and 50889); one another region here uses is refused.
HUBROOT=/opt/fdf/hub
migrate() {   # a region made before regions had directories: /opt/fdf/hub/hub.env, admitted/, fdf-hub.service ...
  [ -f "$HUBROOT/hub.env" ] || return 0
  local OLD; OLD=$(sed -n 's/^FDF_AREA=//p' "$HUBROOT/hub.env"); [ -n "$OLD" ] || { echo "fdf-region-create: $HUBROOT/hub.env names no FDF_AREA" >&2; exit 1; }
  # [MIGRATE_ONLY_OWN_REGION_V1] a hub.env names the machine that holds it (FDF_HUB_NAME, written from hostname -s).
  # Found on Seattle7 2026-11-01: a copy of StreamingFrog's hub.env, left there, was moved and a hub started with it;
  # the hub address went onto Seattle7 and took its own membership down. A hub.env naming another machine is not
  # this machine's region: nothing is moved or started.
  local WHO; WHO=$(sed -n 's/^FDF_HUB_NAME=//p' "$HUBROOT/hub.env")
  if [ "$WHO" != "$(hostname -s)" ]; then
    echo "fdf-region-create: $HUBROOT/hub.env is $WHO's (FDF_HUB_NAME=$WHO), not this machine's ($(hostname -s)): this machine does not hold region $OLD. Nothing was changed. Remove that file if it is a stray copy." >&2
    exit 1
  fi
  echo "== [REGIONS_PER_MACHINE_V1] region $OLD, made by an earlier build: into $HUBROOT/$OLD/ (its keys, members and records stay)"
  systemctl disable --now fdf-hub.service fdf-identity.service fdf-org.service 2>&1 | grep -v "^Removed" | sed "s/^/   /"
  mkdir -p "$HUBROOT/$OLD"; chmod 700 "$HUBROOT/$OLD"
  [ -d "$HUBROOT/admitted" ] && mv "$HUBROOT/admitted" "$HUBROOT/$OLD/admitted"
  [ -f /opt/fdf/var/org-key ] && mv /opt/fdf/var/org-key "$HUBROOT/$OLD/org-key"
  { cat "$HUBROOT/hub.env"; grep -q '^FDF_IFACE=' "$HUBROOT/hub.env" || echo "FDF_IFACE=wg-${OLD//./-}"
    grep -q '^FDF_KEY=' "$HUBROOT/hub.env" || echo "FDF_KEY=/etc/wireguard/fdf-hub.key"; } > "$HUBROOT/$OLD/hub.env"
  rm -f "$HUBROOT/hub.env" /etc/systemd/system/fdf-hub.service /etc/systemd/system/fdf-identity.service /etc/systemd/system/fdf-org.service
  systemctl daemon-reload
  systemctl enable fdf-hub@$OLD.service fdf-identity@$OLD.service >/dev/null 2>&1
  systemctl start fdf-hub@$OLD.service fdf-identity@$OLD.service || { echo "fdf-region-create: fdf-hub@$OLD did not start: journalctl -u fdf-hub@$OLD" >&2; exit 1; }
  systemctl enable fdf-org@$OLD.service >/dev/null 2>&1; systemctl start fdf-org@$OLD.service || echo "   fdf-org@$OLD did not start: journalctl -u fdf-org@$OLD"   # [ADMISSION_WITH_THE_HUB_V1]
  echo "   region $OLD: fdf-hub@$OLD, fdf-identity@$OLD, fdf-org@$OLD running"
}
if [ "${1:-}" = --migrate ]; then
  [ "$(id -u)" = 0 ] || { echo "fdf-region-create: run as root" >&2; exit 1; }
  [ -f "$HUBROOT/hub.env" ] || { echo "== nothing to move: the regions here are in $HUBROOT/<AREA>/ ($(ls -d $HUBROOT/*/hub.env 2>/dev/null | sed "s|$HUBROOT/||;s|/hub.env||" | tr '\n' ' '))"; exit 0; }
  migrate; exit 0
fi
[ $# -ge 2 ] || usage
AREA=$1; ADDR=$2; shift 2
RAM_PORT=51888; HUB_PORT=50889; UFW=0; REPLACE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --ram-port) RAM_PORT=${2:?}; shift 2 ;;
    --hub-port) HUB_PORT=${2:?}; shift 2 ;;
    --ufw)      UFW=1; shift ;;
    --replace)  REPLACE=1; shift ;;
    *) usage ;;
  esac
done
[[ "$AREA" =~ ^[A-Za-z0-9._-]{1,12}$ ]] || { echo "fdf-region-create: AREA '$AREA': letters, digits, . _ -, at most 12 (the hub's interface is wg-$AREA)" >&2; exit 2; }
[[ "$ADDR" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "fdf-region-create: PUBLIC_IP '$ADDR' is not an IPv4 address (members reach this machine at it)" >&2; exit 2; }
[[ "$RAM_PORT" =~ ^[0-9]+$ && "$HUB_PORT" =~ ^[0-9]+$ ]] || usage
# [HUB_ADDRESS_FROM_ITS_HOST_V1] the hub's address: 10.253.A.B on a node serving 10.A.B.0/24, else 10.253.253.254
HUB_ADDR_WHY=$(FDF_PY=/opt/fdf/lib/python python3 -c 'import sys; sys.path.insert(0, "/opt/fdf/lib/python"); import fdf_regions as r; a, w = r.own_hub_addr(); print(a + " " + w)') \
  || { echo "fdf-region-create: could not work out the hub's address (fdf_regions.own_hub_addr)" >&2; exit 1; }
HUB_ADDR=${HUB_ADDR_WHY%% *}; IFACE=wg-${AREA//./-}
echo "== the hub's address: $HUB_ADDR (${HUB_ADDR_WHY#* })"
echo "== fdf-region-create $AREA at $ADDR (hub udp $HUB_PORT; RAM manager tcp $RAM_PORT on $HUB_ADDR, inside the tunnel only); $(tr '\n' ' ' 2>/dev/null < /opt/fdf/BUILD)"
for f in /opt/fdf/bin/fdf-ram /opt/fdf/bin/fdf-client /opt/fdf/bin/fdf-hub /opt/fdf/bin/fdf-events /opt/fdf/bin/fdf-wg-impl /opt/fdf/bin/fdf-invite; do
  [ -x "$f" ] || { echo "fdf-region-create: $f missing: install /opt/fdf first (cd / && tar xvzf - < /tmp/fdf-droplet.tgz)" >&2; exit 1; }; done
for b in python3 wg ip systemctl; do command -v $b >/dev/null || { echo "fdf-region-create: $b is required and missing (wg: apt-get install wireguard-tools)" >&2; exit 1; }; done
# [WG_IMPL_RECORDED_V1 - T4b] the hub's WireGuard implementation, chosen here once, by platform, and recorded
/opt/fdf/bin/fdf-wg-impl --record || { echo "fdf-region-create: no usable WireGuard implementation (above)" >&2; exit 1; }
migrate                                  # a region an earlier build made goes into its own directory first
HUBDIR=$HUBROOT/$AREA; HUBENV=$HUBDIR/hub.env; HUBKEY=$HUBDIR/hub.key
# --replace: region AREA made again here (its units stopped, its hub.env removed; its site key, records and members
# stay). A member whose join line named an earlier RAM manager address needs a new invitation.
if [ -e "$HUBENV" ] && [ "$REPLACE" = 1 ]; then
  echo "== --replace: stopping region $AREA (fdf-hub@$AREA, fdf-ram-$AREA, fdf-client-$AREA); its site key, records and members stay"
  systemctl disable --now "fdf-hub@$AREA.service" "fdf-ram-$AREA.service" "fdf-client-$AREA.service" 2>&1 | grep -v "^Removed" | sed "s/^/   /"
  ip link show "$IFACE" >/dev/null 2>&1 && ip link del "$IFACE" && echo "   $IFACE removed (made again below)"
  rm -f "$HUBENV"
fi
if [ -e "$HUBENV" ]; then
  echo "fdf-region-create: this machine already holds region $AREA ($HUBENV). To make it again: --replace" >&2; exit 1
fi
for e in "$HUBROOT"/*/hub.env; do      # the ports are the ones given; one another region here uses is refused
  [ -f "$e" ] || continue; O=$(sed -n 's/^FDF_AREA=//p' "$e")
  OR=$(sed -n 's/^RINA_RAM=.*://p' "$e"); OH=$(sed -n 's/^FDF_LISTEN=//p' "$e")
  [ "$OR" = "$RAM_PORT" ] && { echo "fdf-region-create: region $O here uses RAM manager port $RAM_PORT: give this one another (--ram-port)" >&2; exit 1; }
  [ "$OH" = "$HUB_PORT" ] && { echo "fdf-region-create: region $O here uses hub port $HUB_PORT: give this one another (--hub-port)" >&2; exit 1; }
done
mkdir -p "$HUBDIR"; chmod 700 "$HUBDIR"
V=/opt/fdf/var; mkdir -p "$V" /opt/fdf/hub; chmod 700 "$V"
KEYF=$V/site-key-$AREA
# [ONE_KEY_PER_REGION_V1] the key is made once. A run that stopped before hub.env was written left it: use that one.
if [ -s "$KEYF" ]; then
  KEY=$(cat "$KEYF"); echo "== site key: the one an earlier, unfinished run made ($KEYF)"
else
  KEY=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
  ( umask 077; printf '%s\n' "$KEY" > "$KEYF.tmp" ) && mv "$KEYF.tmp" "$KEYF" || { echo "fdf-region-create: could not write $KEYF" >&2; exit 1; }
  echo "== site key: made, stored root-only in $KEYF (mode $(stat -c %a "$KEYF"))"
fi
NAME=$(hostname -s)
RAMU=fdf-ram-$AREA; CLIU=fdf-client-$AREA; FACTS=$V/facts-$AREA.json
cat > /etc/systemd/system/$RAMU.service <<EOF
# made by fdf-region-create $AREA $ADDR: the region's RAM manager
[Unit]
Description=FD&F RAM manager (fdf-ram) for the $AREA region, TCP $RAM_PORT on $HUB_ADDR (inside the tunnel only)
After=network-online.target
Wants=network-online.target

[Service]
Environment=RINA_REGION_FILE=$V/area-$AREA.perm
Environment=FDF_HUB_ADDR=$HUB_ADDR
Environment=RIBBIT_TEMPLATES=/opt/fdf/templates/fdf.prime
Environment=FDF_PY=/opt/fdf/lib/python
# [RAM_IN_THE_TUNNEL_V1] the region's interface (its key, its UDP port, the hub address) before the RAM manager, which
# listens on that address and nowhere else. KillMode=process: a userspace WireGuard (wireguard-go) started here is not
# taken down with a RAM manager restart.
ExecStartPre=/usr/bin/python3 /opt/fdf/bin/fdf-hub --area $AREA --iface $IFACE --endpoint $ADDR:$HUB_PORT --listen $HUB_PORT --key $HUBKEY --iface-only
ExecStart=/opt/fdf/bin/fdf-ram --listen $HUB_ADDR:$RAM_PORT --api /FawcettInnovations.RINA.ram_interface.php
KillMode=process
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
EOF
cat > /etc/systemd/system/$CLIU.service <<EOF
# made by fdf-region-create $AREA $ADDR: the hub's own membership of the region, named after this machine ($NAME)
[Unit]
Description=FD&F member session of $NAME in the $AREA region (the hub's membership)
After=$RAMU.service fdf-hub@$AREA.service
Wants=$RAMU.service

[Service]
Environment=RINA_RAM=$HUB_ADDR:$RAM_PORT
Environment=RIBBIT_TEMPLATES=/opt/fdf/templates/fdf.prime
Environment=FDF_FACTS=$FACTS
Environment=FDF_NAME=$NAME
ExecStart=/opt/fdf/bin/fdf-client $HUB_ADDR:$RAM_PORT
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
EOF
[ -f /etc/systemd/system/fdf-hub@.service ] || { echo "fdf-region-create: /etc/systemd/system/fdf-hub@.service missing: it ships in the region-holder bundle" >&2; exit 1; }
systemctl daemon-reload
# [START_FAILURE_IS_SEEN_V1 - final gates] `systemctl enable --now` exits 0 when the start job fails (systemd 255, seen
# on the region host); `systemctl start` exits 1. So: enable, then start, and the start's status is the check.
systemctl enable $RAMU.service && systemctl start $RAMU.service || { echo "fdf-region-create: $RAMU did not start: journalctl -u $RAMU" >&2; exit 1; }
echo "== $RAMU started; waiting for it to answer on $HUB_ADDR:$RAM_PORT"
call() {   # call JSON -> the RAM manager's answer
  python3 - "$HUB_ADDR" "$RAM_PORT" "$1" <<'PY'
import json, sys, urllib.request
req = urllib.request.Request("http://%s:%s/FawcettInnovations.RINA.ram_interface.php?op=rina" % (sys.argv[1], sys.argv[2]),
                             data=sys.argv[3].encode(), headers={"Content-Type": "application/json"})
print(urllib.request.urlopen(req, timeout=5).read().decode())
PY
}
for i in $(seq 1 40); do call '{"op":"version"}' >/dev/null 2>&1 && break; sleep 0.5; done
call '{"op":"version"}' 2>/dev/null | sed 's/^/   RAM manager: /' || { echo "fdf-region-create: the RAM manager does not answer on $HUB_ADDR:$RAM_PORT: journalctl -u $RAMU" >&2; exit 1; }
R=$(call "{\"op\":\"map_site\",\"name\":\"$AREA\",\"key\":\"$KEY\"}" 2>&1)
case "$R" in *'"ok":true'*) echo "== map_site $AREA: $R" ;; *) echo "fdf-region-create: map_site $AREA was refused: $R" >&2; exit 1 ;; esac
cat > "$HUBENV.tmp" <<EOF
# $HUBENV -- made by fdf-region-create $AREA $ADDR on $(date -u +%Y-%m-%dT%H:%MZ). fdf-hub@$AREA.service reads it.
RINA_RAM=$HUB_ADDR:$RAM_PORT
FDF_HUB_ADDR=$HUB_ADDR
FDF_AREA=$AREA
FDF_HUB_NAME=$NAME
FDF_ENDPOINT=$ADDR:$HUB_PORT
FDF_LISTEN=$HUB_PORT
FDF_FACTS=$FACTS
FDF_BIN=/opt/fdf/bin
FDF_IFACE=$IFACE
FDF_KEY=$HUBKEY
EOF
mv "$HUBENV.tmp" "$HUBENV"; echo "== $HUBENV written"
T0=$(date '+%Y-%m-%d %H:%M:%S')
# A `systemctl start fdf-hub` before this run (no hub.env then) leaves the unit failed, and its restarts can use up
# systemd's start limit: that failure is from before hub.env existed, so it is cleared before the start.
HUBU=fdf-hub@$AREA; IDU=fdf-identity@$AREA
systemctl reset-failed $HUBU.service $CLIU.service $IDU.service 2>/dev/null
systemctl enable $HUBU.service $CLIU.service && systemctl start $HUBU.service $CLIU.service || { echo "fdf-region-create: $HUBU / $CLIU did not start: journalctl -u $HUBU -u $CLIU" >&2; exit 1; }
# [IDENTITY_FROM_ANY_MEMBER_V1] identities asked from any connected machine (fdf-identity NAME [--leaf]) are answered here
[ -f /etc/systemd/system/fdf-identity@.service ] || { echo "fdf-region-create: /etc/systemd/system/fdf-identity@.service missing: it ships in the region-holder bundle" >&2; exit 1; }
systemctl enable $IDU.service && systemctl start $IDU.service || { echo "fdf-region-create: $IDU did not start: journalctl -u $IDU" >&2; exit 1; }
# [ADMISSION_WITH_THE_HUB_V1] the door and the levels come up with the hub: fdf-org serve makes its own key, generic
# credential and door, and says where the hub is; levels and join lines are then made on any machine in the region
[ -f /etc/systemd/system/fdf-org@.service ] || { echo "fdf-region-create: /etc/systemd/system/fdf-org@.service missing: it ships in the region-holder bundle" >&2; exit 1; }
systemctl enable fdf-org@$AREA.service && systemctl start fdf-org@$AREA.service || { echo "fdf-region-create: fdf-org@$AREA did not start: journalctl -u fdf-org@$AREA" >&2; exit 1; }
# [FDF_CHAT_SERVICE_UNIT_V1] the area's one chat service, beside its RAM manager (fdf-chat@.service ships in this bundle)
systemctl enable fdf-chat@$RAM_PORT.service && systemctl start fdf-chat@$RAM_PORT.service || { echo "fdf-region-create: fdf-chat@$RAM_PORT did not start: journalctl -u fdf-chat@$RAM_PORT" >&2; exit 1; }
ADOPT=0; for i in $(seq 1 30); do journalctl -u $HUBU --since "$T0" --no-pager -o cat 2>/dev/null | grep -q 'start (adopt)' && { ADOPT=1; break; }; sleep 0.5; done
echo "== $HUBU (want: 'hub $NAME on $IFACE', 'start (adopt)')"
journalctl -u $HUBU --since "$T0" --no-pager -o cat | tail -4 | sed 's/^/   /'
[ "$ADOPT" = 1 ] || { echo "fdf-region-create: $HUBU did not say 'start (adopt)' within 15 s: journalctl -u $HUBU" >&2; exit 1; }
echo "== $CLIU"
journalctl -u $CLIU --since "$T0" --no-pager -o cat | grep -v PRIMED | tail -3 | sed 's/^/   /'
# [NOTHING_LISTENS_OUTSIDE_V1] with the firewall's default deny (a drop: no RST, no ICMP), a closed port is silent too,
# so the machine itself does not answer the Internet. Nothing here touches ssh: an ssh port left open is a port the
# Internet sees (fdf-hub's start line names it); the invisible way to administer this machine is through the region
# (ssh to $HUB_ADDR from a member).
FW=("ufw default deny incoming" "ufw allow $HUB_PORT/udp" "ufw route allow in on $IFACE out on $IFACE" "ufw allow in on $IFACE to $HUB_ADDR port $RAM_PORT proto tcp")
if [ "$UFW" = 1 ]; then
  for l in "${FW[@]}"; do echo "== $l"; $l; done
else
  echo "== firewall: members must reach $ADDR:$HUB_PORT/udp (nothing else), the RAM manager on $IFACE, and the hub forwards member to member."
  echo "   With default deny, every other port is silent (no reset, no ICMP). Allow ssh first if you administer this machine over the Internet (that port is then visible)."
  echo "   With ufw, run (or re-run this with --ufw):"; for l in "${FW[@]}"; do echo "     $l"; done
fi
echo
echo "== region $AREA is held here. Its site key (shown this once; it stays in $KEYF):"
echo
echo "     $KEY"
echo
echo "== nothing here listens to the Internet but udp $HUB_PORT (fdf-hub's [NOTHING_LISTENS_OUTSIDE_V1] line says what else does):"
journalctl -u $HUBU --since "$T0" --no-pager -o cat | grep -A6 NOTHING_LISTENS_OUTSIDE | head -8 | sed 's/^/   /'
echo
echo "== a member is invited here, once per member (it prints the one line the member joins with):"
echo "     /opt/fdf/bin/fdf-invite NAME --area $AREA"
echo "   and joins with it, on the member:"
echo "     sudo /opt/fdf/bin/fdf-region-join fdfinv1.<...>"
echo "   or at install:  sudo bash usr/local/bin/installer/frognet_install.sh --from-repo ... --invite fdfinv1.<...>"
