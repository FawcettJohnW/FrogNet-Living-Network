"""fdf-app -- [APP_DROPLET_V1] an app's RAMs, each served by a droplet on a member (opt/fdf/docs/APP-SETUP-AND-OPERATION.md).

  fdf-app config APP RAM[,RAM...] [--partition relocate|fail] [--login] [--category NAME]... [--role NAME[:default][@CATEGORY]]...
                 [--user USER:PASSWORD=ROLE[+lead]]... [--serve RAM[,RAM]] [--select RAM=KEY[,-KEY]...]... [--need RAM=KEY[,KEY]...]...
        [APP_SELECTION_V1] --serve: the RAMs this install offers to serve (default all); --select/--need: the app's own
        selection of the member that serves a RAM (RAM * for every RAM), ranked on the capability tuples' keys
        (fdf_select.py; default the most memory, then the most cores, then the highest guid).
        [CATEGORIES_V1] a role is a group in a category (the admin app's tabs: Teams, Power, Water ...); --category gives
        the tabs' order; a role with no @CATEGORY is in Teams.
        what the admin's install writes on each member it installs the app on: the droplet's configuration,
        FDF_APPS/<app>.json, naming the app's RAMs (the general RAM and one per team) and its partition behaviour. The
        droplet owns it: serve writes it into the network RAM as this droplet's configuration tuple,
        (fdf-app, config, <app>.<guid>), and writes it again whenever the network RAM changes, so a side of a split
        that cannot see the primary still has it (APP-SETUP-AND-OPERATION.md, Split, step 4). [APP_ACCESS_V1] The access
        definition goes with it: the roles the admin set up, the individuals each assigned a role (activated at their
        login; the password kept as a verifier, never the password), the role a client gets with no login (":default",
        e.g. a Team client against an EOC one: its default screen), and whether login is required. A role's client uses
        the general RAM and, when the app has one by that name, the role's own RAM. (The network's levels are the
        network's admission, ORGANIZATIONS.md; they have nothing to do with which RAM a team uses.) Login is a read: the client's
        own edge, on the member the device reaches (ram.php), checks the password against the verifier in these tuples.
        No login server, no request to another node.
        --admin USER:PASSWORD [ADMIN_APP_V1]: the app's administrator, for the admin app (a screen on a desktop or phone,
        through any member's door). Each member keeps the admin key, derived from the password the same way on every
        member (PBKDF2-SHA256, a salt from the app and the user), in FDF_APPS/<app>.json only; the network RAM carries
        the salt and a check value, never the key. The admin app writes the configuration it wants as
        (fdf-app, admin, <app>) {config, seq, mac}: every member that has the app and the key checks the mac, adopts a
        newer seq as its own configuration (this file) and says so, (fdf-app, applied, <app>.<guid>) {seq, ok, why}.
  fdf-app where APP RAM
        print host:port of the droplet serving APP's RAM now (its where cell, resolved to the member's .1), or nothing
  fdf-app serve
        on a member: for every app installed here (FDF_APPS/<app>.json), write its configuration tuple and say so as a
        capability tuple, and write both again after the network RAM changes (a held read ends); on every event
        (a held read on the fdf-app family, and fdf-events for who is alive) run each app RAM's selection over the alive
        members that have the app; serve the RAMs this member is chosen for (rina-host, a child of this process) and say
        so in this member's where cell; stop serving the ones it is not.

The selection is the app's, deterministic, over the capability tuples: every member computes the same answer from the
same tuples, so nothing is negotiated, claimed or held. The app's own ranking is the "select" of its newest configuration
(fdf_select.py, [APP_SELECTION_V1]); with none, the alive member with the most installed memory, then the most cores,
then the highest guid. A stronger member arriving takes the RAM;
the app's owners write their own truth again to it (APP-SETUP-AND-OPERATION.md, "Why it works this way").

Environment: RINA_RAM (the network RAM; else /opt/fdf/var/join.env), FDF_FACTS (this member's facts.json), FDF_APPS
(/opt/fdf/apps), FDF_VAR (/opt/fdf/var), FDF_BIN (/opt/fdf/bin), FDF_APP_LISTEN (the address the droplets listen on;
default this member's .1).
"""
import hashlib, hmac, json, os, queue, signal, subprocess, sys, threading, time, zlib

BUILD_TAG = "fdf-app-2026-11-03-r6"
LIB = os.environ.get("FDF_PY") or os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib", "python")
sys.path.insert(0, LIB)
import fdfram  # noqa: E402
import fdf_select  # noqa: E402  [APP_SELECTION_V1]

VAR = os.environ.get("FDF_VAR", "/opt/fdf/var")
APPS = os.environ.get("FDF_APPS", "/opt/fdf/apps")
BIN = os.environ.get("FDF_BIN", "/opt/fdf/bin")
FACTS = os.environ.get("FDF_FACTS", os.path.join(VAR, "facts.json"))
SVC = "fdf-app"                                   # the family in the network RAM: config/<app>, can/<app>.<guid>
# [CHILDREN_KNOW_THE_RAM_V1] fdf-events and fdf-where, which this runs, find the network RAM only in RINA_RAM; join.env
# is read here (fdfram.where) and handed to them. Found on Seattle7 2026-11-01: fdf-app.service sets no RINA_RAM, so its
# own reads found join.env and every fdf-events it started ended at once ("no RINA_RAM, no RINA_AREA").
try:
    os.environ["RINA_RAM"] = fdfram.where()
except fdfram.RamError:
    pass                                          # (config before join: the serve says so when it needs the RAM)


def log(m):
    print("[fdf-app] " + m, flush=True)


def ram():
    return fdfram.Ram(fdfram.where())


def facts():
    with open(FACTS) as f:
        return json.load(f)


def dot1(f):
    for r in f.get("addrs") or []:
        if r.get("kind") == "own" and str(r.get("ip", "")).endswith(".1"):
            return r["ip"]
    return ""


# ---------------------------------------------------------------- access [APP_ACCESS_V1]
def verifier(pw):
    """a password as the access definition keeps it: PBKDF2-SHA256, its own salt; never the password"""
    salt = os.urandom(16)
    return {"kdf": "pbkdf2-sha256", "n": 200000, "salt": salt.hex(),
            "hash": hashlib.pbkdf2_hmac("sha256", pw.encode(), salt, 200000).hex()}


# [CATEGORIES_V1] (John 2026-11-02) the EOC admin defines, tab by tab, the categories the event uses (Teams, Power, Water,
# Ambulance, Hospitals ...); within a category, groups that are "the equivalent of a Team, except for the thing they are
# servicing", with their leads. A group is a role; its category is the tab it is on. A role from a configuration made
# before categories is in Teams. The order of `categories` is the order of the tabs.
DEFAULT_CATEGORY = "Teams"
def category_ok(c):
    return isinstance(c, str) and 0 < len(c) <= 40 and all(ch.isalnum() or ch in " _-" for ch in c) and c.strip() == c


def categorize(roles_in, cats_in):
    """(roles {name: {default, category}}, categories [ordered]) from what was given: every role's category is one of
    the categories (a category a role names and the list lacks is added after the listed ones, in role order)"""
    cats = []
    for c in cats_in or []:
        if not category_ok(c):
            raise ValueError("category %r: letters, digits, space, _ and -, at most 40" % (c,))
        if c not in cats:
            cats.append(c)
    roles = {}
    for k, v in (roles_in or {}).items():
        if not (isinstance(k, str) and k and k != "general" and all(ch.isalnum() or ch in "_-" for ch in k)):
            continue
        cat = (v or {}).get("category") or DEFAULT_CATEGORY
        if not category_ok(cat):
            raise ValueError("role %s: category %r: letters, digits, space, _ and -, at most 40" % (k, cat))
        if cat not in cats:
            cats.append(cat)
        roles[k] = {"default": bool((v or {}).get("default")), "category": cat}
    return roles, cats


def admin_salt(app, user):
    """[ADMIN_APP_V1] the same on every member, so every member derives the same key from the same line"""
    return hashlib.sha256(("fdf-app-admin:%s:%s" % (app, user)).encode()).digest()[:16]


ADMIN_N = 200000


def admin_key(app, user, pw):
    return hashlib.pbkdf2_hmac("sha256", pw.encode(), admin_salt(app, user), ADMIN_N)


def admin_check(key):
    """what the admin app compares to know its password is this app's admin's: an HMAC of a fixed text"""
    return hmac.new(key, b"fdf-admin-check", hashlib.sha256).hexdigest()


def admin_public(c):
    """the admin definition as the network RAM may carry it: no key"""
    a = c.get("admin") or {}
    if not a.get("key"):
        return {}
    return {"user": a.get("user", ""), "salt": a.get("salt", ""), "n": a.get("n", ADMIN_N), "check": a.get("check", "")}


def where_key(app, r):
    return "%s.%s" % (app, r)


def port_of(app, r):
    """the port APP's RAM r is served on, the same on every member (no port to agree on)"""
    return 21000 + zlib.crc32(where_key(app, r).encode()) % 8000


# ---------------------------------------------------------------- the selection
def newest(app, cfgs, alive):
    """the newest configuration (highest seq, then highest guid) among the alive members' configuration tuples: what
    every member decides by, so a member that has not adopted the newest yet does not make the others choose differently"""
    best = None
    for g, b in (cfgs.get(app) or {}).items():
        if g in alive and (best is None or (int(b.get("seq") or 0), g) > best[0]):
            best = ((int(b.get("seq") or 0), g), b)
    return best[1] if best else {}


def places_of(c):
    """[GROUP_PLACE_V1] {group: {at, guid, seq, user}}: where each group's lead placed it, in a configuration"""
    return {r: p for r, p in (c.get("places") or {}).items() if isinstance(p, dict) and p.get("at") in ("here", "databasehost")}


def app_select(app, cfgs, alive):
    """[APP_SELECTION_V1] the app's selection: the "select" of the newest configuration"""
    try:
        return fdf_select.check(newest(app, cfgs, alive).get("select"))
    except ValueError as e:
        log("%s: the newest configuration's selection is not usable (%s): the default" % (app, e))
        return {}


def choose(app, rams, parts, cans, cfgs=None):
    """{ram: guid}: who serves each of APP's RAMs, from the alive members, the capability tuples and the app's selection."""
    alive = {(p.get("facts") or {}).get("guid") for p in parts if p.get("alive")}
    cands = [(g, b) for g, b in cans.get(app, {}).items() if g in alive]
    sel = app_select(app, cfgs or {}, alive)
    # [GROUP_PLACE_V1] a group its lead placed "here" is served by that device: the lead chose it, so the app's selection
    # (its needs and ranking) is not asked; nobody serves it while that device is gone or has not the app. "databasehost",
    # or no place: the app's selection.
    pl = places_of(newest(app, cfgs or {}, alive))
    here = {g for g, _ in cands}
    return {r: ((pl[r]["guid"] if pl[r]["guid"] in here else None) if pl.get(r, {}).get("at") == "here" else fdf_select.select(sel, r, cands))
            for r in rams}


# ---------------------------------------------------------------- reading the network RAM
def read_family(rm):
    """(configs {app: {guid: bag}}, cans {app: {guid: bag}}, last id)"""
    cfg, cans, last = {}, {}, -1
    for c in rm.read(SVC):
        last = max(last, int(c.get("id", -1)))
        v, i, b = c.get("variable"), c.get("instance", ""), c.get("bag") or {}
        if v == "config" and "." in i:
            a, g = i.split(".", 1)
            cfg.setdefault(a, {})[g] = b
        elif v == "can" and "." in i:
            a, g = i.split(".", 1)
            cans.setdefault(a, {})[g] = b
    return cfg, cans, last


def resolve(parts, guid):
    for p in parts:
        f = p.get("facts") or {}
        if p.get("alive") and f.get("guid") == guid:
            return dot1(f)
    return ""


def where(app, r, rm=None):
    rm = rm or ram()
    parts = rm.participants()
    k = where_key(app, r)
    for c in rm.read("pond", "where"):
        e = (c.get("bag") or {}).get(k)
        if isinstance(e, dict) and str(e.get("ram", "")).startswith("w:"):
            _, g, port = e["ram"].split(":")
            h = resolve(parts, g)
            if h:
                return "%s:%s" % (h, port)
    return ""


# ---------------------------------------------------------------- serving
class Server:
    def __init__(self):
        self.f = facts()
        self.me = self.f.get("guid")
        self.listen = os.environ.get("FDF_APP_LISTEN") or dot1(self.f)
        self.procs = {}                      # (app, r) -> Popen
        self.events = queue.Queue()
        self.rm = ram()
        self.said = set()                    # where keys this member has said
        self.answered = {}                   # [ADMIN_APP_V1] app -> the admin seq this member has answered
        self.chosen = {}                     # [APP_SELECTION_V1] (app, ram) -> the guid chosen last, to say why when it changes

    def installed(self):
        """{app: its configuration} for every app installed here"""
        out = {}
        try:
            for n in sorted(os.listdir(APPS)):
                if n.endswith(".json"):
                    with open(os.path.join(APPS, n)) as f:
                        out[n[:-5]] = json.load(f)
        except FileNotFoundError:
            pass
        return out

    def say_own(self):
        """the truth this droplet owns, into the network RAM it is on now: each installed app's configuration and the
        capability to serve it"""
        cap = self.f.get("capability") or {}
        for a, c in self.installed().items():
            self.rm.write(SVC, "config", "%s.%s" % (a, self.me),       # [APP_ACCESS_V1] the access definition, verifiers only
                          {"app": a, "rams": list(c.get("rams") or []), "partition": c.get("partition", ""), "guid": self.me,
                           "login": bool(c.get("login")), "roles": categorize(c.get("roles"), c.get("categories"))[0],
                           "categories": categorize(c.get("roles"), c.get("categories"))[1], "users": c.get("users") or {},
                           "admin": admin_public(c), "seq": int(c.get("seq") or 0), "member": self.f.get("name") or "", "addr": dot1(self.f),
                           "select": c.get("select") or {}, "places": places_of(c)})
            # [APP_SELECTION_V1] the capability tuple: every scalar this member's probe measured (what an app's selection
            # ranks on; a field the probe did not measure is absent, never 0), and the RAMs this install offers
            can = {k: v for k, v in cap.items() if isinstance(v, (int, float, str, bool))}
            can["guid"] = self.me
            if c.get("serve"):                         # only when the install named them; absent: every RAM of the app
                can["serve"] = list(c["serve"])
            self.rm.write(SVC, "can", "%s.%s" % (a, self.me), can)
            log("%s: configuration and capability tuples written (RAMs %s)" % (a, ",".join(c.get("rams") or []) or "none"))

    def adopt(self):
        """[ADMIN_APP_V1] the admin app's configuration, (fdf-app, admin, <app>): adopted when its mac is the admin key's
        and its seq is newer than this member's; this member's answer, (fdf-app, applied, <app>.<guid>), either way"""
        changed = False
        for a, c in self.installed().items():
            rows = self.rm.read(SVC, "admin", a)
            if not rows:
                continue
            b = rows[-1].get("bag") or {}
            seq = int(b.get("seq") or 0)
            if seq <= int(c.get("seq") or 0) or seq == self.answered.get(a):
                continue
            self.answered[a] = seq
            key = bytes.fromhex(((c.get("admin") or {}).get("key")) or "")
            text = str(b.get("config") or "")
            why = ""
            if not key:
                why = "no admin key on this member (fdf-app config %s ... --admin USER:PASSWORD)" % a
            elif not hmac.compare_digest(hmac.new(key, ("%s\n%d" % (text, seq)).encode(), hashlib.sha256).hexdigest(), str(b.get("mac") or "")):
                why = "the mac is not this app's admin key's: refused"
            else:
                try:
                    n = json.loads(text)
                    rams = [r for r in n.get("rams") or [] if isinstance(r, str) and r]
                    roles, cats = categorize(n.get("roles"), n.get("categories"))      # [CATEGORIES_V1]
                    users = {}
                    for u, v in (n.get("users") or {}).items():
                        ver = (v or {}).get("verifier") or {}
                        if (v or {}).get("role") not in roles or set(ver) < {"kdf", "n", "salt", "hash"} or ver.get("kdf") != "pbkdf2-sha256":
                            raise ValueError("user %s: a role this configuration has and a pbkdf2-sha256 verifier" % u)
                        users[u] = {"role": v["role"], "verifier": {k: ver[k] for k in ("kdf", "n", "salt", "hash")},
                                    "lead": bool(v.get("lead"))}       # [ENROLL_V1] this user leads its role's team
                    part = n.get("partition", "relocate")
                    if "general" not in rams or part not in ("relocate", "fail"):
                        raise ValueError("the RAMs must include general; partition relocate or fail")
                    sel = fdf_select.check(n["select"]) if "select" in n else (c.get("select") or {})   # [APP_SELECTION_V1]
                    new = dict(c, rams=rams, partition=part, login=bool(n.get("login")), roles=roles, categories=cats, users=users, seq=seq, select=sel)
                    p = os.path.join(APPS, a + ".json")
                    with open(p + ".tmp", "w") as f:
                        json.dump(new, f)
                    os.chmod(p + ".tmp", 0o600)
                    os.replace(p + ".tmp", p)
                    changed = True
                    log("%s: the admin's configuration %d adopted (RAMs %s; categories %s; roles %s; %d users)" % (a, seq, ",".join(rams), ",".join(cats), ",".join("%s@%s" % (r, x["category"]) for r, x in roles.items()), len(users)))
                except (ValueError, TypeError, AttributeError) as e:
                    why = "not adopted: %s" % e
            if why:
                log("%s: the admin's configuration %d %s" % (a, seq, why))
            self.rm.write(SVC, "applied", "%s.%s" % (a, self.me), {"seq": seq, "ok": not why, "why": why, "guid": self.me,
                                                                 "member": self.f.get("name") or "", "at": int(time.time())})
        return changed

    def adopt_places(self):
        """[GROUP_PLACE_V1] the leads' places, (fdf-app, place, <app>.<group>) as the door wrote them: the newest of each
        group, from a user this configuration has as that group's lead, adopted into this member's own configuration"""
        changed = False
        cells = {}
        for x in self.rm.read(SVC, "place"):
            cells[x.get("instance", "")] = x.get("bag") or {}
        for a, c in self.installed().items():
            have = places_of(c)
            new = dict(have)
            for r in c.get("rams") or []:
                b = cells.get("%s.%s" % (a, r))
                if not b or int(b.get("seq") or 0) <= int((have.get(r) or {}).get("seq") or 0):
                    continue
                u = (c.get("users") or {}).get(b.get("user", "")) or {}
                if not (u.get("lead") and u.get("role") == r and b.get("at") in ("here", "databasehost") and (b.get("at") != "here" or b.get("guid"))):
                    log("%s: the place of group %s by %r is not its lead's: not adopted" % (a, r, b.get("user")))
                    continue
                new[r] = {"at": b["at"], "guid": b.get("guid", "") if b["at"] == "here" else "", "seq": int(b["seq"]), "user": b["user"]}
                log("%s: group %s placed %s%s by its lead %s (adopted)" % (a, r, b["at"], " on " + new[r]["guid"] if new[r]["guid"] else "", b["user"]))
            if new != have:
                p = os.path.join(APPS, a + ".json")
                with open(p + ".tmp", "w") as f:
                    json.dump(dict(c, places=new), f)
                os.chmod(p + ".tmp", 0o600)
                os.replace(p + ".tmp", p)
                changed = True
        return changed

    def start(self, app, r):
        p = self.procs.get((app, r))
        if p is not None and p.poll() is None:
            return
        port = port_of(app, r)
        env = dict(os.environ, RINA_REGION_FILE=os.path.join(VAR, "app-%s-%s.perm" % (app, r)))
        env.pop("RINA_MAP_AREA", None)
        self.procs[(app, r)] = subprocess.Popen(
            [os.path.join(BIN, "rina-host"), "--listen", "%s:%d" % (self.listen, port), "--api", fdfram.API],
            env=env, stdout=subprocess.DEVNULL, stderr=open(os.path.join(VAR, "app-%s-%s.log" % (app, r)), "a"))
        log("serving %s's RAM %s on %s:%d (pid %d)" % (app, r, self.listen, port, self.procs[(app, r)].pid))

    def stop(self, app, r):
        p = self.procs.pop((app, r), None)
        if p is not None and p.poll() is None:
            p.terminate()
            try:
                p.wait(5)
            except subprocess.TimeoutExpired:
                p.kill()
            log("no longer serving %s's RAM %s" % (app, r))
        k = where_key(app, r)
        if k in self.said:
            self._where([k, "--clear"])
            self.said.discard(k)

    def _where(self, args):
        r = subprocess.run([os.path.join(BIN, "fdf-where")] + args, env=dict(os.environ, FDF_FACTS=FACTS),
                           capture_output=True, text=True, timeout=10)
        if r.returncode != 0:
            log("fdf-where %s failed: %s" % (" ".join(args), (r.stderr or r.stdout).strip()[:200]))
        return r.returncode == 0

    def mine_in_where(self):
        for c in self.rm.read("pond", "where", "w:" + self.me):
            return set(k for k in (c.get("bag") or {}) if k != "from")
        return set()

    def decide(self, why):
        t0 = time.monotonic()
        try:
            if why.startswith("again"):
                self.say_own()
            if self.adopt():                         # [ADMIN_APP_V1] a newer configuration from the admin: this member's own now
                self.say_own()
            if self.adopt_places():                  # [GROUP_PLACE_V1] a lead's newer place for its group
                self.say_own()
            parts = self.rm.participants()
            cfgs, cans, _ = read_family(self.rm)
        except fdfram.RamError as e:
            log("the network RAM did not answer (%s); the next event decides again" % e)
            if why.startswith("again"):
                self.events.put(why)
            return
        want, placed = set(), {}
        for app, c in self.installed().items():
            for r, g in choose(app, list(c.get("rams") or []), parts, cans, cfgs).items():
                if self.chosen.get((app, r), "-") != g:          # [APP_SELECTION_V1] why, when the choice changes
                    alive = {(p.get("facts") or {}).get("guid") for p in parts if p.get("alive")}
                    sel = app_select(app, cfgs, alive)
                    log("%s: %s's RAM %s -> %s; the selection %s ranks: %s" % (why, app, r, g or "nobody",
                        json.dumps(fdf_select.spec(sel, r), sort_keys=True), fdf_select.explain(sel, r, [(x, b) for x, b in cans.get(app, {}).items() if x in alive]) or "no candidate"))
                    self.chosen[(app, r)] = g
                if g == self.me:
                    want.add((app, r))
                h = resolve(parts, g) if g else ""
                if h:
                    placed[where_key(app, r)] = "%s:%d" % (h, port_of(app, r))
        self.write_map(placed, why)
        for k in list(self.procs):
            if k not in want:
                self.stop(*k)
        listed = self.mine_in_where()
        for app, r in sorted(want):
            self.start(app, r)
            k = where_key(app, r)
            if k not in listed:
                if self._where([k, "ram=self:%d" % port_of(app, r)]):
                    self.said.add(k)
                    log("%s: %s's RAM %s is here (where cell written) %d ms after the event"
                        % (why, app, r, int((time.monotonic() - t0) * 1000)))

    def write_map(self, placed, why):
        """[APP_WHERE_MAP_V1] this member's answer to "where is each of my apps' RAMs", FDF_VAR/app-where.json, for the
        doors on this node (ram.php) to read at no cost. The same answer every member computes; written when it changes."""
        p = os.path.join(VAR, "app-where.json")
        try:
            with open(p) as f:
                if json.load(f) == placed:
                    return
        except (OSError, ValueError):
            pass
        tmp = p + ".tmp"
        with open(tmp, "w") as f:
            json.dump(placed, f, sort_keys=True)
        os.replace(tmp, p)
        log("%s: the apps' RAMs: %s" % (why, ", ".join("%s at %s" % kv for kv in sorted(placed.items())) or "none served"))

    def watch_family(self):
        last = -1
        while True:
            try:
                cs = self.rm.read(SVC, after=last, wait_s=25)
                if cs:
                    last = max(int(c.get("id", -1)) for c in cs)
                    self.events.put("tuples")
            except fdfram.RamError as e:
                # [APP_REASSERT_V1] the network RAM may be another one now: write this droplet's own truth again there,
                # then learn the world again (read the family from the start)
                log("held read on %s ended (%s); again in 1 s, writing this droplet's own truth again" % (SVC, e))
                time.sleep(1)
                last = -1
                self.events.put("again: the held read ended")

    def watch_members(self):
        while True:
            p = subprocess.Popen([os.path.join(BIN, "fdf-events")], stdout=subprocess.PIPE, text=True,
                                 env=dict(os.environ, FDF_FACTS=FACTS))
            for line in p.stdout:
                self.events.put("member: " + line.strip()[:80])
            p.wait()
            log("fdf-events ended (rc %s); again in 1 s" % p.returncode)
            self.events.put("events ended")
            time.sleep(1)

    def run(self):
        log("build %s; member %s; droplets listen on %s; apps here: %s"
            % (BUILD_TAG, self.me, self.listen, ", ".join(self.installed()) or "none"))
        threading.Thread(target=self.watch_family, daemon=True).start()
        threading.Thread(target=self.watch_members, daemon=True).start()
        self.decide("again: start")
        while True:
            why = self.events.get()
            while not self.events.empty():           # a burst is one decision, on the newest state
                w = self.events.get()
                why = w if w.startswith("again") or not why.startswith("again") else why   # a reassert is never lost
            self.decide(why)

    def shutdown(self, *_):
        for k in list(self.procs):
            self.stop(*k)
        sys.exit(0)


def main(argv):
    if len(argv) >= 3 and argv[1] == "config":
        rams = [r for r in argv[3].split(",") if r] if len(argv) > 3 else []
        opt = lambda k: [argv[i + 1] for i, a in enumerate(argv[:-1]) if a == k]
        part = (opt("--partition") or ["relocate"])[0]
        if not rams or part not in ("relocate", "fail"):
            print(__doc__); return 2
        os.makedirs(APPS, exist_ok=True)
        p = os.path.join(APPS, argv[2] + ".json")
        try:
            with open(p) as f:
                old = json.load(f)
        except (OSError, ValueError):
            old = {}
        ok_name = lambda x: bool(x) and x != "general" and all(ch.isalnum() or ch in "_-" for ch in x)
        roles, users = {}, {}
        for t in opt("--role"):                       # NAME[:default][@CATEGORY]   [CATEGORIES_V1]
            t, _, cat = t.partition("@")
            name, _, flag = t.partition(":")
            if not ok_name(name) or flag not in ("", "default") or (cat and not category_ok(cat)):
                print("fdf-app: --role NAME[:default][@CATEGORY], NAME letters, digits, _ and - (not 'general'); CATEGORY letters, digits, space, _ and -"); return 2
            roles[name] = {"default": flag == "default", "category": cat or DEFAULT_CATEGORY}
        try:
            roles, cats = categorize(roles, opt("--category"))
        except ValueError as e:
            print("fdf-app: %s" % e); return 2
        for u in opt("--user"):                       # USER:PASSWORD=ROLE[+lead]
            who, _, rest = u.partition(":")
            pw, _, role = rest.rpartition("=")
            lead = role.endswith("+lead"); role = role[:-5] if lead else role
            if not who or not pw or role not in roles:
                print("fdf-app: --user USER:PASSWORD=ROLE[+lead], ROLE one of the --role names"); return 2
            users[who] = {"role": role, "verifier": verifier(pw), "lead": lead}   # [ENROLL_V1]
        sel = {}                                      # [APP_SELECTION_V1] --select RAM=KEY,-KEY  --need RAM=KEY,KEY  (RAM * for all)
        for flag, part_ in (("--select", "rank"), ("--need", "need")):
            for t in opt(flag):
                r, _, keys = t.partition("=")
                sel.setdefault(r, {"need": [], "rank": []})[part_] = [k for k in keys.split(",") if k]
        try:
            sel = fdf_select.check(sel)
        except ValueError as e:
            print("fdf-app: %s (--select RAM=KEY[,-KEY]..., --need RAM=KEY[,KEY]..., RAM one of the app's or *)" % e); return 2
        if any(r != "*" and r not in rams for r in sel):
            print("fdf-app: --select/--need name a RAM the app does not have: %s" % ",".join(r for r in sel if r != "*" and r not in rams)); return 2
        serve = [r for t in opt("--serve") for r in t.split(",") if r]
        if any(r not in rams for r in serve):
            print("fdf-app: --serve names a RAM the app does not have"); return 2
        admin = old.get("admin") or {}
        for u in opt("--admin")[-1:]:                 # [ADMIN_APP_V1] USER:PASSWORD
            who, _, pw = u.partition(":")
            if not who or not pw:
                print("fdf-app: --admin USER:PASSWORD"); return 2
            k = admin_key(argv[2], who, pw)
            admin = {"user": who, "salt": admin_salt(argv[2], who).hex(), "n": ADMIN_N, "key": k.hex(), "check": admin_check(k)}
        # seq: this line is newer than any configuration the admin app wrote before it (that one is not adopted again)
        with open(p + ".tmp", "w") as f:
            json.dump({"app": argv[2], "rams": rams, "partition": part, "login": "--login" in argv, "roles": roles, "categories": cats, "users": users,
                       "admin": admin, "seq": int(time.time() * 1000), "select": sel, **({"serve": serve} if serve else {})}, f)   # no --serve: every RAM, those the admin adds too
        os.chmod(p + ".tmp", 0o600)
        os.replace(p + ".tmp", p)
        print("fdf-app: %s installed here with RAMs %s (%s), roles %s%s%s; serve writes it into the network RAM" % (argv[2], ",".join(rams), part, ",".join(roles) or "none",
                                                                  ", login required" if "--login" in argv else "",
                                                                  ", admin " + admin["user"] if admin.get("user") else ", no admin (the admin app cannot change it)")); return 0
    if len(argv) == 4 and argv[1] == "where":
        print(where(argv[2], argv[3])); return 0
    if len(argv) == 2 and argv[1] == "serve":
        s = Server()
        signal.signal(signal.SIGTERM, s.shutdown)
        signal.signal(signal.SIGINT, s.shutdown)
        s.run(); return 0
    print(__doc__); return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
