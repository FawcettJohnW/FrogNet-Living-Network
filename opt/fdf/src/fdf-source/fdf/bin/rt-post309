"""rt-post309 -- [POST_309_V1] the post's ICS-309 files: RangerTrak's Post participant (PLAN.md, "The participants").

On the node at a post: held reads on the radio log, (rt-log, <mission>.<op>, <dev>.<seq>), in the app's general RAM
(where FDF_VAR/app-where.json says it is served now), and every entry appended to FDF_VAR/rt/309/<mission>.<op>.csv in
the order this post read them, each entry once by its id. The file is the post's durable record; the RAM keeps the
cells only while it is up.

Once each: the ids already in a file are read back at start, so a restart, a lost and resumed read, or a RAM change
(everything read again there) leaves no duplicate. In order: a resumed read starts after the last row id it saw on
that RAM; a new RAM is read from the start and only what the file lacks is appended, in that RAM's order.

  rt-post309            run, on a post's node (its unit comes with the app's install: not yet; PLAN.md)
Environment: FDF_VAR (/opt/fdf/var), FDF_PY (the fdfram module's directory).
"""
import csv, json, os, sys, time

BUILD_TAG = "rt-post309-2026-11-01-r1"
LIB = os.environ.get("FDF_PY") or os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib", "python")
sys.path.insert(0, LIB)
import fdfram  # noqa: E402

VAR = os.environ.get("FDF_VAR", "/opt/fdf/var")
OUT = os.path.join(VAR, "rt", "309")
WHERE = os.path.join(VAR, "app-where.json")
KEY = "rangertrak.general"
COLS = ["msg_no", "date", "callsign", "status", "location", "notes", "by", "id"]


def log(m):
    print("[rt-post309] " + m, flush=True)


def where():
    try:
        with open(WHERE) as f:
            return json.load(f).get(KEY, "")
    except (OSError, ValueError):
        return ""


def msg_no(n):
    if not isinstance(n, dict):
        return ""
    st = str(n.get("station", ""))
    return st + ("-" if len(st) > 1 else "") + "%03d" % int(n.get("seq") or 0)


def location(l):
    if not isinstance(l, dict):
        return ""
    if l.get("lat") is not None:
        return "%.5f, %.5f" % (l["lat"], l["lng"])
    return str(l.get("text", ""))


class Files:
    def __init__(self):
        os.makedirs(OUT, exist_ok=True)
        self.have = {}                                  # variable -> set of entry ids in its file

    def ids(self, v):
        if v not in self.have:
            s = set()
            try:
                with open(os.path.join(OUT, v + ".csv"), newline="") as f:
                    for row in csv.DictReader(f):
                        s.add(row["id"])
            except FileNotFoundError:
                pass
            self.have[v] = s
        return self.have[v]

    def add(self, cells):
        n = 0
        for c in sorted(cells, key=lambda c: int(c.get("id", 0))):
            v, i, b = c.get("variable", ""), c.get("instance", ""), c.get("bag") or {}
            if not v or not i or "/" in v or v.startswith(".") or i in self.ids(v):
                continue
            p = os.path.join(OUT, v + ".csv")
            new = not os.path.exists(p)
            with open(p, "a", newline="") as f:
                w = csv.writer(f)
                if new:
                    w.writerow(COLS)
                w.writerow([msg_no(b.get("msgNo")), b.get("date", ""), b.get("callsign", ""), b.get("status", ""),
                            location(b.get("location")), b.get("notes", ""), b.get("by", ""), i])
                f.flush(); os.fsync(f.fileno())
            self.have[v].add(i); n += 1
        return n


def main():
    files = Files()
    log("build %s; files in %s" % (BUILD_TAG, OUT))
    at, last = "", -1
    while True:
        now = where()
        if not now:
            log("the app's general RAM is not served yet (%s); again in 1 s" % WHERE)
            time.sleep(1); continue
        try:
            rm = fdfram.Ram(now)
            if now != at:                               # another RAM: read everything there
                cells = rm.read("rt-log")
                n = files.add(cells)
                at, last = now, max([int(c.get("id", -1)) for c in cells] + [-1])
                log("on %s: %d entries there, %d appended" % (at, len(cells), n))
            cells = rm.read("rt-log", after=last, wait_s=8)   # 8 s: the longest it stays on a RAM this node has left
            if cells:
                last = max([last] + [int(c.get("id", -1)) for c in cells])
                files.add(cells)
        except fdfram.RamError as e:
            log("the read on %s ended (%s); where it is now is read again in 1 s" % (at or now, e))
            at = ""
            time.sleep(1)


if __name__ == "__main__":
    sys.exit(main())
