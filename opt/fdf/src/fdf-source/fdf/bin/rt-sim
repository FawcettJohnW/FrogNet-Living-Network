HOSPITALS = {"Harborview": ("seattle", 47.6040, -122.3238), "Swedish First Hill": ("seattle", 47.6089, -122.3215),
             "Virginia Mason": ("seattle", 47.6102, -122.3271), "UW Medical Center": ("seattle", 47.6497, -122.3071),
