def help_bag(v, status):
    """(help, request, sim-<id>): the shape DisasterComm's help page writes, for a simulated person"""
    return {"name": v["name"], "people": 1, "needs": NEED_OF.get(v.get("status"), ["other"]) if status == "open" else [],
            "status": status, "location": {"text": "", "lat": round(v["p"][0], 6), "lon": round(v["p"][1], 6)},
            "contact": "", "note": v.get("status", "") if status == "open" else "", "by": "rt-sim", "at": int(time.time()), "sim": True}


def where():
    """{"openeoc.<ram>": host:port} for the AppRams that have an AppHost now"""
    out = {}
    for r in fdf_appram.rams_of("openeoc"):
        w = fdf_appram.where("openeoc", r)
        if w:
            out["openeoc." + r] = w
    return out


class Writers:
    """one session per instance, on the general RAM where it is served now"""
    def __init__(self, mission):
        self.mission, self.s, self.at = mission, {}, ""

    def open(self, hp, w):
        self.close_all()
        h, p = hp.rsplit(":", 1)
        for k in w.u:
            self.add(h, p, w, k)
        self.at = hp

    def add(self, h, p, w, k):
        s = fnw1.Session(h, p); self.s[k] = s
        who, pos = w.bags(k)
        s.write("rt-who", self.mission, k, who, own=True); s.write("rt-pos", self.mission, k, pos, own=True)
        v = w.u[k]
        if v["kind"] == "victim" and v["status"] != "in ambulance":   # [RT_HELP_V1] a victim asks for help, as a person would
            s.write("help", "request", "sim-" + k, help_bag(v, "open" if v["status"] != "sheltering" else "safe"))

    def pos(self, w, k):
        if k not in self.s:
            h, p = self.at.rsplit(":", 1); self.add(h, p, w, k); return
        self.s[k].write("rt-pos", self.mission, k, w.bags(k)[1], own=True)

    def resolved(self, w, k, v):
        """a delivered victim's request is resolved (its own record, written once more), then it leaves"""
        s = self.s.get(k)
        if s:
            s.write("help", "request", "sim-" + k, help_bag(v, "resolved"))

    def leave(self, k):
        s = self.s.pop(k, None)
        if s:
            s.close()

    def close_all(self):
        for k in list(self.s):
            self.leave(k)
        self.at = ""


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mission", default="seattle-metro")
    ap.add_argument("--tick", type=float, default=2.0)
    ap.add_argument("--seed", type=int, default=20261101)
    a = ap.parse_args()
    w = World(random.Random(a.seed))
    kinds = {}
    for v in w.u.values():
        kinds[v["kind"]] = kinds.get(v["kind"], 0) + 1
    log("build %s; mission %s; %d instances (%s); tick %.1f s; each on its own session" % (BUILD_TAG, a.mission, len(w.u),
        ", ".join("%d %s" % (n, k) for k, n in sorted(kinds.items())), a.tick))
    wr = Writers(a.mission)
    last = time.monotonic()
    while True:
        m = where(); now = m.get(KEY, "")
        if not now:
            log("the app's general RAM is not served yet (%s); again in 1 s" % WHERE)
            time.sleep(1); continue
        try:
            if now != wr.at:                    # another RAM: every instance's own truth again, there
                wr.open(now, w)
                h, p = now.rsplit(":", 1); ms = fnw1.Session(h, p)
                ms.write("rt-mission", "settings", a.mission, {"name": "Seattle metro exercise", "event": "Seattle metro exercise",
                                                               "opPeriod": 1, "by": "rt-sim", "sim": True}, wait=True)
                for name, lat, lng in SAFE_PEOPLE:                  # people who said they are safe (Find someone)
                    ms.write("help", "request", "sim-safe-" + name.replace(" ", "-").lower(),
                             help_bag({"name": name, "p": (lat, lng)}, "safe"), wait=True)
                for i, (what, typ, team, lat, lng, extra) in enumerate(FIELD):   # [RT_FIELD_V1] what the teams have done so far
                    bag = {"what": what, "type": typ, "team": team, "name": "Team " + team, "by": "rt-sim", "lat": lat, "lng": lng,
                           "note": "", "at": int(time.time()), "sim": True}
                    bag.update(extra)
                    ms.write("rt-field", a.mission, "sim-field-%d" % i, bag, wait=True)
                for k, v in w.u.items():                              # [RT_FACILITY_V1] every hospital's desk
                    if v["kind"] == "hospital":
                        ms.write("rt-facility", a.mission, facility_id(v["name"]), facility_bag(v, w.rng), wait=True)
                log("on %s: %d instances, each on its own session; %d safe check-ins; %d field items; %d hospital statuses" % (
                    now, len(w.u), len(SAFE_PEOPLE), len(FIELD), sum(1 for v in w.u.values() if v["kind"] == "hospital")))
                ms.close()
            time.sleep(max(0.0, a.tick - (time.monotonic() - last)))
            dt = time.monotonic() - last; last = time.monotonic()
            changed = w.tick(dt)
            for k in w.removed:
                if k in w.gone:
                    wr.resolved(w, k, w.gone.pop(k))
                wr.leave(k)
            for k in changed:
                if k in w.u:
                    wr.pos(w, k)
            stamp = int(time.time() * 1000)
            for k, text in w.say:
                if k in wr.s:
                    wr.s[k].write("rt-msg", a.mission, "%s.%d" % (k, stamp), {"from": k, "name": w.u[k]["name"], "text": text, "at": stamp // 1000})
            for k, team, text in w.chatter:
                tr = m.get("openeoc." + team.lower(), "")
                if tr and k in w.u:
                    h, p = tr.rsplit(":", 1); ts = fnw1.Session(h, p)
                    ts.write("rt-team", a.mission, "%s.%d" % (k, stamp), {"from": k, "name": w.u[k]["name"], "team": team, "text": text, "at": stamp // 1000}, wait=True)
                    ts.close()
            for k, tid, bag in w.trs:                                 # [RT_TRANSPORT_V1] the unit's record, on its own session
                if k in wr.s:
                    bag.update(by=k, name=w.u[k]["name"], at=stamp // 1000, sim=True)
                    wr.s[k].write("rt-transport", a.mission, tid, bag)
            for hk, tid in w.arrived:                                 # the hospital's desk: arrived
                if hk in wr.s:
                    wr.s[hk].write("rt-transport", a.mission + ".act", "%s~%s" % (tid, hk),
                                   {"action": "arrived", "unit": w.u[hk]["name"], "note": "", "at": stamp // 1000, "sim": True})
            for hk in w.fac:
                if hk in wr.s:
                    wr.s[hk].write("rt-facility", a.mission, facility_id(w.u[hk]["name"]), facility_bag(w.u[hk], w.rng))
            w.say, w.removed, w.chatter, w.trs, w.arrived, w.fac = [], set(), [], [], [], set()
        except (fnw1.Gone, fnw1.Refused, OSError) as e:
            log("writing on %s failed (%s); where it is now is read again in 1 s" % (wr.at or now, e))
            wr.close_all()
            time.sleep(1)


if __name__ == "__main__":
    sys.exit(main())
