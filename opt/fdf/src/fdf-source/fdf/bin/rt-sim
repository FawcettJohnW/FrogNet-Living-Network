TEAMS = [("Alpha", "#d62728", "seattle"), ("Bravo", "#1f77b4", "west"), ("Charlie", "#2ca02c", "south"),
         ("Delta", "#ff7f0e", "vashon")]
SIM_HOSTS = {"Sim-Downtown": (47.6050, -122.3300), "Sim-Ballard": (47.6680, -122.3850), "Sim-Northgate": (47.7060, -122.3260),
             "Sim-WestSeattle": (47.5620, -122.3860), "Sim-Rainier": (47.5400, -122.2800), "Sim-Burien": (47.4700, -122.3470),
             "Sim-Renton": (47.4800, -122.2170), "Sim-Bellevue": (47.6100, -122.2000), "Sim-Kirkland": (47.6770, -122.2060),
             "Sim-Vashon": (47.4470, -122.4600), "Sim-Maury": (47.3700, -122.4300), "Sim-Harbor": (47.6000, -122.3550)}
PEOPLE = ["Maria Lopez", "James Chen", "Aisha Patel", "Tom Nguyen",            # team members, by name, as people are
          "Grace Kim", "Luis Ortega", "Hannah Berg", "Sam Okafor",
          "Priya Raman", "Ben Carter", "Elena Petrova", "Marcus Hill",
          "Ruth Anderson", "Kenji Sato", "Fatima Hassan", "Dave Wilson"]
TEAM_TALK = ["On scene, assessing", "Need more water at this location", "Clear here, moving to next block",
             "Road blocked, rerouting", "Two people need help getting to the shelter", "All accounted for here",
             "Checking in, all OK", "Gas smell reported, keeping clear"]
WALK, DRIVE, BOAT, SHUFFLE = 1.4, 14.0, 9.0, 0.4      # m/s; the clock runs at real time


def log(m):
    print("[rt-sim] " + m, flush=True)


def metres(a, b):
    dy = (b[0] - a[0]) * 111320.0
    dx = (b[1] - a[1]) * 111320.0 * math.cos(math.radians((a[0] + b[0]) / 2))
    return math.hypot(dx, dy)


def step_toward(p, goal, m):
    d = metres(p, goal)
    if d <= m or d == 0:
        return goal, True
    f = m / d
    return (p[0] + (goal[0] - p[0]) * f, p[1] + (goal[1] - p[1]) * f), False


def jitter(p, rng, r=300.0):
    a, d = rng.uniform(0, 2 * math.pi), rng.uniform(0, r)
    return (p[0] + d * math.cos(a) / 111320.0, p[1] + d * math.sin(a) / (111320.0 * math.cos(math.radians(p[0]))))


class World:
    def __init__(self, rng):
        self.rng, self.u, self.n = rng, {}, 0
        self.say, self.removed, self.chatter = [], set(), []       # what instances said; who left; team talk
        for name, (lat, lng) in SIM_HOSTS.items():               # the nodes things connect through (simulated)
            self.add("host", name, (lat, lng), zone="")
        for name, (zone, lat, lng) in HOSPITALS.items():
            self.add("hospital", name, (lat, lng), zone=zone, beds=rng.randint(4, 30))
        for team, color, zone in TEAMS:
            for i in range(1, 5):
                self.add("team", PEOPLE[(TEAMS.index((team, color, zone)) * 4 + i - 1) % len(PEOPLE)], jitter(self.place(zone), rng), zone=zone, team=team, color=color,
                         goal=None)
        for i, zone in enumerate(["seattle", "seattle", "seattle", "west", "south", "south", "east", "vashon"], 1):
            self.add("ambulance", "Medic %d" % i, jitter(self.place(zone), rng), zone=zone, status="available",
                     goal=None, victim=None)
        for i, w in enumerate(["Elliott Bay", "Colvos Passage", "Lake Washington Mid"], 1):
            self.add("boat", ("Fireboat %d" if i < 3 else "Marine %d") % i, WATER[w], zone="water", status="patrol",
                     at_point=w, goal=None)
        for i in range(18):
            self.new_victim()
        for i, zone in enumerate(["seattle", "south", "east", "vashon", "west"], 1):
            self.add("fire", "Fire %d" % i, jitter(self.place(zone), rng, 600), zone=zone, severity=rng.choice(["1-alarm", "2-alarm", "3-alarm"]))
        for i, zone in enumerate(["seattle", "seattle", "west", "south", "east", "vashon"], 1):
            self.add("power", "Outage %d" % i, jitter(self.place(zone), rng, 800), zone=zone, customers_out=rng.randint(200, 9000))

    def place(self, zone):
        return self.rng.choice(list(ZONES[zone].values()))

    def add(self, kind, name, p, **kv):
        self.n += 1
        uid = "sim-%s-%d" % (kind, self.n)
        self.u[uid] = dict(kind=kind, name=name, p=p, **kv)
        return uid

    def new_victim(self):
        zone = self.rng.choice(["seattle", "seattle", "west", "south", "east", "vashon"])
        self.add("victim", "Victim %d" % (self.n + 1), jitter(self.place(zone), self.rng, 900), zone=zone,
                 status=self.rng.choice(["needs transport", "needs transport", "sheltering", "minor injuries"]))

    def nearest(self, kind, p, zone, pred=lambda v: True):
        c = [(metres(p, v["p"]), k) for k, v in self.u.items() if v["kind"] == kind and (zone is None or v["zone"] == zone) and pred(v)]
        return min(c)[1] if c else None

    def tick(self, dt):
        """advance everyone dt seconds; returns the ids whose truth changed"""
        rng, moved = self.rng, set()
        for k, v in list(self.u.items()):
            kind = v["kind"]
            if kind == "team" or kind == "victim":
                if kind == "victim" and v["status"] in ("in ambulance",):
                    continue
                if not v.get("goal") or v["p"] == v["goal"]:
                    v["goal"] = jitter(self.place(v["zone"]), rng, 400) if kind == "team" else jitter(v["p"], rng, 150)
                v["p"], _ = step_toward(v["p"], v["goal"], (WALK if kind == "team" else SHUFFLE) * dt)
                moved.add(k)
                if kind == "team" and rng.random() < dt / 240.0:          # about every 4 minutes per member
                    self.chatter.append((k, v["team"], rng.choice(TEAM_TALK)))
            elif kind == "ambulance":
                self.drive(k, v, dt, moved)
            elif kind == "boat":
                if not v.get("goal"):
                    nxt = [b if a == v["at_point"] else a for a, b in WATER_LINKS if v["at_point"] in (a, b)]
                    v["next_point"] = rng.choice(nxt)
                    v["goal"] = WATER[v["next_point"]]
                v["p"], there = step_toward(v["p"], v["goal"], BOAT * dt)
                if there:
                    v["at_point"], v["goal"] = v["next_point"], None
                moved.add(k)
        return moved

    def drive(self, k, v, dt, moved):
        if v["status"] == "available":
            vic = self.nearest("victim", v["p"], v["zone"], lambda x: x["status"] == "needs transport" and not x.get("taken"))
            if not vic:
                return
            self.u[vic]["taken"] = k
            v.update(status="responding", victim=vic, goal=self.u[vic]["p"])
            self.say.append((k, "%s responding to %s" % (v["name"], self.u[vic]["name"])))
        if v["status"] == "responding":
            vic = self.u.get(v["victim"])
            if not vic:
                v.update(status="available", victim=None, goal=None); moved.add(k); return
            v["goal"] = vic["p"]
            v["p"], there = step_toward(v["p"], v["goal"], DRIVE * dt)
            if there:
                vic["status"] = "in ambulance"; moved.add(v["victim"])
                h = self.nearest("hospital", v["p"], None)     # the nearest hospital anywhere (West Seattle has none)
                v.update(status="transporting", hospital=h, goal=self.u[h]["p"])
                self.say.append((k, "%s transporting %s to %s" % (v["name"], vic["name"], self.u[h]["name"])))
            moved.add(k)
        elif v["status"] == "transporting":
            vic = self.u.get(v["victim"])
            v["p"], there = step_toward(v["p"], v["goal"], DRIVE * dt)
            if vic:
                vic["p"] = v["p"]; moved.add(v["victim"])
            if there:
                hosp = self.u[v["hospital"]]
                hosp["beds"] = max(0, hosp["beds"] - 1); moved.add(v["hospital"])
                if vic:
                    self.say.append((k, "%s delivered %s to %s" % (v["name"], vic["name"], hosp["name"])))
                    del self.u[v["victim"]]; self.removed.add(v["victim"])
                v.update(status="available", victim=None, goal=None)
                self.new_victim()
                moved.add(sorted(self.u, key=lambda x: int(x.rsplit("-", 1)[1]))[-1])
            moved.add(k)

    def bags(self, k):
        v = self.u[k]
        team = v.get("team", "")
        who = {"name": v["name"], "kind": v["kind"], "team": team, "color": v.get("color", ""), "host": "", "station": ""}
        pos = {"name": v["name"], "kind": v["kind"], "team": team, "color": v.get("color", ""),
               "lat": round(v["p"][0], 6), "lng": round(v["p"][1], 6), "at": int(time.time()), "sim": True}
        if v["kind"] != "host":                                    # which node it is connected through: the nearest
            hs = [(metres(v["p"], h["p"]), hk) for hk, h in self.u.items() if h["kind"] == "host"]
            if hs:
                pos["via"] = min(hs)[1]; who["via"] = pos["via"]
        for f in ("status", "beds", "severity", "customers_out"):
            if f in v:
                pos[f] = v[f]
        if v.get("hospital"):
            pos["to"] = self.u[v["hospital"]]["name"]
        return who, pos


def where():
    try:
        with open(WHERE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


class Writers:
    """one session per instance, on the general RAM where it is served now"""
    def __init__(self, mission):
        self.mission, self.s, self.at = mission, {}, ""

    def open(self, hp, w):
        self.close_all()
        h, p = hp.rsplit(":", 1)
        for k in w.u:
            self.add(h, p, w, k)
        self.at = hp

    def add(self, h, p, w, k):
        s = fnw1.Session(h, p); self.s[k] = s
        who, pos = w.bags(k)
        s.write("rt-who", self.mission, k, who, own=True); s.write("rt-pos", self.mission, k, pos, own=True)

    def pos(self, w, k):
        if k not in self.s:
            h, p = self.at.rsplit(":", 1); self.add(h, p, w, k); return
        self.s[k].write("rt-pos", self.mission, k, w.bags(k)[1], own=True)

    def leave(self, k):
        s = self.s.pop(k, None)
        if s:
            s.close()

    def close_all(self):
        for k in list(self.s):
            self.leave(k)
        self.at = ""


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mission", default="seattle-metro")
    ap.add_argument("--tick", type=float, default=2.0)
    ap.add_argument("--seed", type=int, default=20261101)
    a = ap.parse_args()
    w = World(random.Random(a.seed))
    kinds = {}
    for v in w.u.values():
        kinds[v["kind"]] = kinds.get(v["kind"], 0) + 1
    log("build %s; mission %s; %d instances (%s); tick %.1f s; each on its own session" % (BUILD_TAG, a.mission, len(w.u),
        ", ".join("%d %s" % (n, k) for k, n in sorted(kinds.items())), a.tick))
    wr = Writers(a.mission)
    last = time.monotonic()
    while True:
        m = where(); now = m.get(KEY, "")
        if not now:
            log("the app's general RAM is not served yet (%s); again in 1 s" % WHERE)
            time.sleep(1); continue
        try:
            if now != wr.at:                    # another RAM: every instance's own truth again, there
                wr.open(now, w)
                h, p = now.rsplit(":", 1); ms = fnw1.Session(h, p)
                ms.write("rt-mission", "settings", a.mission, {"name": "Seattle metro exercise", "event": "Seattle metro exercise",
                                                               "opPeriod": 1, "by": "rt-sim", "sim": True}, wait=True); ms.close()
                log("on %s: %d instances, each on its own session" % (now, len(w.u)))
            time.sleep(max(0.0, a.tick - (time.monotonic() - last)))
            dt = time.monotonic() - last; last = time.monotonic()
            changed = w.tick(dt)
            for k in w.removed:
                wr.leave(k)
            for k in changed:
                if k in w.u:
                    wr.pos(w, k)
            stamp = int(time.time() * 1000)
            for k, text in w.say:
                if k in wr.s:
                    wr.s[k].write("rt-msg", a.mission, "%s.%d" % (k, stamp), {"from": k, "name": w.u[k]["name"], "text": text, "at": stamp // 1000})
            for k, team, text in w.chatter:
                tr = m.get("rangertrak." + team.lower(), "")
                if tr and k in w.u:
                    h, p = tr.rsplit(":", 1); ts = fnw1.Session(h, p)
                    ts.write("rt-team", a.mission, "%s.%d" % (k, stamp), {"from": k, "name": w.u[k]["name"], "team": team, "text": text, "at": stamp // 1000}, wait=True)
                    ts.close()
            w.say, w.removed, w.chatter = [], set(), []
        except (fnw1.Gone, fnw1.Refused, OSError) as e:
            log("writing on %s failed (%s); where it is now is read again in 1 s" % (wr.at or now, e))
            wr.close_all()
            time.sleep(1)


if __name__ == "__main__":
    sys.exit(main())
