    "vashon": {"Vashon": (47.4473, -122.4598), "Dockton": (47.3760, -122.4570), "Burton": (47.3920, -122.4630),
               "Cove": (47.4220, -122.4950), "North End": (47.5050, -122.4630), "Maury Island": (47.3700, -122.4300),
