#!/bin/bash
# fdf-leave -- [FDF_JOIN_V1][NO_BROKER_V1] undo fdf-join / fdf-region-join and return this node to LAN-only FrogNet:
#   stop and remove every unit they made: fdf-client.service, fdf-facts.service, fdf-term-serve.service (it needs the
#   membership), every pond's fdf-client@<area>.service and the fdf-client@.service template;
#   remove what they wrote in /opt/fdf/var: join.env, site.env, ponds/, attention/, forward, forward.want, facts.json;
#   turn back on the units fdf-region-join stopped (off the region the store is the election input again);
#   restart frognet-tunnel-daemon-v3: with no RINA_RAM it runs LAN-only and takes down the hub link.
# The daemon's WireGuard key (/var/lib/frognet-tunnel/node_private.key) is kept: a later join announces the same key.
# Run as root. Re-runnable.
set -eu
[ "$(id -u)" = 0 ] || { echo "fdf-leave: run as root" >&2; exit 1; }
for u in fdf-term-serve fdf-client fdf-facts; do
    if [ -e /etc/systemd/system/$u.service ]; then
        systemctl disable --now $u.service
        rm -f /etc/systemd/system/$u.service
        echo "removed $u.service"
    fi
done
# [PONDS_V1] every pond's session (fdf-client@<area>), the pond list and the forward word go too
for u in $(systemctl list-units --all --plain --no-legend 'fdf-client@*.service' 2>/dev/null | awk '{print $1}'); do
    systemctl disable --now "$u" && echo "stopped $u"; done
rm -f /etc/systemd/system/fdf-client@.service
systemctl daemon-reload
V=/opt/fdf/var
rm -rf "$V/ponds" "$V/attention"
rm -f "$V/join.env" "$V/site.env" "$V/forward" "$V/forward.want" "$V/facts.json" "$V/facts.json.lock"
echo "removed $V/join.env, site.env, ponds/, attention/, forward, forward.want, facts.json"
# [STORE_UNITS_OFF_IN_REGION_V1] off the region, the store is the election input again: back on what fdf-region-join stopped.
for u in frognet-dbhost-advertise.timer frognet-dbhost-elect.timer frognet-merge-watcher.service; do
    [ -e "/etc/systemd/system/$u" ] || [ -e "/lib/systemd/system/$u" ] || continue
    systemctl enable --now "$u" && echo "re-enabled $u"
done
systemctl restart frognet-tunnel-daemon-v3 && echo "restarted frognet-tunnel-daemon-v3: LAN-only (its log says 'LAN-only loop started')"
echo "left the region: this node is LAN-only FrogNet"
