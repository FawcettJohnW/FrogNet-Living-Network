<project xmlns="http://maven.apache.org/POM/4.0.0">
  <!-- [KART_ANDROID_V1] Robolectric: the app's real Activity and view code on a JVM, against a live kart service. -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.frognet</groupId><artifactId>kart-android-robo</artifactId><version>1</version>
  <properties><maven.compiler.release>17</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
    <dependency><groupId>org.robolectric</groupId><artifactId>robolectric</artifactId><version>4.11.1</version><scope>test</scope>
      <!-- androidx.* is on Google's Maven only, which this build cannot reach; the test uses none of it -->
      <exclusions><exclusion><groupId>androidx.annotation</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>androidx.test</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>androidx.test.espresso</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
    <!-- the app's own sources compile against the API 33 framework, as build_apk.sh does -->
    <dependency><groupId>org.robolectric</groupId><artifactId>android-all</artifactId><version>13-robolectric-9030017</version><scope>provided</scope></dependency>
    <!-- androidx.test monitor + espresso idling resource, compiled from Google's source by androidx-test.sh -->
    <dependency><groupId>androidx.test</groupId><artifactId>monitor-from-source</artifactId><version>1.6.1</version><scope>system</scope>
      <systemPath>${project.build.directory}/robo-deps/androidx-test.jar</systemPath></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <sourceDirectory>../../src</sourceDirectory>
    <plugins>
      <!-- [KART_CALLS_IN_THE_GAME_V1] the Communicator's own code, from frognet-android, as build_apk.sh compiles it in -->
      <plugin><groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.5.0</version>
        <executions><execution><id>communicator</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals>
          <configuration><sources><source>../../../../../../frognet-android/app/src/main/java</source></sources></configuration></execution></executions></plugin>
      <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
        <configuration><redirectTestOutputToFile>false</redirectTestOutputToFile><trimStackTrace>false</trimStackTrace>
          <systemPropertyVariables><kart>${kart}</kart><shots>${shots}</shots><comms>${comms}</comms><probe>${probe}</probe><ivf>${ivf}</ivf><opus>${opus}</opus><tmp>${tmp}</tmp><robolectric.offline>true</robolectric.offline><robolectric.dependency.dir>${project.build.directory}/robo-deps</robolectric.dependency.dir></systemPropertyVariables></configuration></plugin>
    </plugins>
  </build>
</project>
