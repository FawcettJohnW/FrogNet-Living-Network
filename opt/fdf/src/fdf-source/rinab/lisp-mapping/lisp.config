# FD&F D5: unmodified lispers.net as the mapping system (Map-Server + Map-Resolver)
lisp enable {
    itr = no
    etr = no
    rtr = no
    map-server = yes
    map-resolver = yes
    ddt-node = no
}
lisp debug {
    core = no
    itr = no
    etr = no
    rtr = no
    map-server = yes
    map-resolver = yes
    ddt-node = no
}
lisp user-account {
    username = root
    password =
    super-user = yes
}
lisp site {
    site-name = fdf-areas
    authentication-key = fdf-area-key
    allowed-prefix {
        instance-id = 0
        eid-prefix = 'rina-area.test'
        force-proxy-reply = yes
    }
}
