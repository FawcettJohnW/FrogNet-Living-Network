+function aliasHere(ip, alias){
+  if(!isV4(ip) || !alias) return "";
+  const n=s=>s.split(".").reduce((a,o)=>a*256+Number(o),0), q=x=>[x>>>24&255,x>>>16&255,x>>>8&255,x&255].join(".");
+  for(const [al,real] of Object.entries(alias)){
+    const [rb,rl]=real.split("/"), [ab]=al.split("/"), size=2**(32-Number(rl)), off=n(ip)-n(rb);
+    if(off>=0 && off<size) return q(n(ab)+off);
+  }
+  return "";
+}
