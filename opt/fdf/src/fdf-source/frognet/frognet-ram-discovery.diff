+def _is_region_member(ip):
+    now = time.monotonic()
+    if now - _members["looked"] >= 1.0:
+        _members["looked"] = now
+        try:
+            mt = os.stat(_REGION_HOSTS).st_mtime
+        except OSError:
+            mt = None
+        if mt != _members["mtime"]:
+            ips = frozenset()
+            if mt is not None:
