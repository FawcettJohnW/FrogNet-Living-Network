+            # [GONE_IS_GONE_V1] no merge in its place: the region's routes, names and tunnels are withdrawn, and that is
+            # the state of the world until the region is back. Nothing is recomputed from elsewhere.
+            config.log.warning("REGION: lost; withdrew its routes and names, tore down %d tunnel(s); waiting for the region", n)
+        for _ in range(backoff):
+            if not config.running:
+                return
+            time.sleep(1)
+        backoff = 5                     # [REJOIN_EVERY_5S_V1] one HTTP call per try; the doubling to 60 s made a region restart cost up to a minute
+        _write_view("steady", "rejoin:attempt")
+
+
 def run_poll_loop():
+    if getattr(config, "REGION_RAM", ""):                     # [REGION_V1]
+        return run_region_loop()
     _ensure_frognet0()
     # [BROKER_AUTHORITATIVE_V1 2026-06-01] No _load_local_state() and
     # no STARTUP_COMMIT special case.  The daemon enters its poll loop
diff -ruN a/opt/frognet_semantic/internet_tunnels_v3/region.py b/opt/frognet_semantic/internet_tunnels_v3/region.py
--- a/opt/frognet_semantic/internet_tunnels_v3/region.py	1969-12-31 16:00:00.000000000 -0800
+++ b/opt/frognet_semantic/internet_tunnels_v3/region.py	2026-10-10 04:34:17.162612575 -0700
@@ -0,0 +1,356 @@
+################################################################
+#  Copyright (C) 2016-2026 Fawcett Innovations LLC             #
+#  SPDX-License-Identifier: GPL-2.0-only                       #
+################################################################
+"""region.py -- [REGION_V1] (PLAN-FROGNET-ON-FDF Stage 2) the tunnel daemon on an FD&F region instead of the broker.
+
+The daemon keeps calling broker_get/broker_post with the broker's four paths; in region mode those are answered here,
+from the region's records and this node's own facts file, in the broker's response shapes, so peer.py/wg.py/poll.py
+need no other change:
+
+  POST /api/v4/register         -> this node's facts (name, guid, subnet, pubkey, role=node) written to the facts file;
+                                   the node's fdf-client announces them through ITS session ([IPCP_FACTS_V1]). The
+                                   session is enrollment; there is no node_id but the guid.
+  GET  /api/v4/my-channels      -> ONE channel per live hub (participants with facts.role == "hub" in this area):
+                                   edge_ip = 10.253.A.B for our 10.A.B.0/24, edge_mask 16, droplet_* = the hub's
+                                   pubkey/endpoint/addr, allowed_ips 10.0.0.0/8, remote_subnets = every prefix whose
+                                   VERIFIED mapping (map_list) names that hub, except ours.
+  POST /api/v4/update-subnets   -> facts.transit; and facts.maps for the transit /24s (registered by fdf-client,
+                                   signed, session-bound: [MAP_FROM_FACTS_V1]).
+  GET  /api/v4/transit-map      -> {"map": {"10.x.y": [/24s that node forwards]}} from the participants' facts.
+
+  publish_maps(live_hubs)       -> after the bringup phase: facts.maps = our /24 and transit /24s with the locator set of
+                                   every hub whose tunnel handshook, prio from the measured handshake RTT (lower first).
+
+  events()                      -> lines from fdf-events (one held FNWP session): "p" participants changed, "m" a
+                                   mapping changed, "gone" the region is gone. One line = one poll_once(). No timer.
+
+Config (/etc/frognet/tunnel.conf): RINA_RAM=host:8840 (region mode on), RINA_AREA=<area name>. Facts file:
+FDF_FACTS (default /opt/fdf/var/facts.json). Tools: FDF_BIN (default /opt/fdf/bin).
+"""
+import hashlib
+import ipaddress
+import json
+import os
+import subprocess
+import urllib.error
+import urllib.request
+
+from . import config
+
+API = "/FawcettInnovations.RINA.ram_interface.php"
+BUILD_TAG = "fdf-2026-10-10-r19"      # [FDF_VERSION_V1] keep equal to src/fdf_version.hpp
+HUB_MASK = 16
+ALLOWED = "10.0.0.0/8"
+
+
+def enabled() -> bool:
+    return bool(getattr(config, "REGION_RAM", ""))
+
+
+def own_subnet() -> str:
+    """[OWN_SUBNET_IS_DOT1_V1] this node's own /24: the one where it holds the .1 (a FrogNet node is the .1 of the
+    /24 it serves; any other 10.x address it holds is a guest lease on someone else's LAN -- the discovery rule
+    [UPSTREAM_LEASE_DOT1_V1]). config.LOCAL_SUBNET takes the FIRST 10.x address `ip addr` lists, which flips when a
+    lease sorts first (Seattle7 claimed 10.250.250.0/24, Seattle5's, on 2026-10-09). Transit/chorus ranges excluded.
+    Falls back to config.LOCAL_SUBNET and says so."""
+    try:
+        out = subprocess.check_output(["ip", "-4", "-o", "addr", "show"], text=True)
+    except Exception:
+        out = ""
+    dot1 = []
+    for ln in out.splitlines():
+        p = ln.split()
+        if "inet" in p:
+            a = p[p.index("inet") + 1].split("/")[0]
+            o = a.split(".")
+            if a.startswith("10.") and o[1] not in ("253", "254") and o[3] == "1":
+                dot1.append(a.rsplit(".", 1)[0] + ".0/24")
+    if dot1:
+        if len(set(dot1)) > 1:
+            config.log.warning("REGION: this node holds the .1 of several /24s %s; using the first", sorted(set(dot1)))
+        sub = dot1[0]
+        if sub != config.LOCAL_SUBNET:
+            config.log.warning("REGION: own subnet is %s (where this node is .1), not config.LOCAL_SUBNET=%s (first 10.x address listed: a lease)",
+                               sub, config.LOCAL_SUBNET)
+        return sub
+    config.log.warning("REGION: no .1 address held; using config.LOCAL_SUBNET=%s", config.LOCAL_SUBNET)
+    return config.LOCAL_SUBNET
+
+
+def _facts_path() -> str:
+    return os.environ.get("FDF_FACTS", "/opt/fdf/var/facts.json")
+
+
+def read_facts() -> dict:
+    try:
+        with open(_facts_path()) as f:
+            out = json.load(f)
+    except (OSError, ValueError):
+        out = {}
+    pend = getattr(_batch, "pending", None)
+    if pend:
+        out.update(pend)                        # inside a facts_batch: what this event already decided is visible to it
+    return out
+
+
+import threading as _threading
+_batch = _threading.local()
+
+
+class facts_batch:
+    """[ONE_WRITE_PER_EVENT_V1] `with region.facts_batch():` every write_facts inside (maps, view, gen) lands in ONE file
+    write at exit, so fdf-client re-announces once and the fleet gets ONE `p` event for this event, not three (each
+    announcement is a region read and a rebuild on every member). Thread-local: the election thread writes directly."""
+    def __enter__(self):
+        _batch.pending = {}
+        return self
+    def __exit__(self, *exc):
+        pend = getattr(_batch, "pending", None)
+        _batch.pending = None
+        if pend:
+            write_facts(pend)
+        return False
+
+
+def write_facts(update: dict) -> dict:
+    """Merge `update` into the facts file atomically (tmp + rename, which is what fdf-client's watch reacts to)."""
+    pend = getattr(_batch, "pending", None)
+    if pend is not None:                        # inside a facts_batch: merged, written once at its end
+        pend.update(update)
+        f = read_facts(); f.update(pend)
+        return f
+    f = read_facts()
+    f.update(update)
+    path = _facts_path()
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    tmp = path + ".tmp"
+    with open(tmp, "w") as out:
+        out.write(json.dumps(f, sort_keys=True) + "\n")
+    os.replace(tmp, path)
+    return f
+
+
+def _call(body: dict) -> dict:
+    url = "http://" + config.REGION_RAM + API + "?op=rina"
+    req = urllib.request.Request(url, data=json.dumps(body).encode(),
+                                 headers={"Content-Type": "application/json"})
+    try:
+        with urllib.request.urlopen(req, timeout=15) as r:
+            return json.loads(r.read().decode())
+    except urllib.error.HTTPError as e:                       # the region says why; say it, not just the code
+        raise RuntimeError("region %s: HTTP %d for op %s: %s" % (config.REGION_RAM, e.code, body.get("op"), e.read().decode(errors="replace")[:200]))
+
+
+def version() -> str:
+    """The region's build tag, or why there is none. Logged by the daemon at start."""
+    try:
+        return _call({"op": "version"}).get("server", "(older than fdf-2026-10-09-r16: no version op)")
+    except Exception as e:
+        return "(no answer: %s)" % e
+
+
+# [WORLD_READ_ONCE_PER_EVENT_V1] the daemon reads the world once per event (`world`); everything else that asks the
+# region inside that event -- my_channels for the hub channel (bringup asked it twice: reachability, then the list),
+# transit_map -- answers from that same read. Four region round trips per event (two participants + two map_list) on
+# top of `world`, each a WAN RTT on a node far from the droplet. Outside world_in_hand() every call goes to the region.
+_held = {"world": None}
+
+
+class world_in_hand:
+    def __init__(self, parts: list, maps: list):
+        self.w = (parts, maps)
+
+    def __enter__(self):
+        _held["world"] = self.w
+        return self
+
+    def __exit__(self, *a):
+        _held["world"] = None
+        return False
+
+
+def participants() -> list:
+    if _held["world"] is not None:
+        return _held["world"][0]
+    return _call({"op": "participants"}).get("participants", [])
+
+
+def mappings() -> list:
+    if _held["world"] is not None:
+        return _held["world"][1]
+    return _call({"op": "map_list", "site": getattr(config, "REGION_AREA", "")}).get("mappings", [])
+
+
+def world() -> tuple:
+    """[WORLD_IN_ONE_READ_V1] (participants, mappings) in ONE round trip (region op `world`, build r14+). The daemon's
+    per-event read. A region without the op answers an error and that is an error: the droplet is behind the nodes."""
+    w = _call({"op": "world", "site": getattr(config, "REGION_AREA", "")})
+    if not w.get("ok"):
+        raise RuntimeError("region %s has no `world` op (%s): region build %s is older than this node" % (config.REGION_RAM, w.get("error"), w.get("server", "?")))
+    return w.get("participants", []), w.get("mappings", [])
+
+
+def edge_of(subnet: str):
+    n = ipaddress.ip_network(subnet, strict=False)
+    o = n.network_address.packed
+    if n.prefixlen != 24 or o[0] != 10 or o[1] in (253, 254):
+        return None
+    return "10.253.%d.%d" % (o[1], o[2])
+
+
+def _hubs(parts: list) -> list:
+    area = getattr(config, "REGION_AREA", "")
+    out = []
+    for p in parts:
+        f = p.get("facts") or {}
+        if p.get("alive") and f.get("role") == "hub" and f.get("pubkey") and f.get("endpoint") \
+                and (not area or f.get("area", area) == area):
+            out.append(f)
+    return sorted(out, key=lambda f: f.get("name", ""))
+
+
+def _reach(maps: list) -> dict:
+    """hub name -> set of prefixes whose verified mapping names it."""
+    out = {}
+    for m in maps:
+        for loc in m.get("rloc", "").split(","):
+            hub = loc.split(":")[0]
+            if hub:
+                out.setdefault(hub, set()).add(m["eid"])
+    return out
+
+
+# ---------------------------------------------------------------- the broker's four paths, answered from the region
+def get(path: str, params: dict = None) -> dict:
+    if path.startswith("/api/v4/my-channels"):
+        return my_channels()
+    if path.startswith("/api/v4/transit-map"):
+        return transit_map()
+    raise RuntimeError("region: no such GET " + path)
+
+
+def post(path: str, body: dict) -> dict:
+    if path == "/api/v4/register":
+        write_facts({"role": "node", "name": body.get("node_name", config.NODE_NAME), "guid": body.get("guid", config.NODE_GUID),
+                     "subnet": own_subnet(), "pubkey": body.get("pubkey", config.PUBKEY),
+                     "pond": body.get("pond", config.POND)})
+        return {"node_id": body.get("guid", config.NODE_GUID), "status": "registered"}
+    if path == "/api/v4/update-subnets":
+        f = read_facts()
+        before = sorted(f.get("transit") or [])
+        transit = sorted(body.get("transit_subnets") or [])
+        if transit != before:
+            write_facts({"transit": transit})
+            publish_maps(getattr(config, "live_hubs", {}))
+        return {"status": "unchanged" if transit == before else "updated",
+                "added": sorted(set(transit) - set(before)), "removed": sorted(set(before) - set(transit)), "tunnels_updated": 0}
+    raise RuntimeError("region: no such POST " + path)
+
+
+def my_channels() -> dict:
+    parts = participants()
+    maps = mappings()
+    me = read_facts()
+    my_sub = me.get("subnet") or own_subnet()
+    edge = edge_of(my_sub) if my_sub else None
+    reach = _reach(maps)
+    channels = []
+    if edge:
+        mine = {str(ipaddress.ip_network(my_sub, strict=False))} | set(me.get("transit") or [])
+        for h in _hubs(parts):
+            remote = sorted((set(reach.get(h["name"], set())) | ({h["subnet"]} if h.get("subnet") else set())) - mine)   # + the hub's own /24, if it is a node
+            channels.append({
+                "channel_name": "hub-" + h["name"],
+                "node_name": h["name"], "label": "hub", "subnet": "", "transit_subnets": [],
+                "tunnel_name": "region-" + h["name"],
+                "wg_config": {
+                    "edge_ip": edge, "edge_mask": HUB_MASK,
+                    "droplet_ip": h.get("addr", "10.253.253.254"),
+                    "droplet_pubkey": h["pubkey"], "droplet_endpoint": h["endpoint"],
+                    "allowed_ips": ALLOWED, "remote_subnets": remote,
+                },
+            })
+    def _who(p):                                      # name:role, and why a would-be hub does not count
+        f = p.get("facts") or {}
+        tag = p.get("name", "?") + ":" + (f.get("role") or "(no facts)")
+        if f.get("role") == "hub":
+            missing = [k for k in ("pubkey", "endpoint") if not f.get(k)]
+            area = getattr(config, "REGION_AREA", "")
+            if missing: tag += "(missing %s)" % ",".join(missing)
+            if area and f.get("area", area) != area: tag += "(area %s != %s)" % (f.get("area"), area)
+            if not p.get("alive"): tag += "(session down)"
+        return tag
+    config.log.warning("REGION: my-channels: hubs=%s channels=%d remote=%s members=%s mappings=%d",
+                       [h["name"] for h in _hubs(parts)], len(channels), sorted({p for c in channels for p in c["wg_config"]["remote_subnets"]}),
+                       [_who(p) for p in parts], len(maps))
+    payload = json.dumps({"channels": channels}, sort_keys=True, separators=(",", ":"))
+    return {"node_name": me.get("name", config.NODE_NAME), "node_id": me.get("guid", config.NODE_GUID),
+            "digest": hashlib.sha256(payload.encode()).hexdigest()[:16],
+            "channels": channels, "chorus_assignments": []}
+
+
+def transit_map() -> dict:
+    out = {}
+    for p in participants():
+        f = p.get("facts") or {}
+        if not p.get("alive") or f.get("role") != "node" or not f.get("subnet"):
+            continue
+        prefix = f["subnet"].split("/")[0].rsplit(".", 1)[0]
+        out[prefix] = sorted({f["subnet"]} | set(f.get("transit") or []))
+    return {"map": out}
+
+
+# ---------------------------------------------------------------- map-register through the node's own session
+def publish_maps(live_hubs: dict) -> None:
+    """live_hubs: {hub name: rtt_ms or None} for every hub whose tunnel handshook. Writes facts.maps; fdf-client
+    registers each (signed with RINA_SITE_KEY under RINA_AREA, own:true) and withdraws what is no longer listed."""
+    config.live_hubs = dict(live_hubs)
+    f = read_facts()
+    my_sub = f.get("subnet") or own_subnet()
+    prefixes = []
+    if my_sub:
+        prefixes.append(str(ipaddress.ip_network(my_sub, strict=False)))
+    prefixes += sorted(f.get("transit") or [])
+    ranked = sorted(live_hubs.items(), key=lambda kv: (kv[1] if kv[1] is not None else 10 ** 9, kv[0]))
+    rlocs = ",".join("%s:%d:50" % (name, i + 1) for i, (name, _rtt) in enumerate(ranked))
+    maps = [{"eid": p, "rlocs": rlocs} for p in prefixes] if rlocs else []
+    if (f.get("maps") or []) != maps:
+        write_facts({"maps": maps})
+        config.log.info("REGION: maps -> %s", maps)
+
+
+def publish_plan_maps(prefixes: list) -> None:
+    """[MAPS_FROM_GRAPH_V1] what this node registers = the plan's maps (its own /24s plus those of every host whose
+    exit it is), toward every hub whose tunnel handshook; [] withdraws everything (a child registers nothing)."""
+    f = read_facts()
+    live = getattr(config, "live_hubs", {}) or {}
+    ranked = sorted(live.items(), key=lambda kv: (kv[1] if kv[1] is not None else 10 ** 9, kv[0]))
+    rlocs = ",".join("%s:%d:50" % (name, i + 1) for i, (name, _rtt) in enumerate(ranked))
+    maps = [{"eid": p, "rlocs": rlocs} for p in sorted(set(prefixes))] if rlocs and prefixes else []
+    if (f.get("maps") or []) != maps:
+        write_facts({"maps": maps})
+        config.log.warning("REGION: maps -> %s", [m["eid"] for m in maps])
+
+
+# ---------------------------------------------------------------- change notification
+def events():
+    """Yields "ready" once fdf-events has registered its watches, then "p", "m" or "gone" as the region reports them.
+    Runs fdf-events; its exit = the region is gone.
+    [WATCH_BEFORE_READ_V1] "ready" is yielded, not swallowed: the caller reads the world only AFTER it, so a change
+    between the read and the watch cannot be missed (it arrives as an event, queued in the pipe while the read runs)."""
+    fdf_bin = os.environ.get("FDF_BIN", "/opt/fdf/bin")
+    env = dict(os.environ, RINA_RAM=config.REGION_RAM)
+    p = subprocess.Popen([os.path.join(fdf_bin, "fdf-events")], stdout=subprocess.PIPE, text=True, bufsize=1, env=env)
+    try:
+        for line in p.stdout:
+            line = line.strip()
+            yield line
+            if line == "gone":
+                return
+    finally:
+        try:
+            p.kill()
+        except OSError:
+            pass
+    yield "gone"
diff -ruN a/opt/frognet_semantic/internet_tunnels_v3/test_region_oracle.py b/opt/frognet_semantic/internet_tunnels_v3/test_region_oracle.py
--- a/opt/frognet_semantic/internet_tunnels_v3/test_region_oracle.py	1969-12-31 16:00:00.000000000 -0800
+++ b/opt/frognet_semantic/internet_tunnels_v3/test_region_oracle.py	2026-10-10 04:34:17.172924640 -0700
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""test_region_oracle.py -- [REGION_V1] oracle: the broker's four paths answered from the region, with controls.
+  1 register writes the facts file (the node's fdf-client announces it); nothing goes to any broker
+  2 my-channels: one channel per LIVE hub; a dead hub (session down) yields none (control)
+  3 remote_subnets come ONLY from verified mappings naming that hub; a prefix mapped to another hub is absent (control)
+  4 update-subnets: transit into facts, maps republished; unchanged -> "unchanged"
+  5 publish_maps: locator set ordered by handshake RTT, prio 1 = fastest; a hub without a tunnel is not a locator
+  6 transit-map shape: {"map": {"10.x.y": [/24s]}} from alive nodes only
+"""
+import json, os, sys, tempfile
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
+os.environ["FDF_FACTS"] = os.path.join(tempfile.mkdtemp(), "facts.json")
+import internet_tunnels_v3.config as config
+config.REGION_RAM = "127.0.0.1:1"; config.REGION_AREA = "frognet.test"
+config.NODE_NAME = "Seattle9"; config.NODE_GUID = "g-9"; config.LOCAL_SUBNET = "10.9.9.0/24"; config.PUBKEY = "PK9"; config.POND = "frognet"
+from internet_tunnels_v3 import region
+
+fails = 0
+def check(ok, what):
+    global fails; print(("PASS  " if ok else "FAIL  ") + what)
+    if not ok: fails += 1
+
+HUBS = [{"id": 1, "alive": True, "name": "hubA", "facts": {"role": "hub", "name": "hubA", "pubkey": "HPA", "endpoint": "203.0.113.1:51820", "addr": "10.253.253.254", "area": "frognet.test", "subnet": "10.123.123.0/24"}},
+        {"id": 2, "alive": True, "name": "hubB", "facts": {"role": "hub", "name": "hubB", "pubkey": "HPB", "endpoint": "203.0.113.2:51820", "addr": "10.253.253.254", "area": "frognet.test"}}]
+NODES = [{"id": 3, "alive": True, "name": "n1", "facts": {"role": "node", "name": "Seattle1", "subnet": "10.1.1.0/24", "transit": ["10.77.77.0/24"], "pubkey": "PK1"}},
+         {"id": 4, "alive": False, "name": "n2", "facts": {"role": "node", "name": "Seattle2", "subnet": "10.2.2.0/24", "pubkey": "PK2"}}]
+MAPS = [{"eid": "10.1.1.0/24", "rloc": "hubA:1:50,hubB:2:50", "site": "frognet.test"},
+        {"eid": "10.77.77.0/24", "rloc": "hubA:1:50", "site": "frognet.test"},
+        {"eid": "10.2.2.0/24", "rloc": "hubB:1:50", "site": "frognet.test"},
+        {"eid": "10.9.9.0/24", "rloc": "hubA:1:50,hubB:2:50", "site": "frognet.test"}]
+state = {"parts": HUBS + NODES, "maps": MAPS}
+region._call = lambda body: ({"participants": state["parts"]} if body["op"] == "participants" else {"mappings": state["maps"]})
+
+# 1 register
+r = region.post("/api/v4/register", {"pond": "frognet", "pubkey": "PK9", "subnet": "10.9.9.0/24", "node_name": "Seattle9", "guid": "g-9"})
+f = json.load(open(os.environ["FDF_FACTS"]))
+check(r["node_id"] == "g-9" and f["role"] == "node" and f["subnet"] == "10.9.9.0/24" and f["pubkey"] == "PK9", "1 register wrote the facts file")
+
+# 2 my-channels, one per live hub
+ch = region.get("/api/v4/my-channels", {"pubkey": "PK9"})
+names = sorted(c["channel_name"] for c in ch["channels"])
+check(names == ["hub-hubA", "hub-hubB"], "2 one channel per live hub")
+w = {c["channel_name"]: c["wg_config"] for c in ch["channels"]}
+check(w["hub-hubA"]["edge_ip"] == "10.253.9.9" and w["hub-hubA"]["edge_mask"] == 16 and w["hub-hubA"]["droplet_pubkey"] == "HPA"
+      and w["hub-hubA"]["droplet_endpoint"] == "203.0.113.1:51820" and w["hub-hubA"]["allowed_ips"] == "10.0.0.0/8", "2 wg_config: edge from our /24, hub's pubkey/endpoint, 10/8")
