# fdf-hub@AREA.service -- [REGIONS_PER_MACHINE_V1] region AREA's WireGuard concentrator (fdf-hub). Ships in the
# region-holder bundle. Its settings are /opt/fdf/hub/AREA/hub.env, which only fdf-region-create writes; without it
# this unit does not start, and its log says why. A machine holds as many regions as it has fdf-hub@ units.
[Unit]
Description=FD&F hub for region %i (fdf-hub; settings: /opt/fdf/hub/%i/hub.env from fdf-region-create)
After=network-online.target fdf-ram-%i.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/opt/fdf/hub/%i/hub.env
Environment=FDF_PY=/opt/fdf/lib/python
Environment=FDF_HUB_ENV=/opt/fdf/hub/%i/hub.env
Environment=FDF_ADMITTED=/opt/fdf/hub/%i/admitted
ExecStartPre=/bin/sh -c 'test -s /opt/fdf/hub/%i/hub.env || { echo "fdf-hub@%i: /opt/fdf/hub/%i/hub.env does not exist: this machine holds no region %i. Run: /opt/fdf/bin/fdf-setup" >&2; exit 1; }'
ExecStartPre=/opt/fdf/bin/fdf-wg-impl --record
ExecStart=/usr/bin/python3 /opt/fdf/bin/fdf-hub --area ${FDF_AREA} --iface ${FDF_IFACE} --endpoint ${FDF_ENDPOINT} --name ${FDF_HUB_NAME} --listen ${FDF_LISTEN} --facts ${FDF_FACTS} --key ${FDF_KEY} --admitted /opt/fdf/hub/%i/admitted
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
