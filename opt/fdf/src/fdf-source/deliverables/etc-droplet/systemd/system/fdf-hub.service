[Unit]
Description=FD&F hub: WireGuard concentrator for the frognet region (fdf-hub)
After=network-online.target fdf-client-frognet.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/fdf/hub/hub.env
Environment=FDF_PY=/opt/fdf/lib/python
ExecStart=/usr/bin/python3 /opt/fdf/bin/fdf-hub --area ${FDF_AREA} --endpoint ${FDF_ENDPOINT} --name ${FDF_HUB_NAME} --listen ${FDF_LISTEN} --facts ${FDF_FACTS}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
