# fdf-org.service -- [ORG_LEVELS_V1] the organization's credential manager on its RAM host (fdf-org serve): the door,
# every level's login port, every space's RAM manager, and the reach rules (opt/fdf/docs/ORGANIZATIONS.md). Ships in
# fdf-droplet.tgz; fdf-setup enables it once the region and `fdf-org init` exist.
[Unit]
Description=FD&F organization: levels, login, spaces and reach on this RAM host (fdf-org serve)
After=network-online.target fdf-hub.service
Wants=network-online.target fdf-hub.service

[Service]
Type=simple
Environment=FDF_PY=/opt/fdf/lib/python
Environment=FDF_BIN=/opt/fdf/bin
ExecStartPre=/bin/sh -c 'test -s /opt/fdf/hub/hub.env || { echo "fdf-org: /opt/fdf/hub/hub.env does not exist: this machine holds no region yet. Run: /opt/fdf/bin/fdf-setup" >&2; exit 1; }'
ExecStart=/usr/bin/python3 -u /opt/fdf/bin/fdf-org serve
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
