# fdf-identity@AREA.service -- [IDENTITY_FROM_ANY_MEMBER_V1][REGIONS_PER_MACHINE_V1] region AREA's side of
# `fdf-identity NAME [--leaf]`: answered by running fdf-invite here, for this region. fdf-region-create enables it.
[Unit]
Description=FD&F identities for region %i, asked from any connected machine (fdf-identity --serve)
After=fdf-hub@%i.service
Wants=fdf-hub@%i.service

[Service]
Type=simple
EnvironmentFile=-/opt/fdf/hub/%i/hub.env
Environment=FDF_PY=/opt/fdf/lib/python
Environment=FDF_HUB_ENV=/opt/fdf/hub/%i/hub.env
Environment=FDF_ADMITTED=/opt/fdf/hub/%i/admitted
ExecStartPre=/bin/sh -c 'test -s /opt/fdf/hub/%i/hub.env || { echo "fdf-identity@%i: /opt/fdf/hub/%i/hub.env does not exist: this machine holds no region %i" >&2; exit 1; }'
ExecStart=/usr/bin/python3 /opt/fdf/bin/fdf-identity --serve
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
