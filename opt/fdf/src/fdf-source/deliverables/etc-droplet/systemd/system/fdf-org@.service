# fdf-org@AREA.service -- [ORG_LEVELS_V1][REGIONS_PER_MACHINE_V1] region AREA's credential manager (fdf-org serve): the
# door, every level's login port and the reach rules (nftables table fdf_org_<area>). fdf-setup enables it.
[Unit]
Description=FD&F organization for region %i: levels, login and reach (fdf-org serve)
After=network-online.target fdf-hub@%i.service
Wants=network-online.target fdf-hub@%i.service

[Service]
Type=simple
Environment=FDF_PY=/opt/fdf/lib/python
Environment=FDF_BIN=/opt/fdf/bin
Environment=FDF_HUB_ENV=/opt/fdf/hub/%i/hub.env
Environment=FDF_ADMITTED=/opt/fdf/hub/%i/admitted
Environment=FDF_ORG_KEY=/opt/fdf/hub/%i/org-key
ExecStartPre=/bin/sh -c 'test -s /opt/fdf/hub/%i/hub.env || { echo "fdf-org@%i: /opt/fdf/hub/%i/hub.env does not exist: this machine holds no region %i. Run: /opt/fdf/bin/fdf-setup" >&2; exit 1; }'
ExecStart=/usr/bin/python3 -u /opt/fdf/bin/fdf-org serve
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
